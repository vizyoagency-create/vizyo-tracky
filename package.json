{
  "name": "vizyo-tracky",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "smoke": "pnpm --filter @vizyo/tracky-api exec jest --testPathPatterns app.module.smoke",
    "verif:litteraux": "node scripts/verif-litteraux.mjs",
    "verif:contraste-depot": "node scripts/verif-contraste-depot.mjs",
    "verify": "pnpm typecheck && pnpm smoke && pnpm test"
  },
  "devDependencies": {
    "turbo": "^2.9.7",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ]
  }
}
