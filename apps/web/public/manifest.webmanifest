{
  "name": "Vizyo Tracky - Gestion de flotte GPS",
  "short_name": "Vizyo Tracky",
  "description": "Suivi temps reel de flotte, coupure moteur securisee, alertes multi-flottes.",
  "start_url": "/dashboard",
  "scope": "/",
  "id": "vizyo-tracky",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0A0F0D",
  "theme_color": "#059669",
  "categories": ["business", "productivity", "navigation"],
  "lang": "fr",
  "dir": "ltr",
  "icons": [
    {
      "src": "pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "apple-touch-icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "pwa-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Carte temps reel",
      "short_name": "Carte",
      "description": "Voir la carte en direct",
      "url": "/map",
      "icons": [{ "src": "pwa-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Alertes",
      "short_name": "Alertes",
      "description": "Liste des alertes recentes",
      "url": "/alerts",
      "icons": [{ "src": "pwa-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Vehicules",
      "short_name": "Vehicules",
      "description": "Liste de la flotte",
      "url": "/vehicles",
      "icons": [{ "src": "pwa-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
