generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto, uuidOssp(map: "uuid-ossp")]
}

enum UserRole {
  SUPER_ADMIN
  FLEET_ADMIN
  FLEET_MANAGER
  VIEWER
  // Sprint 3 — rôle restreint « veilleur de nuit » : bloque/débloque les véhicules uniquement.
  NIGHT_WATCHMAN
  // feat/comptes-conducteurs — rôle « conducteur » : voit ses véhicules et (si autorisé par
  // périmètre) déverrouille le moteur / active le mode vie privée. Lié à un Driver via Driver.userId.
  DRIVER
  // Espace dépôt (2026-08) — rôle LATÉRAL, pas un rang. Un tiers en lecture seule dont le
  // périmètre est borné par la mission : il voit UN camion PENDANT [startAt, endAt], parce
  // qu'une Mission le désigne comme destinataire, et rien du tout en dehors. N'a JAMAIS de
  // ligne UserVehicleAccess. Cf. design/A1-ROLE-DEPOT.md.
  DEPOT
}

enum TrackerStatus {
  ONLINE
  OFFLINE
  IDLE
}

enum GeofenceType {
  CIRCLE
  POLYGON
  // V1.5 (Sprint N) — corridor lineaire le long d'un trajet (polyligne avec
  // largeur en metres). Alerte si le vehicule s'eloigne du corridor.
  CORRIDOR
}

enum GeofenceRule {
  ENTER
  EXIT
  BOTH
}

enum AlertType {
  SOS
  POWER_CUT
  ACCIDENT
  COLLISION
  LOW_BATTERY
  OVERSPEED
  GEOFENCE_ENTER
  GEOFENCE_EXIT
  MOVEMENT_IDLE
  HARSH_BRAKING
  HARSH_ACCELERATION
  HARSH_TURN
  BONNET
  DOOR
  VIBRATION
  TOW
  TAMPER
  FATIGUE
  ILLEGAL_IGNITION
  GPS_LOST
  IDLE_TIME
  SURVEILLANCE_TRIGGERED
  MAINTENANCE_DUE
  /// TRK-046 — un vehicule HORS CHAMP GPS (parking souterrain valide, tunnel...) reapparait
  /// EN ROULANT pendant la plage ou son planning le veut immobilise. C'est le filet de
  /// securite de la presomption de stationnement : la coupe programmee ne l'a pas atteint
  /// (on le savait), sa sortie hors horaire, elle, ne passe pas inapercue.
  OFF_SCHEDULE_MOVEMENT
  /// A6 arbitrage J — la flotte n'a pas de grille tarifaire active. Seule alerte de
  /// ce catalogue qui ne vienne PAS d'un boîtier : elle porte donc un `vehicleId`
  /// nul, ce que le centre d'alertes sait déjà afficher. Elle n'immobilise rien —
  /// les missions restent créables, c'est la tarification qui disparaît.
  PRICING_GRID_MISSING
  UNKNOWN
}

enum SurveillanceMode {
  OFF
  FULL_TIME
  SCHEDULED
}

enum SurveillanceSensitivity {
  LOW
  MEDIUM
  HIGH
}

enum SurveillanceEventTrigger {
  VIBRATION
  MOVEMENT
  DOOR
}

enum SurveillanceEventStatus {
  PENDING
  ACKNOWLEDGED
  CONFIRMED_THEFT
  FALSE_ALARM
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// Zones mortes GPS (2026-07) — suivi de FS-253. Un vehicule qui perd RECURREMMENT son
// lock GPS au MEME endroit revele une cause structurelle (parking souterrain/couvert,
// tunnel, ou brouilleur) plutot qu'une panne d'antenne ponctuelle. Statut du cycle de vie
// d'une zone apprise automatiquement :
//  - LEARNING          : quelques pertes seulement, on apprend (occurrences < seuil).
//  - RECURRING         : seuil atteint, zone reconnue automatiquement (perte recurrente ici).
//  - CONFIRMED_BENIGN  : l'operateur a confirme « endroit normal » (parking) -> on N'ALERTE PLUS.
//  - SUSPECT           : l'operateur marque suspect (brouilleur ?) -> on continue d'alerter.
enum GpsDeadZoneStatus {
  LEARNING
  RECURRING
  CONFIRMED_BENIGN
  SUSPECT
}

// Nature presumee/confirmee d'une zone morte GPS. UNKNOWN par defaut ; une heuristique
// peut SUGGERER UNDERGROUND_PARKING (perte recurrente + recouvrement rapide), mais la
// valeur fait foi seulement quand un operateur l'a posee.
enum GpsDeadZoneLabel {
  UNKNOWN
  UNDERGROUND_PARKING
  COVERED_PARKING
  TUNNEL
  JAMMER_SUSPECTED
  OTHER
}

// Lieux cles (2026-07) — referentiel METIER des lieux de la flotte, cree/valide A LA MAIN par
// l'exploitant : stations-service retenues, parkings & stationnements recurrents (ex. « CDEF
// Launaguet »), depots. A ne PAS confondre avec :
//  - FuelStation      = catalogue externe (API prix-carburants), non specifique a la flotte ;
//  - GpsDeadZone      = zone DETECTEE automatiquement par vehicule (perte GPS recurrente).
// Ici c'est ce que l'exploitant DECLARE comme lieu de reference -> pilote la couleur carte
// (station « validee » vs simplement detectee) et le regroupement des arrets.
enum FleetPlaceKind {
  FUEL_STATION
  PARKING
  DEPOT
  OTHER
}

enum VehicleType {
  CAR
  TRUCK
  VAN
  MOTORCYCLE
  BICYCLE
  BUS
  CONSTRUCTION
  OTHER
}

enum AccessType {
  ALL
  GROUP
  VEHICLE
}

enum EngineAction {
  CUT
  RESTORE
}

enum CommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  FAILED
  REJECTED_SPEED
  /// TRK-018 — la commande est partie, son echeance est passee, et NUL NE SAIT si elle a
  /// abouti. Volontairement DISTINCT de FAILED : « a echoue » et « nul ne sait » ne sont
  /// pas la meme information, et les confondre ferait croire a une panne la ou il n'y a
  /// qu'une absence de preuve. Le coupe-circuit est une garde de securite : une garde
  /// qu'on croit armee sans preuve est plus dangereuse qu'une garde qu'on sait muette.
  SENT_UNCONFIRMED
}

// V1.15 — Plannings d'installation de boitiers GPS.
// Statut du plan : DRAFT (operateur seul) -> PUBLISHED (visible client) ->
// IN_PROGRESS (au moins une pose) -> COMPLETED (tout pose). CANCELLED = annule
// (re-masque cote client). Cf. InstallationsService.recomputePlanStatus.
enum InstallationPlanStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InstallationTaskStatus {
  PENDING
  DONE
  SKIPPED
}

// Energie du vehicule a equiper. AUTRE = fallback (valeur source non mappee).
enum InstallationEnergy {
  DIESEL
  ESSENCE
  ELECTRIQUE
  HYBRIDE
  AUTRE
}

// Prise de RDV en ligne (lien public). Une demande de creneau passe de PENDING
// (client a reserve) a CONFIRMED (l'operateur valide -> pose creee) ou REJECTED.
// CANCELLED = annulee (ex. client/operateur). Cf. InstallationBookingService.
enum InstallationBookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

/// Sprint 9 — Metier d'une flotte : conditionne l'objectif d'optimisation IA.
enum FleetMetier {
  CHILDREN_TRANSPORT
  PARCELS
  RENTAL
  GENERIC
}

model Fleet {
  id                      String      @id @default(uuid()) @db.Uuid
  name                    String
  clientId                String?
  // Sprint 9 — Metier de la flotte : conditionne l'objectif d'optimisation IA
  // (CHILDREN_TRANSPORT = enfants/places, PARCELS = colis, RENTAL = location).
  // Defaut GENERIC. Regle par un super-admin.
  metier                  FleetMetier @default(GENERIC)
  // V1.5 (Sprint H1) — sampling adaptatif des positions cote serveur.
  // true = positions redondantes (vehicule arrete) ne sont pas persistees pour
  // economiser le stockage. UX-first : le broadcast WS reste integral.
  // Opt-out par fleet pour les contrats imposant un tracage continu (legal).
  adaptiveSamplingEnabled Boolean     @default(true)
  // V1.5 (Sprint H3) — pilotage adaptatif du fix interval boitier (fix030s en
  // mouvement, fix120s/300s a l'arret). Reduit la conso batterie + data SIM.
  // Opt-out pour les contrats imposant le mode 30s permanent.
  adaptiveFixModeEnabled  Boolean     @default(true)
  // V1.5 (Sprint L) — Tarif litre essence pour estimer la consommation dans
  // les rapports. Default 1.85 EUR/L (moyenne FR fin 2025). Override par fleet.
  fuelPriceEurL           Float       @default(1.85)
  // V1.5 (Sprint L) — Email de contact pour le rapport hebdomadaire automatique
  // envoye chaque lundi 08:00 UTC. Si null, fallback sur l'email du premier
  // FLEET_ADMIN de la fleet. Si vide explicite ('-'), on n'envoie pas le rapport.
  weeklyReportEmail       String?
  // IA (2026-07) — INTERRUPTEUR MAÎTRE de l'assistance IA pour CETTE flotte. false = toute l'IA
  // (récit de trajet, agent d'agenda, optimiseur, parsing vocal des réservations) est DÉSACTIVÉE ;
  // l'app reste pleinement fonctionnelle sans IA (analyse déterministe des trajets, stations, scores
  // = NON IA, jamais coupés). Togglable par le FLEET_ADMIN depuis ses réglages (et par un super-admin).
  // OPT-IN (2026-07-14) : défaut OFF — aucune flotte n'a l'IA tant qu'un admin ne l'active pas.
  aiEnabled               Boolean     @default(false)
  // Facturation (2026-07) — Stripe. L'IA est une OPTION PAYANTE. L'interrupteur runtime `aiEnabled`
  // est PILOTÉ par l'abonnement (`AiSubscription`) : statut ACTIVE ou COMP → aiEnabled=true, sinon false.
  // `stripeCustomerId` = client Stripe de la société (créé à la 1re carte / au 1er abonnement).
  stripeCustomerId        String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  users                    User[]
  vehicles                 Vehicle[]
  geofences                Geofence[]
  alerts                   Alert[]
  vehicleGroups            VehicleGroup[]
  drivers                  Driver[]
  surveillanceProfiles     SurveillanceProfile[]
  surveillanceEvents       SurveillanceEvent[]
  installationPlans        InstallationPlan[]
  installationBookingLinks InstallationBookingLink[]
  // Refonte agenda/IA (2026-07) — reglages de l'agent d'optimisation d'agenda (1:1, opt-in).
  agendaAgentSettings      AgendaAgentSettings?
  // Refonte agenda/IA (P4) — liens publics de demande de reservation (societe fixe).
  reservationBookingLinks  ReservationBookingLink[]
  // V1.16 — SIM allouees a cette flotte (parc WhereverSIM).
  sims                     Sim[]
  // Sprint 4 — config d'activation de l'ecoute audio (1:1, OFF par defaut).
  audioConfig              FleetAudioConfig?
  // Facturation (2026-07) — abonnement à l'option IA (1:1).
  aiSubscription           AiSubscription?
  // D4 (chantier commercial 2026-07) — abonnement commercial (plan/formule/options, 1:1).
  subscription             FleetSubscription?
  // Integration partenaire (Tracky x Maestroo) — 1 lien VIVANT max par partenaire,
  // + l'historique des liens revoques. Cf. PartnerLink.
  partnerLinks             PartnerLink[]
  partnerInvitations       PartnerInvitation[]
  // Rapport hebdomadaire (2026-09) — réglage par société + journal des envois.
  reportSchedule           FleetReportSchedule?
  reportDispatches         FleetReportDispatch[]
  // Espace dépôt (2026-08) — les missions de la flotte (séquence `ref` par flotte).
  missions                 Mission[]
  missionRequests          MissionRequest[]
  missionPricingSettings   MissionPricingSettings?

  @@map("fleets")
}

// ─────────────────────────────────────────────────────────────────────────────
// D4 + Phase 3 (chantier commercial 2026-07) — abonnements clients & grille tarifaire
// ─────────────────────────────────────────────────────────────────────────────

/// Plans commerciaux (repositionnement 2026, source xlsx « Repositionnement »).
enum TrackyPlan {
  LITE
  PRO
  SIGNATURE
}

/// Formules d'engagement : Sérénité (tout inclus, 36 mois) / Liberté (sans engagement, 12 mois).
enum TrackyFormule {
  SERENITE
  LIBERTE
}

/// D4 — Abonnement commercial d'une flotte : plan + formule + options à la carte + cas spéciaux.
/// Édité par le SUPER_ADMIN dans « Abonnements & tarifs ». SIGNATURE inclut TOUTES les options
/// (résolution effective dans FleetSubscriptionsService.effectiveOptions). `isComp` = offert
/// (partenaire, test) ; `customPriceEurYear` = prix négocié /véh/an qui remplace la grille.
model FleetSubscription {
  id                 String        @id @default(uuid()) @db.Uuid
  fleetId            String        @unique @db.Uuid
  fleet              Fleet         @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  plan               TrackyPlan    @default(PRO)
  formule            TrackyFormule @default(SERENITE)
  // Options à la carte (pertinentes en LITE/PRO — SIGNATURE les inclut toutes).
  optLive            Boolean       @default(false)
  optMicro           Boolean       @default(false)
  optAgent           Boolean       @default(false)
  /// '90j' | '1an' | '2ans' | '3ans'
  retentionKey       String        @default("90j")
  // Cas spéciaux.
  isComp             Boolean       @default(false)
  customPriceEurYear Int?
  notes              String?
  updatedByUserId    String?       @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("fleet_subscriptions")
}

/// RGPD 4.5 — Registre du temps de travail : agrégat JOURNALIER par conducteur, SANS AUCUNE
/// position (uniquement durées et bornes horaires). Alimenté chaque nuit depuis les trajets
/// attribués (AUTO comme MANUEL), rétention propre 5 ans (obligation employeur), conservé après
/// anonymisation (fiche anonyme). Les périodes en mode privé n'y figurent jamais (non collectées).
model WorkTimeEntry {
  id             String   @id @default(uuid()) @db.Uuid
  fleetId        String   @db.Uuid
  driverId       String   @db.Uuid
  /// Jour civil (Europe/Paris).
  day            DateTime @db.Date
  firstTripStart DateTime
  lastTripEnd    DateTime
  /// Conduite pure (somme des durées de trajets), en secondes.
  drivingSeconds Int
  tripsCount     Int
  vehiclePlates  String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([driverId, day])
  @@index([fleetId, day])
  @@map("work_time_entries")
}

/// Phase 3 — Grille tarifaire PUBLIQUE (SINGLETON, éditée par le super-admin). `grid` = JSON de la
/// même forme que lp/src/data/pricing.mjs (formules, plans, addons, launch). Consommée par la LP
/// via GET /public/pricing (hydratation runtime) et par l'app (admin + calculs d'abonnement).
model PricingSettings {
  id              String   @id @default(uuid()) @db.Uuid
  grid            Json
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pricing_settings")
}

/// Statut de l'option IA payante d'une société. Pilote `Fleet.aiEnabled` (ACTIVE/COMP → IA ON).
enum AiSubscriptionStatus {
  NONE // jamais souscrit — IA off
  ACTIVE // abonnement payant actif (Stripe active/trialing)
  PAST_DUE // paiement échoué (Stripe past_due/unpaid) — IA suspendue
  CANCELED // annulé (période échue ou annulation immédiate) — IA off
  INVOICE_PENDING // facture physique demandée — en attente d'activation manuelle owner
  COMP // offert par l'owner/super-admin (toggle, sans paiement)
}

/// Abonnement à l'option IA d'une société (1:1 Fleet). SOURCE DE VÉRITÉ de l'état payant ;
/// synchronise `Fleet.aiEnabled` (ACTIVE/COMP → true). Le prix unitaire (par véhicule/mois) et la
/// quantité sont FIGÉS à la souscription pour afficher « coût / mois » et « coût / voiture » sans
/// appel Stripe. `stripe*` nuls pour COMP (offert) et INVOICE_PENDING (facture physique).
model AiSubscription {
  id                   String               @id @default(uuid()) @db.Uuid
  fleetId              String               @unique @db.Uuid
  fleet                Fleet                @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  status               AiSubscriptionStatus @default(NONE)
  stripeSubscriptionId String?              @unique
  stripePriceId        String?
  // Tarification figée pour l'affichage (centimes €). unitAmountEurCents = prix / véhicule / mois.
  unitAmountEurCents   Int?
  quantity             Int? // nb de véhicules facturés au moment de la souscription
  currency             String               @default("eur")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean              @default(false)
  compedByUserId       String?              @db.Uuid // COMP : owner/super-admin qui a offert l'IA
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@map("ai_subscriptions")
}

/// Réglages de facturation (SINGLETON, édités par le super-admin/owner dans l'espace admin).
/// Le prix de l'option IA est CONFIGURABLE ici (pas figé dans le code) : l'owner met un défaut
/// puis ajuste le vrai prix depuis l'UI. `aiUnitAmountEurCents` = prix / véhicule / mois (centimes)
/// quand `aiPricingUnit='per_vehicle'` ; forfait société / mois quand `'flat'`. Repris à chaque
/// souscription et figé sur `AiSubscription` pour l'affichage.
model BillingSettings {
  id                   String   @id @default(uuid()) @db.Uuid
  aiUnitAmountEurCents Int      @default(500) // défaut placeholder 5,00 €/véhicule/mois — à ajuster dans l'UI
  aiPricingUnit        String   @default("per_vehicle") // 'per_vehicle' | 'flat'
  currency             String   @default("eur")
  updatedByUserId      String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("billing_settings")
}

/// Interrupteurs GLOBAUX par fonctionnalité IA (SINGLETON, super-admin/owner). Kill-switch plateforme :
/// couper une fonction IA POUR TOUT LE MONDE, par-dessus l'interrupteur maître par société. Défaut
/// TOUT ON (fail-open : un flag cassé ne coupe pas l'IA déjà payée). `activityReport` = outil owner.
model AiFeatureFlags {
  id              String   @id @default(uuid()) @db.Uuid
  tripAnalysis    Boolean  @default(true) // récit IA de trajet
  agendaAgent     Boolean  @default(true) // agent d'agenda
  capacity        Boolean  @default(true) // optimiseur — capacités
  placement       Boolean  @default(true) // optimiseur — placement
  bookingParse    Boolean  @default(true) // saisie vocale des réservations
  activityReport  Boolean  @default(true) // rapport d'activité IA (owner/super-admin)
  placeAnalysis   Boolean  @default(true) // analyse IA d'un lieu clé (station / parking)
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("ai_feature_flags")
}

model User {
  id                       String              @id @default(uuid()) @db.Uuid
  authUserId               String              @unique
  email                    String              @unique
  firstName                String?
  lastName                 String?
  role                     UserRole            @default(VIEWER)
  permissions              Json?
  isActive                 Boolean             @default(true)
  /// « Owner » plateforme (niveau au-dessus des SUPER_ADMIN). Le compte reste
  /// techniquement SUPER_ADMIN et garde TOUS ses pouvoirs ; ce flag pilote
  /// UNIQUEMENT l'invisibilité : un compte owner est exclu des listes
  /// d'utilisateurs, de toutes les vues d'activité, des rapports/coûts IA, et
  /// masqué comme auteur d'action — pour tout viewer NON-owner. Un owner, lui,
  /// voit tout (y compris les autres owners). Réversible (false = redevient un
  /// super-admin visible). Backfill initial : admin@vizyoagency.com.
  isOwner                  Boolean             @default(false)
  fleetId                  String?             @db.Uuid
  fleet                    Fleet?              @relation(fields: [fleetId], references: [id], onDelete: SetNull)
  // V1.5 (Sprint J) — onboarding + profil enrichi.
  // phone : E.164 (+33612345678), utilise pour les notifications WhatsApp Sprint M.
  // onboardingCompletedAt : null = wizard non termine, declenche au premier login.
  // escalationContactUserId : si une alerte CRITICAL n'est pas ack en 10min,
  //   on notifie ce user (Sprint M).
  phone                    String?
  onboardingCompletedAt    DateTime?
  /// V1.12 — preferences UI per-user (JSON extensible).
  /// Aujourd'hui : `{ uiMode: 'tracky' | 'baanool' }`. Default null = mode Tracky
  /// (UI riche dashboard + sidebar). Mode 'baanool' = layout simplifie inspire
  /// de l'app Baanool : sidebar cachee, post-login direct sur /map, navigation
  /// via burger uniquement. Toutes les pages restent accessibles.
  preferences              Json?
  escalationContactUserId  String?             @db.Uuid
  escalationContact        User?               @relation("UserEscalation", fields: [escalationContactUserId], references: [id], onDelete: SetNull)
  escalatedTo              User[]              @relation("UserEscalation")
  acknowledgedAlerts       Alert[]             @relation("AlertAcknowledgedBy")
  trackerCommands          TrackerCommand[]
  vehicleAccess            UserVehicleAccess[]
  invitationsSent          Invitation[]        @relation("InvitationCreatedBy")
  tripNotesAuthored        Trip[]              @relation("TripNotesAuthor")
  /// Phase 3 (futur) : si ce User est lie a un compte conducteur (driver login).
  /// Aujourd'hui null pour tous les Users existants. Cf. Driver.userId.
  driverProfile            Driver?
  /// Sprint user-activity — sessions + actions de l'utilisateur dans l'app.
  sessions                 UserSession[]
  /// Consentements RGPD versionnés (CGU / Politique de confidentialité) — le gate
  /// d'accès (403 CONSENT_REQUIRED) compare CONSENT_VERSION à la dernière acceptation.
  consents                 UserConsent[]
  /// Permissions device accordées (notifications, localisation) — cf. UserPermission.
  devicePermissions        UserPermission[]
  /// Sécurité — appareils de confiance (vérification e-mail des nouveaux appareils).
  trustedDevices           TrustedDevice[]
  /// Sécurité — historique des connexions (appareil + position géo-IP) : socle de la
  /// détection adaptative (appareil/zone inhabituels) et de la carte admin.
  loginEvents              LoginEvent[]
  /// Sécurité — 2FA app OPT-IN par l'utilisateur (jamais imposé). false = pas de
  /// vérification. À l'activation, un code e-mail est demandé UNIQUEMENT sur une vraie
  /// anomalie (nouvel appareil / zone inhabituelle), et seulement une fois qu'on a
  /// assez d'historique pour juger (sinon on apprend, sans gêner).
  twoFactorEnabled         Boolean             @default(false)
  /// Dernière fois qu'on a PROPOSÉ le 2FA (pour ne pas harceler).
  twoFactorPromptedAt      DateTime?
  /// L'utilisateur a écarté la proposition (« plus tard / ne plus demander »).
  twoFactorPromptDismissed Boolean             @default(false)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  /// Espace dépôt (2026-08) — missions dont CE compte est le dépôt destinataire.
  /// N'est peuplé que pour les comptes de rôle DEPOT. C'est la SEULE source de son
  /// périmètre : un DEPOT n'a jamais de ligne UserVehicleAccess (A1 § 7).
  depotMissions          Mission[]               @relation("MissionDepot")
  missionRequests        MissionRequest[]        @relation("MissionRequestDepot")
  /// Lot A6 — les modifications de tournee signees par ce compte. SetNull cote
  /// revision : supprimer un compte n'efface pas l'historique, dont le nom de
  /// l'auteur est fige a l'ecriture.
  missionStopRevisions   MissionStopRevision[]   @relation("MissionStopRevisionAuthor")
  /// Lot A4 — les liens publics de suivi générés par ce compte. Un dépôt comme un
  /// gestionnaire peut en créer ; c'est par cette relation qu'on révoque les liens
  /// d'un compte désactivé (A4 § 8).
  missionShareLinks      MissionShareLink[]      @relation("MissionShareAuthor")
  notificationPreference NotificationPreference?
  notificationDeliveries NotificationDelivery[]
  /// Demandes d'assistance IA de ce compte. Supprimées avec lui (cascade) : les échanges
  /// portent sur son activité et ses données, ils n'ont pas à lui survivre.
  assistanceConversations AssistanceConversation[]

  @@index([fleetId])
  @@map("users")
}

/// V1.5 (Sprint M) — Subscription Web Push d'un utilisateur (1 abonnement
/// par device/browser). Une ligne = un endpoint push valide.
model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  /// Identifiant stable du device cote client (UUID genere une fois, stocke en
  /// localStorage). Permet de dedupliquer parfaitement une re-inscription apres
  /// reinstallation PWA ou rotation d'endpoint : on upsert sur (userId, deviceId)
  /// au lieu de creer une nouvelle ligne a chaque endpoint regenere. Optionnel
  /// pour la backward-compat (les subs existantes restent valides).
  deviceId   String?
  lastSeenAt DateTime @default(now())
  /// Nom lisible de l'appareil pour la gestion/révocation des devices (ex.
  /// « iPhone de Jean », « Chrome — Windows »). Facultatif (dérivé du userAgent).
  label      String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, deviceId])
  @@map("push_subscriptions")
}

/// V1.5 (Sprint M) — Regles de notification personnalisables par fleet/vehicule.
/// Si vehicleId est null, la regle s'applique a tous les vehicules de la fleet.
/// Si alertType est '*', la regle s'applique a tous les types d'alerte.
/// channels = ['IN_APP', 'WEB_PUSH', 'EMAIL', 'WHATSAPP'] — l'in-app est
/// toujours actif (legacy ALERT_NEW WS) ; cette table active push/email/whatsapp.
model AlertRule {
  id               String   @id @default(uuid()) @db.Uuid
  fleetId          String   @db.Uuid
  vehicleId        String?  @db.Uuid
  alertType        String // ex: 'OVERSPEED', 'SOS', '*' = tous
  enabled          Boolean  @default(true)
  channels         Json     @default("[]") // ['WEB_PUSH', 'EMAIL', 'WHATSAPP']
  // Escalade : si l'alerte n'est pas acquittee en `escalateAfterMin` minutes
  // ET sa severity est CRITICAL, on notifie escalateTo (ou User.escalationContactUserId
  // si null).
  escalateAfterMin Int?
  escalateToUserId String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([fleetId])
  @@index([vehicleId])
  @@index([alertType])
  @@map("alert_rules")
}

/// V1.5 (Sprint J) — Invitations utilisateur.
/// SUPER_ADMIN ou FLEET_ADMIN cree une invitation pour un email + role + fleet.
/// Tracky envoie un email avec lien `/accept-invite?token=...` (JWT 24h).
/// L'utilisateur clique, set son password, on call Vizyo Auth.register puis
/// on cree le User Tracky local avec authUserId retourne.
model Invitation {
  id           String    @id @default(uuid()) @db.Uuid
  email        String
  role         UserRole
  fleetId      String?   @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  permissions  Json?
  // Scopes d'acces (matrice Acces & Permissions) configures des l'invitation :
  // tableau de { type: ALL|GROUP|VEHICLE, groupId?, vehicleId?, permissions }.
  // Materialises en lignes UserVehicleAccess a l'acceptation. Null = legacy
  // (retombe sur `permissions` = un unique scope ALL).
  accessScopes Json?
  status       String    @default("PENDING") // 'PENDING' | 'ACCEPTED' | 'EXPIRED' | 'REVOKED'
  createdById  String    @db.Uuid
  createdBy    User      @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([status])
  // V1.10 (Sprint 2 perf) — list par fleet est la query par defaut de la page
  // /admin/invitations. Sans index dedie, on scanne toutes les invitations.
  @@index([fleetId])
  @@map("invitations")
}

/// Pourquoi un vehicule est hors service. Le libelle exact est porte par l'interface ; ce qui
/// compte ici est de distinguer les cas, parce qu'ils ne se resolvent pas pareil : un accident
/// se solde par une reforme ou une remise en route, un boitier debranche par une reinstallation.
enum VehicleOutOfServiceReason {
  /// Accidente — le vehicule ne roule plus, ses donnees s'arretent la.
  ACCIDENT
  /// Boitier debranche ou depose (restitution, vente, panne materielle).
  TRACKER_UNPLUGGED
  /// Immobilise durablement pour toute autre raison (reparation longue, saisie, hivernage).
  IMMOBILIZED
}

model Vehicle {
  id                          String                   @id @default(uuid()) @db.Uuid
  fleetId                     String                   @db.Uuid
  fleet                       Fleet                    @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  plate                       String
  type                        VehicleType              @default(CAR)
  brand                       String?
  model                       String?
  /// Type de carburant. Synchronisé depuis le planning d'installation (InstallationTask.energy),
  /// éditable sur la fiche. Réutilise l'enum InstallationEnergy (Diesel/Essence/Électrique/Hybride/Autre).
  energy                      InstallationEnergy?
  year                        Int?
  color                       String?
  // V1.5 (Sprint L) — Estimation consommation pour les rapports : litres
  // au 100km par defaut selon le type vehicule. Si null, on utilise une valeur
  // par defaut cote service (CAR=7, TRUCK=22, VAN=10, MOTO=4, BUS=28).
  fuelConsumptionL100km       Float?
  // Calibration carburant « methode du plein » (2026-07) — consommation REELLE mesuree a partir des
  // pleins renseignes (litres/distance entre 2 pleins complets). Recalculee a chaque plein. Quand
  // presente, elle PRIME sur fuelConsumptionL100km partout (rapports/PDF/Excel/fuel card) -> l'app
  // devient precise « au fur et a mesure ». calibratedTanks = nb de reservoirs mesures (confiance).
  calibratedConsumptionL100km Float?
  calibratedTanks             Int                      @default(0)
  calibratedAt                DateTime?
  /// Conducteur "courant" du vehicule. Sert de defaut snappe sur Trip.driverId
  /// au moment de la cloture du trajet (driverSource='AUTO'). Modifiable a
  /// posteriori par les admins/managers.
  currentDriverId             String?                  @db.Uuid
  currentDriver               Driver?                  @relation("VehicleCurrentDriver", fields: [currentDriverId], references: [id], onDelete: SetNull)
  tracker                     Tracker?
  schedule                    VehicleSchedule?
  trips                       Trip[]
  alerts                      Alert[]
  groups                      VehicleGroupAssignment[]
  userAccess                  UserVehicleAccess[]
  surveillanceProfile         SurveillanceProfile?
  surveillanceEvents          SurveillanceEvent[]
  installationTasks           InstallationTask[]       @relation("InstallationTaskVehicle")
  // Sprint 7 — baseline kilometrique autoritaire (saisi a l'entretien) + agenda.
  lastOdometerKm              Int?
  lastOdometerAt              DateTime?
  // Sprint 8 — caractéristiques pour les critères de réservation : nb de places,
  // sièges enfants/pouponnière, équipements (tags libres extensibles).
  seats                       Int?
  childSeats                  Int?
  features                    String[]                 @default([])
  vehicleEvents               VehicleEvent[]
  maintenancePlans            MaintenancePlan[]
  // Espace dépôt (2026-08) — missions portées par ce véhicule. onDelete: Restrict côté
  // Mission : la suppression est refusée tant qu'une mission non terminée existe.
  missions                    Mission[]
  // Zones mortes GPS (suivi FS-253) : endroits ou CE vehicule perd recurremment son lock GPS.
  gpsDeadZones                GpsDeadZone[]
  gpsLossEvents               GpsLossEvent[]
  // Mode vie privee : quand ON, AUCUNE position n'est collectee/diffusee pour ce
  // vehicule (la trame est jetee a l'ingestion ; la derniere position connue reste
  // figee). `privacyModeSince`/`By`/`Note` = etat courant ; l'historique complet
  // (qui/quand/note) vit dans PrivacyModeEvent.
  /// Usage MIXTE déclaré (véhicule de service ramené au domicile). false = véhicule purement
  /// professionnel : tracé 24/7, antivol actif la nuit et le week-end. true = le cadre de temps de
  /// travail s'applique : hors plage, plus aucune position n'est collectée (RGPD/CNIL).
  /// Activé explicitement par le fleet-admin, véhicule par véhicule (proportionnalité).
  mixedUseEnabled             Boolean                  @default(false)
  /// Cas SPECIAL declare par un super-admin : le vehicule n'est plus exploite (accident,
  /// boitier debranche/depose, immobilisation longue). null = en service, valeur = hors service.
  ///
  /// Ce n'est PAS un statut cosmetique : tant qu'il est pose, les traitements de fond cessent de
  /// travailler sur ce vehicule (analyse et recalcul des trajets) et les detecteurs cessent
  /// d'alerter sur lui (perte de GPS, veille accident). Un vehicule accidente qui reste dans le
  /// perimetre produit un flot d'alertes vraies-mais-inutiles et bloque la convergence — mesure
  /// le 2026-08-21 sur KSR370 : 843 trajets a re-segmenter et 1 309 a analyser, soit 99 % du
  /// reste-a-faire de toute la flotte pour un seul vehicule hors service.
  outOfServiceReason          VehicleOutOfServiceReason?
  outOfServiceSince           DateTime?
  outOfServiceById            String?                  @db.Uuid
  outOfServiceNote            String?
  privacyModeEnabled          Boolean                  @default(false)
  privacyModeSince            DateTime?
  privacyModeById             String?                  @db.Uuid
  privacyModeNote             String?
  privacyModeEvents           PrivacyModeEvent[]
  // Incr. RGPD calendrier — cadre de temps de travail (opt-in). Hors plages = prive (non
  // collecte) par defaut. `workOverrideUntil` = exception ponctuelle « je travaille » (conducteur,
  // ex. intervention un dimanche) : force le suivi jusqu'a cette date malgre le calendrier.
  workSchedule                VehicleWorkSchedule?
  workOverrideUntil           DateTime?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  @@unique([fleetId, plate])
  @@index([fleetId])
  @@index([currentDriverId])
  @@map("vehicles")
}

/// Historique des bascules du mode vie privee d'un vehicule (tracabilite :
/// qui a active/desactive, quand, avec quelle note). Une ligne par bascule.
model PrivacyModeEvent {
  id        String   @id @default(uuid()) @db.Uuid
  vehicleId String   @db.Uuid
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fleetId   String   @db.Uuid
  /// true = mode prive ACTIVE ; false = DESACTIVE.
  enabled   Boolean
  reason    String?
  /// Auteur de la bascule (null = systeme/auto, reserve phase 2 horaires).
  userId    String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([vehicleId, createdAt])
  @@index([fleetId, createdAt])
  @@map("privacy_mode_events")
}

/// Incr. RGPD calendrier — CADRE de temps de travail par vehicule (usage mixte).
/// Opt-in (`enabled`). Hors des plages declarees = mode prive AUTOMATIQUE (positions non
/// collectees a l'ingestion). Meme structure de plages que VehicleSchedule (moteur) pour
/// REUTILISER l'evaluateur `evaluateSchedule` (fuseau, multi-plages, feries, plages de nuit).
/// Defini par le fleet-admin (employeur) ; visible du conducteur ; toute edition est auditee.
model VehicleWorkSchedule {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @unique @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  enabled   Boolean @default(false)
  timezone  String  @default("Europe/Paris")

  mondayEnabled    Boolean @default(true)
  mondayStart      String?
  mondayEnd        String?
  tuesdayEnabled   Boolean @default(true)
  tuesdayStart     String?
  tuesdayEnd       String?
  wednesdayEnabled Boolean @default(true)
  wednesdayStart   String?
  wednesdayEnd     String?
  thursdayEnabled  Boolean @default(true)
  thursdayStart    String?
  thursdayEnd      String?
  fridayEnabled    Boolean @default(true)
  fridayStart      String?
  fridayEnd        String?
  saturdayEnabled  Boolean @default(false)
  saturdayStart    String?
  saturdayEnd      String?
  sundayEnabled    Boolean @default(false)
  sundayStart      String?
  sundayEnd        String?

  // Multi-plages par jour (override les paires start/end legacy si non null).
  mondaySlots    Json?
  tuesdaySlots   Json?
  wednesdaySlots Json?
  thursdaySlots  Json?
  fridaySlots    Json?
  saturdaySlots  Json?
  sundaySlots    Json?

  countryCode String @default("FR")
  customDates Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_work_schedules")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sprint 7 — Agenda générique (maintenance + incidents ; fondation Sprint 8 réservations)
// ─────────────────────────────────────────────────────────────────────────────

enum VehicleEventType {
  MAINTENANCE
  INCIDENT
  RESERVATION // (Sprint 8) STUB — non câblé en S7
  // Espace dépôt (2026-08) — l'événement d'agenda d'une mission. Porte `blocksVehicle`,
  // donc entre dans le chemin d'indisponibilité EXISTANT (findImmobilized). Aucun second
  // mécanisme : deux sources d'indisponibilité, une seule logique de lecture (A2 § 3.2).
  MISSION
}

enum VehicleEventStatus {
  PLANNED
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
  REQUESTED // Sprint 8 — réservation déposée, en attente de validation (NON bloquant)
  CONFIRMED // Sprint 8 — réservation ferme (BLOQUANTE : conflits + disponibilité)
}

/// Sprint 7 — Événement générique sur la timeline d'un véhicule. Porte la maintenance et
/// les incidents ; conçu pour accueillir les réservations (Sprint 8) sans refonte
/// (startAt/endAt/allDay = créneau, metadata = champs par type, type extensible).
model VehicleEvent {
  id        String  @id @default(uuid()) @db.Uuid
  fleetId   String  @db.Uuid // tenant (scoping) — scalaire, cascade via le véhicule
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type     VehicleEventType
  category String? // sous-type libre extensible : 'OIL_CHANGE','TECHNICAL_INSPECTION','DOOR_ISSUE'…
  status   VehicleEventStatus @default(PLANNED)
  severity String? // incidents : 'LOW'|'MEDIUM'|'HIGH'

  title       String
  description String?

  startAt       DateTime // ancrage temporel (échéance/réalisation/début)
  endAt         DateTime? // plage (garage du X au Y ; créneau réservation S8)
  allDay        Boolean   @default(true)
  // Immobilise le véhicule : tant que l'événement est actif (PLANNED/OPEN/IN_PROGRESS),
  // le véhicule est exclu des suggestions/réservations (roue crevée, passage garage…).
  blocksVehicle Boolean   @default(false)

  odometerKm    Int? // km saisi (autoritaire) au moment de l'événement
  planId        String?          @db.Uuid
  plan          MaintenancePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  linkedEventId String?          @db.Uuid // chaînage : incident -> passage garage

  resolvedAt DateTime?
  metadata   Json? // extensible par type sans migration (S8 : réservé par, motif…)

  createdBy String @db.Uuid
  source    String @default("MANUAL") // MANUAL | AUTO | SYSTEM

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fleetId, startAt])
  @@index([vehicleId, startAt(sort: Desc)])
  @@index([fleetId, type, startAt])
  @@index([fleetId, status])
  @@index([planId])
  @@map("vehicle_events")
}

/// Sprint 7 — Plan de maintenance récurrent (CT/vidange « tous les X mois/km »). Génère
/// des VehicleEvent PLANNED (prochaine échéance) + déclenche les rappels.
model MaintenancePlan {
  id        String  @id @default(uuid()) @db.Uuid
  fleetId   String  @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  category           String // 'OIL_CHANGE','TECHNICAL_INSPECTION',…
  label              String
  intervalMonths     Int? // tous les N mois (l'un et/ou l'autre)
  intervalKm         Int? // tous les N km
  lastDoneAt         DateTime?
  lastDoneKm         Int?
  reminderDaysBefore Int       @default(30)
  reminderKmBefore   Int?      @default(1000)
  enabled            Boolean   @default(true)

  events VehicleEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fleetId, vehicleId])
  @@index([enabled])
  @@map("maintenance_plans")
}

model Tracker {
  id                     String                     @id @default(uuid()) @db.Uuid
  imei                   String                     @unique
  model                  String                     @default("COBAN_GPS403D")
  status                 TrackerStatus              @default(OFFLINE)
  lastSeenAt             DateTime?
  // V1.4 — etat ignition fiable (remote `2c7e29b`)
  lastKnownIgnition      Boolean?
  lastIgnitionChangeAt   DateTime?
  // V1.4 — denormalisation derniere position connue (Sprint A — hydratation au login)
  // Permet l'hydratation immediate de la carte au login sans attendre la prochaine trame.
  lastLat                Float?
  lastLng                Float?
  lastSpeedKmh           Float?
  lastHeading            Float?
  lastIgnition           Boolean?
  lastValid              Boolean?
  lastPositionAt         DateTime?
  // Incident FS-253 (GPS perdu) — reception de la derniere trame `no_fix` (LBS sans
  // lock GPS). Un boitier VIVANT (lastSeenAt frais) qui emet des `no_fix` RECENTS alors
  // que `lastPositionAt` est perime = GPS perdu (antenne debranchee / masquee / ciel).
  // C'est le discriminant qui distingue « GPS perdu » d'un simple stationnement (un
  // boitier gare sain n'emet PAS de `no_fix`, il dort en heartbeat). Alimente l'etat
  // GPS_LOST cote UI + le detecteur d'alerte gps-integrity.
  lastNoFixAt            DateTime?
  // V1.5 (Sprint H1) — etat du sampling adaptatif.
  // lastWriteAt = derniere fois ou une trame a ete reellement persistee dans `positions`
  //              (different de lastPositionAt qui suit `deviceTime` de la trame brute).
  // lastSampledState = derniere classification appliquee (MOVING / IDLE_ENGINE_ON / STOPPED).
  // verboseUntil = override admin temporaire qui force l'INSERT de chaque trame (debugging).
  lastWriteAt            DateTime?
  lastSampledState       String?

  /// TRK-030 — Alimentation externe absente SANS coupure reelle (batterie pleine).
  /// L'information n'a pas a reveiller quelqu'un, mais elle ne doit pas disparaitre :
  /// elle se lit sur la fiche vehicule. Se taire sans laisser de trace remplacerait
  /// un bruit par une cecite.
  lastPowerNoticeAt      DateTime?
  lastPowerNotice        String?
  /// TRK-040 — soupçon de coupure réelle ouvert à batterie pleine. À l'instant zéro
  /// d'une vraie coupure la batterie est pleine PAR DÉFINITION : on ne tranche pas,
  /// on note l'heure de la PREMIÈRE trame et la batterie du moment, et le cron
  /// power-cut-recheck réexamine à partir de T+30 min. Refermé par un contact remis
  /// (kt) ou par l'alerte confirmée.
  powerLossSuspectAt      DateTime?
  powerLossSuspectBattery Int?
  /// TRK-040 — dernière batterie interne transmise par le boîtier (toute trame
  /// position, pas seulement les alarmes) : c'est la pente que le réexamen lit.
  lastBatteryPercent     Int?
  lastBatteryAt          DateTime?
  verboseUntil           DateTime?
  // V1.5 (Sprint H3) — pilotage du fix interval boitier (commande Coban `fix...***n`).
  // desired = ce que le serveur veut que le boitier emette ; current = ce qu'on observe
  // reellement. Si desired != current pendant > 6 trames, on incrementre le compteur
  // d'echec et on marque le tracker FAILING.
  desiredFixIntervalS    Int                        @default(30)
  currentFixIntervalS    Int?
  /// TRK-056 — fenetre glissante des 12 derniers ecarts entre trames valides (secondes).
  /// `currentFixIntervalS` en est la MEDIANE, et non le dernier echantillon : sur un
  /// boitier qui emet par salves, un echantillon unique est un tirage, pas une mesure.
  recentFixIntervalsS    Int[]                      @default([])
  lastFixIntervalSyncAt  DateTime?
  // Compteur d'echecs consecutifs (commande envoyee non prise en compte par le boitier).
  fixCommandFailureCount Int                        @default(0)
  fixCommandFailing      Boolean                    @default(false)
  // Override admin : si > now, le serveur ne tente pas de nouvelles transitions
  // automatiques (utile pour figer le tracker en mode 30s pour 24h depuis l'admin).
  fixModeOverrideUntil   DateTime?
  // Timestamp deviceTime de la derniere trame valide observee — sert au reconciler
  // pour calculer le delta entre 2 trames et inferer l'intervalle reel.
  lastValidFrameAt       DateTime?
  // V1.5 (Sprint I) — numero E.164 de la SIM data du boitier. Permet le fallback
  // SMS quand la socket TCP est indisponible. Renseigne au moment du provisionnement
  // SMS via /admin/sms/provision.
  simPhoneNumber         String?
  /// V1.7 — Indique si le fil ACC du boitier (jaune) est physiquement connecte
  /// au +12V apres contact. Si false, le serveur infere `ignition` depuis la
  /// vitesse GPS (>3 km/h => ON). Reglable par SUPER_ADMIN uniquement depuis
  /// la fiche vehicule. Default true (cas standard en flotte pro).
  accConnected           Boolean                    @default(true)
  vehicleId              String?                    @unique @db.Uuid
  vehicle                Vehicle?                   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  positions              Position[]
  samplingDecisions      PositionSamplingDecision[]
  commands               EngineControlCommand[]
  // Sprint 4 — commandes d'ecoute audio (audit immuable, Scenario A appel live).
  audioCommands          AudioMonitoringCommand[]
  trackerCommands        TrackerCommand[]
  alerts                 Alert[]
  installationTasks      InstallationTask[]         @relation("InstallationTaskTracker")
  // V1.16 — SIM data physiquement posee dans ce boitier (1:1).
  sim                    Sim?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([status])
  @@map("trackers")
}

/// V1.5 (Sprint H1) — audit trail du sampling adaptatif.
/// Chaque trame entrante (valide) genere une ligne ici, qu'elle soit persistee
/// dans `positions` ou skippee. Permet a l'admin d'auditer l'efficacite du
/// sampling et de detecter un boitier qui spam des positions identiques ou
/// un sampling trop agressif.
/// Retention courte : purge auto au-dela de 7 jours (cron quotidien).
model PositionSamplingDecision {
  id         String   @id @default(uuid()) @db.Uuid
  trackerId  String   @db.Uuid
  tracker    Tracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  decision   String // 'INSERTED' | 'SKIPPED_DUP' | 'SKIPPED_THROTTLE' | 'INSERTED_VERBOSE' | 'SKIPPED_REPLAY'
  state      String // 'MOVING' | 'IDLE_ENGINE_ON' | 'STOPPED'
  reason     String? // ex: "haversine 3m < 15m radius, throttle 90s active"
  speedKmh   Float?
  ignition   Boolean?
  distanceM  Float? // distance haversine vs derniere position persistee
  receivedAt DateTime @default(now())

  @@index([trackerId, receivedAt(sort: Desc)])
  @@index([receivedAt])
  @@map("position_sampling_decisions")
}

/// `location` (geography Point 4326) ajouté manuellement dans la migration.
model Position {
  id         String   @id @default(uuid()) @db.Uuid
  trackerId  String   @db.Uuid
  tracker    Tracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  speedKmh   Float    @default(0)
  heading    Float    @default(0)
  altitude   Float?
  satellites Int?
  valid      Boolean  @default(true)
  ignition   Boolean?
  timestamp  DateTime
  createdAt  DateTime @default(now())

  @@index([trackerId, timestamp(sort: Desc)])
  // Sprint 6 — ancrage de la purge par rétention (createdAt = heure serveur, fiable).
  @@index([createdAt])
  @@map("positions")
}

model Trip {
  id                 String    @id @default(uuid()) @db.Uuid
  vehicleId          String    @db.Uuid
  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trackerId          String?   @db.Uuid
  fleetId            String?   @db.Uuid
  startedAt          DateTime
  endedAt            DateTime?
  durationSeconds    Int       @default(0)
  startLat           Float     @default(0)
  startLng           Float     @default(0)
  endLat             Float?
  endLng             Float?
  distanceKm         Float     @default(0)
  distanceMeters     Float     @default(0)
  maxSpeed           Float     @default(0)
  avgSpeed           Float     @default(0)
  positionCount      Int       @default(0)
  segmentationSource String    @default("live")
  /// Espace dépôt (2026-08) — mission à laquelle ce trajet est rattaché, une fois la
  /// mission terminée. C'est ce lien qui autorise un DEPOT à consulter le trajet dans
  /// son historique. Null = trajet ordinaire, invisible de tout dépôt.
  missionId          String?   @db.Uuid
  mission            Mission?  @relation("TripMission", fields: [missionId], references: [id], onDelete: SetNull)
  polyline           String?
  /// Sprint G.3 V1.4 : polyligne snappee aux routes via OSRM /match.
  /// Si null, le frontend affiche `polyline` (raw GPS).
  polylineMatched    String?
  /// Note libre attachee au trajet, max ~500 chars cote app (libre cote DB).
  /// Editable par FLEET_ADMIN, FLEET_MANAGER (avec perm `trips_edit_notes`)
  /// et SUPER_ADMIN. On ne garde pas l'historique : seul le dernier auteur
  /// est trace via `notesUpdatedBy*` pour traçabilite minimale.
  notes              String?   @db.Text
  notesUpdatedAt     DateTime?
  notesUpdatedById   String?   @db.Uuid
  notesUpdatedBy     User?     @relation("TripNotesAuthor", fields: [notesUpdatedById], references: [id], onDelete: SetNull)
  /// Conducteur snape sur ce trajet. Renseigne automatiquement a la cloture
  /// (`driverSource='AUTO'`) depuis Vehicle.currentDriverId si defini.
  /// Editable a posteriori par les admins/managers (`driverSource='MANUAL'`).
  driverId           String?   @db.Uuid
  driver             Driver?   @relation("TripDriver", fields: [driverId], references: [id], onDelete: SetNull)
  /// 'AUTO' = snape depuis Vehicle.currentDriver au finalize.
  /// 'MANUAL' = modifie manuellement par un admin/manager.
  /// null = pas de driver (jamais assigne).
  driverSource       String?
  createdAt          DateTime  @default(now())

  @@index([vehicleId, startedAt(sort: Desc)])
  @@index([fleetId, startedAt(sort: Desc)])
  @@index([driverId, startedAt(sort: Desc)])
  @@index([missionId])
  @@map("trips")
}

// ─────────────────────────────────────────────────────────────────────────────
// Espace dépôt (2026-08) — les missions. Cf. design/A2-MISSIONS.md § 1.
//
// L'application connaissait des TRAJETS (Trip), détectés a posteriori depuis les
// positions. Elle ne connaissait pas d'INTENTION : personne ne déclarait « ce camion
// part à 8h15 livrer Muret pour le dépôt de Fenouillet ».
//
// La mission est cette déclaration, et le pivot de tout le bloc A : c'est elle qui
// ouvre l'accès au dépôt, et sa fenêtre horaire qui le referme.
// ─────────────────────────────────────────────────────────────────────────────

model Mission {
  id      String @id @default(uuid()) @db.Uuid
  /// Référence lisible, séquence par flotte : « M-2481 ». Générée en transaction —
  /// deux missions créées simultanément ne doivent pas recevoir la même référence.
  /// La contrainte @@unique([fleetId, ref]) est le filet, pas le mécanisme.
  ref     String
  fleetId String @db.Uuid
  fleet   Fleet  @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  /// Origine et destination : soit un lieu clé de la flotte, soit une adresse libre.
  originPlaceId String? @db.Uuid
  originLabel   String
  destPlaceId   String? @db.Uuid
  destLabel     String

  /// LA FENÊTRE. C'est elle qui borne l'accès du dépôt : hors de [startAt, endAt],
  /// la position n'est plus servie — l'API répond 403, ce n'est pas un filtre d'affichage.
  startAt DateTime
  endAt   DateTime

  vehicleId String  @db.Uuid
  /// Restrict : un véhicule ne se supprime pas tant qu'une mission non terminée existe.
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driverId  String? @db.Uuid
  driver    Driver? @relation("MissionDriver", fields: [driverId], references: [id], onDelete: SetNull)

  /// Le compte DEPOT destinataire. Null = mission interne, invisible de tout dépôt.
  /// SetNull : si le dépôt est supprimé, la mission survit et redevient interne.
  depotUserId String? @db.Uuid
  depotUser   User?   @relation("MissionDepot", fields: [depotUserId], references: [id], onDelete: SetNull)

  /// Statut DÉRIVÉ, jamais saisi : aucun bouton « passer en cours ». Cf. A2 § 2.
  status        MissionStatus @default(PLANNED)
  /// Horodatages réels, alimentés par la détection de position.
  actualStartAt DateTime?
  actualEndAt   DateTime?
  /// Trajet(s) rattachés une fois la mission terminée.
  trips         Trip[]        @relation("TripMission")

  /// Notes internes du transporteur — NON transmises au dépôt.
  notes           String?
  createdByUserId String?            @db.Uuid
  cancelledAt     DateTime?
  cancelReason    String?
  /// Lot A4 — les liens publics de suivi ouverts sur cette mission. Cascade : la mission
  /// disparaît, ses liens aussi. Un lien orphelin serait un accès sans objet ni contrôle.
  shareLinks      MissionShareLink[]
  /// La demande dont cette mission est nee, quand elle vient d une negociation.
  request         MissionRequest?    @relation("MissionFromRequest")
  /// Les arrets de la tournee. originLabel/destLabel en sont le resume derive.
  stops           MissionStop[]
  /// L'historique des versions de la tournee, du plus ancien au plus recent.
  stopRevisions   MissionStopRevision[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([fleetId, ref])
  @@index([fleetId, startAt])
  /// L'index du périmètre dépôt : toute requête d'un DEPOT porte depotUserId.
  @@index([depotUserId, startAt])
  /// L'index de l'indisponibilité véhicule et de la détection de conflit de créneau.
  @@index([vehicleId, startAt, endAt])
  @@map("missions")
}

/// Espace dépôt (2026-08), lot A4 — LE LIEN PUBLIC DE SUIVI.
///
/// ┌─ CE QUE CE MODÈLE PROTÈGE ────────────────────────────────────────────────┐
/// │ Un lien public qui n'expire pas, ou qui expose plus que prévu, est une      │
/// │ fuite PERMANENTE et INDEXABLE. Le dépôt l'envoie par SMS à son client       │
/// │ final ; ce SMS se transfère, se copie dans un groupe, finit sur une page.   │
/// │                                                                            │
/// │ D'où trois propriétés portées par le modèle lui-même :                      │
/// │   · `token` unique, opaque, 22 caractères base62 — jamais un uuid de        │
/// │     mission, jamais dérivé d'un identifiant existant ;                      │
/// │   · `expiresAt` calculé À LA CRÉATION et JAMAIS prolongeable — aucun        │
/// │     endpoint ne le repousse, prolonger c'est créer un nouveau lien ;        │
/// │   · le suivi d'usage (`openCount`, `lastOpenedFrom`) pour que le dépôt      │
/// │     révoque en connaissance de cause.                                       │
/// └────────────────────────────────────────────────────────────────────────────┘
///
/// Calqué sur `ReservationBookingLink`, qui a fait ses preuves — avec l'expiration
/// rendue OBLIGATOIRE (là-bas elle est facultative : ici, un lien sans terme n'a
/// aucun sens légitime). Cf. design/A4-PARTAGE.md § 1.
model MissionShareLink {
  id        String  @id @default(uuid()) @db.Uuid
  missionId String  @db.Uuid
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  /// Opaque, imprévisible, 22 caractères base62. JAMAIS un uuid de mission : un token
  /// prévisible donnerait accès à toutes les missions par simple énumération.
  token String @unique

  /// Qui a généré le lien — un compte DEPOT, ou un gestionnaire du transporteur.
  /// Cascade : le compte supprimé emporte ses liens. Un lien sans auteur est un accès
  /// que plus personne n'assume.
  createdByUserId String @db.Uuid
  createdBy       User   @relation("MissionShareAuthor", fields: [createdByUserId], references: [id], onDelete: Cascade)

  /// L'EXPIRATION. Calculée à la création, jamais prolongeable, vérifiée à chaque
  /// requête à l'heure serveur.
  expiresAt DateTime
  duration  ShareDuration

  revokedAt       DateTime?
  revokedByUserId String?   @db.Uuid

  /// Suivi d'usage — pour une révocation éclairée et pour l'audit.
  openCount      Int       @default(0)
  firstOpenedAt  DateTime?
  lastOpenedAt   DateTime?
  /// Empreinte TRONQUÉE de l'appelant (« 92.184.x.x »), jamais l'IP complète : on veut
  /// distinguer deux destinataires, pas identifier une personne (RGPD).
  lastOpenedFrom String?

  createdAt DateTime @default(now())

  @@index([missionId, createdAt])
  /// L'index de la purge quotidienne des liens expirés.
  @@index([expiresAt])
  @@map("mission_share_links")
}

/// Les trois durées d'A4 § 4. Pas de durée libre : un champ « nombre de minutes »
/// finirait à 43 200 le jour où quelqu'un voudra « un lien pour le mois ».
enum ShareDuration {
  /// `now + 15 min` — le défaut, et la contrainte client explicite.
  MIN_15
  /// `now + 1 h`
  HOUR_1
  /// `mission.endAt + 30 min`. La marge couvre le retard : un lien qui expire pile à
  /// l'heure prévue meurt au moment où le client en a le plus besoin.
  UNTIL_MISSION_END
}

enum MissionStatus {
  /// À la création. La position n'est PAS servie au dépôt, même si startAt est passé.
  PLANNED
  /// Première position détectée après startAt − 15 min.
  IN_PROGRESS
  /// now > endAt et véhicule pas encore arrivé. N'INTERROMPT PAS le suivi : c'est
  /// précisément le moment où le dépôt a le plus besoin de voir le camion.
  LATE
  /// Arrivée détectée, ou clôture manuelle. Ferme l'accès et tous les liens de partage.
  DONE
  /// Annulation explicite avec motif. Reste dans l'historique du dépôt.
  CANCELLED
}

// ═══════════════════════════════════════════════════════════════════════════════
//  DEMANDES DE MISSION ET DEVIS  (2026-08)
//
//  Jusqu'ici le dépôt était un TIERS EN LECTURE SEULE : il recevait des missions,
//  il n'en demandait aucune. Ce bloc lui ouvre le droit de DEMANDER — pas de créer.
//  La distinction porte tout le reste : une demande n'immobilise aucun véhicule,
//  n'ouvre aucun accès à une position, et ne devient une `Mission` qu'au moment où
//  le transporteur affecte un camion. Tant que les deux parties n'ont pas signé,
//  rien n'existe côté exploitation.
//
//  Trois décisions structurantes, écrites ici parce qu'elles ne se devinent pas :
//
//  1. LA NÉGOCIATION EST UN FIL, PAS DEUX CHAMPS. Chaque proposition est une ligne
//     de `MissionQuoteRound`. Écraser un « prix courant » ferait perdre qui a
//     proposé quoi et quand — et une négociation commerciale sans trace est un
//     litige en puissance.
//
//  2. LES DISTANCES SONT EN MÈTRES, ENTIERS. Le devis est un calcul d'argent : les
//     kilomètres flottants introduisent une dérive d'arrondi qui finit par une
//     facture contestée. On stocke des mètres, on affiche des kilomètres.
//
//  3. LES MONTANTS SONT EN CENTIMES, ENTIERS — même convention que
//     `AiSubscription.unitAmountEurCents`, pour la même raison.
// ═══════════════════════════════════════════════════════════════════════════════

/// Le cycle d'une demande. Les transitions sont gardées côté service ; cet enum ne
/// fait que les nommer.
enum MissionRequestStatus {
  /// Le dépôt saisit. Rien n'est parti, rien n'est visible du transporteur.
  DRAFT
  /// Envoyée. Le devis automatique est calculé À CET INSTANT et figé dans le
  /// premier tour : un tarif modifié après coup ne doit pas réécrire une offre
  /// déjà lue par le dépôt.
  SUBMITTED
  /// Une contre-proposition est sur la table, en attente de l'autre partie.
  /// L'auteur du dernier tour dit qui doit répondre.
  NEGOTIATING
  /// Les deux parties sont d'accord sur un montant. Reste à affecter.
  ACCEPTED
  /// Camion et conducteur affectés : la `Mission` existe. Fin du cycle.
  CONVERTED
  /// Refusée par l'une des deux parties, avec motif.
  REJECTED
  /// Personne n'a répondu avant l'échéance du devis.
  EXPIRED
}

/// Ce qu'on vient faire à une adresse. Une tournée mélange les deux.
enum MissionStopKind {
  PICKUP
  DROPOFF
}

/// Qui a émis un tour de négociation. Le rôle, pas la personne : c'est la POSITION
/// dans la négociation qui compte, et elle survit au départ d'un salarié.
enum QuoteRoundAuthor {
  /// Proposé par le système au dépôt de la grille tarifaire du transporteur.
  SYSTEM
  DEPOT
  CARRIER
}

/// Une DEMANDE de mission émise par un compte dépôt.
///
/// ⚠️ Ce n'est PAS une `Mission`. Aucun véhicule n'est réservé, aucun événement
/// d'agenda n'est posé, aucune position n'est servie. La `Mission` naît à
/// l'affectation, par `MissionsService.creer` — le chemin existant, avec ses sept
/// validations et ses quatre effets de bord.
model MissionRequest {
  id      String @id @default(uuid()) @db.Uuid
  /// Référence lisible, séquence par flotte : « D-0142 ». Distincte de celle des
  /// missions : un dépôt qui appelle doit pouvoir dire « ma demande D-0142 » sans
  /// qu'on la confonde avec la mission M-0142 d'un autre client.
  ref     String
  fleetId String @db.Uuid
  fleet   Fleet  @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  /// L'auteur. Cascade : le compte disparaît, ses demandes aussi — contrairement
  /// aux missions, qui survivent parce qu'elles ont eu lieu.
  depotUserId String @db.Uuid
  depotUser   User   @relation("MissionRequestDepot", fields: [depotUserId], references: [id], onDelete: Cascade)

  status MissionRequestStatus @default(DRAFT)

  /// Le trajet, en une ou plusieurs adresses (cf. MissionStop).
  stops MissionStop[]

  /// La fenêtre SOUHAITÉE. Le transporteur peut la contester en contre-proposant :
  /// c'est une demande, pas une réservation.
  wantedStartAt DateTime
  wantedEndAt   DateTime

  /// Ce que le dépôt fait transporter. Texte libre : normaliser une nomenclature
  /// de marchandises serait un chantier à soi seul, et personne ne la remplirait.
  goodsDescription String?
  weightKg         Int?
  /// Type de véhicule souhaité — sert le coefficient tarifaire.
  vehicleType      VehicleType?

  /// ── LES TROIS DISTANCES, ET POURQUOI ELLES SONT TROIS ────────────────────────
  /// `declared` : ce que le dépôt a saisi. `estimated` : ce que le serveur calcule
  /// depuis les adresses. Elles divergent souvent, et aucune des deux n'a raison
  /// d'office — le dépôt connaît ses contraintes de tournée, le calcul ignore les
  /// interdictions de tonnage. `used` est celle RETENUE pour le devis, choisie par
  /// le transporteur. Garder les trois permet de dire « vous aviez annoncé 40 km,
  /// nous en comptons 47 » plutôt que d'imposer un chiffre sans explication.
  declaredDistanceM  Int?
  estimatedDistanceM Int?
  usedDistanceM      Int?

  /// Les tours de négociation, du plus ancien au plus récent.
  rounds MissionQuoteRound[]

  /// Le montant sur lequel les deux parties se sont accordées, en centimes.
  agreedAmountCents Int?
  agreedAt          DateTime?
  /// Échéance du devis courant. Passée, la demande bascule EXPIRED.
  quoteExpiresAt    DateTime?

  /// Motif de refus — obligatoire côté service. Sans lui, l'autre partie ne sait
  /// pas quoi corriger et repose la même demande.
  rejectedAt     DateTime?
  rejectedReason String?
  rejectedBy     QuoteRoundAuthor?

  /// La mission née de cette demande. SetNull : la mission peut être supprimée
  /// sans effacer la trace de la négociation qui l'a produite.
  missionId String?  @unique @db.Uuid
  mission   Mission? @relation("MissionFromRequest", fields: [missionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fleetId, ref])
  /// Le tableau du transporteur : ses demandes en attente, les plus récentes d'abord.
  @@index([fleetId, status, createdAt])
  /// L'écran du dépôt : les siennes.
  @@index([depotUserId, createdAt])
  @@map("mission_requests")
}

/// Une adresse d'une tournée — d'une DEMANDE ou d'une MISSION.
///
/// ┌─ POURQUOI PARTOUT, ET PAS SEULEMENT SUR LA DEMANDE ───────────────────────┐
/// │ « C'est rare, les missions avec une seule adresse » (client, 2026-08-13).  │
/// │ Cantonner les arrêts à la demande aurait produit une mission APPAUVRIE dès │
/// │ sa création : le transporteur aurait perdu, en convertissant, l'essentiel  │
/// │ de ce que le dépôt avait décrit.                                          │
/// └────────────────────────────────────────────────────────────────────────────┘
///
/// ⚠️ `Mission.originLabel` et `Mission.destLabel` RESTENT, et deviennent DÉRIVÉS :
/// premier et dernier arrêt. Les conserver évite de toucher `MissionListeDto`,
/// `MissionEnCoursDto`, l'espace dépôt, les liens publics et l'agenda — soit tout ce
/// que le client teste en ce moment. Les arrêts sont la source de vérité, les deux
/// libellés en sont le résumé, recalculé à chaque écriture.
///
/// Composition, volontairement SOUPLE (client, 2026-08-13) : un seul `PICKUP`, en
/// position 0 — l'adresse de chargement, elle ne bouge pas. Au moins un `DROPOFF`,
/// sans maximum. Le retour au dépôt est un `DROPOFF` COMME UN AUTRE, jamais ajouté
/// d'office : « le retour n'est pas obligatoire ».
model MissionStop {
  id String @id @default(uuid()) @db.Uuid

  /// L'un OU l'autre, jamais les deux — garde posée côté service, Prisma ne sait
  /// pas exprimer un « exactement un parmi deux » (contrainte CHECK ajoutée par la
  /// migration).
  requestId String?         @db.Uuid
  request   MissionRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  missionId String?         @db.Uuid
  mission   Mission?        @relation(fields: [missionId], references: [id], onDelete: Cascade)

  /// Rang dans la tournée, à partir de 0. C'est l'ordre de passage demandé.
  position Int
  kind     MissionStopKind @default(DROPOFF)

  /// Adresse libre, ou lieu clé de la flotte quand il est connu.
  label   String
  placeId String?     @db.Uuid
  place   FleetPlace? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  /// Coordonnées, quand le géocodage a abouti. Nulles = distance non estimable
  /// sur ce segment, et l'écran doit le dire plutôt que d'afficher un zéro.
  lat Float?
  lng Float?

  /// Créneau souhaité sur cet arrêt précis, quand il y en a un.
  wantedAt DateTime?
  note     String?

  createdAt DateTime @default(now())

  @@unique([requestId, position])
  @@unique([missionId, position])
  @@index([requestId])
  @@index([missionId])
  @@map("mission_stops")
}

/// UNE version de la tournée d'une mission. Immuable une fois écrite.
///
/// ┌─ POURQUOI UN JOURNAL ET PAS UN SIMPLE « modifiéLe / modifiéPar » ──────────┐
/// │ Une tournée qui change change AUSSI le prix : trois livraisons de plus, et │
/// │ la distance saute d'une tranche. Six mois plus tard, face à une facture    │
/// │ contestée, « modifié le 15 août par Claire » ne répond à aucune des trois  │
/// │ questions qui comptent : qu'y avait-il AVANT, combien ça valait, et        │
/// │ pourquoi ça a bougé.                                                       │
/// │                                                                            │
/// │ Chaque ligne porte donc l'ÉTAT COMPLET après le changement, plus le tarif  │
/// │ recalculé et celui d'avant. On relit l'histoire sans la reconstituer, et   │
/// │ sans dépendre d'une grille tarifaire qui aura pu changer entre-temps.      │
/// │                                                                            │
/// │ Même patron que `MissionQuoteRound` pour la négociation : une ligne par    │
/// │ mouvement, jamais un champ tenu en parallèle qui diverge de son historique.│
/// └────────────────────────────────────────────────────────────────────────────┘
model MissionStopRevision {
  id        String  @id @default(uuid()) @db.Uuid
  missionId String  @db.Uuid
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  /// Rang de la révision, à partir de 0. La 0 est l'état À LA CRÉATION : sans elle,
  /// l'historique commencerait au premier changement et personne ne saurait d'où
  /// la tournée est partie.
  position Int

  /// L'auteur. `authorUserId` peut devenir nul (compte supprimé) — c'est pourquoi
  /// le NOM est figé à l'écriture. Un journal dont les auteurs s'effacent avec les
  /// comptes ne prouve plus rien.
  authorUserId String?   @db.Uuid
  authorUser   User?     @relation("MissionStopRevisionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorName   String
  authorRole   UserRole

  /// Ce que l'auteur a répondu à « pourquoi ». Facultatif à la création (rien à
  /// justifier), demandé ensuite.
  reason String?

  /// L'état COMPLET des arrêts après ce changement : `[{ position, kind, label }]`.
  /// Figé en JSON plutôt que recomposé depuis `MissionStop`, qui ne porte que
  /// l'état COURANT.
  stops Json

  /// Distance retenue après ce changement, en mètres. Nulle tant que personne ne
  /// l'a saisie — aucun service de routage n'est branché (cf. A6 Q3).
  distanceM Int?

  /// Tarif recalculé sur la grille après ce changement, en centimes HT.
  /// `null` = « sur devis », ou aucune grille active : on ne l'invente pas.
  amountCents Int?

  /// Le tarif d'AVANT, pour lire l'écart sans rejouer tout l'historique.
  previousAmountCents Int?

  createdAt DateTime @default(now())

  @@unique([missionId, position])
  @@index([missionId])
  @@map("mission_stop_revisions")
}

/// UN tour de négociation. Immuable une fois écrit.
///
/// Le montant courant d'une demande, c'est le dernier tour — jamais un champ tenu
/// à jour en parallèle, qui finirait par diverger de son propre historique.
model MissionQuoteRound {
  id        String         @id @default(uuid()) @db.Uuid
  requestId String         @db.Uuid
  request   MissionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// Rang du tour, à partir de 0. Le tour 0 est le devis automatique.
  position Int
  author   QuoteRoundAuthor
  /// Null pour un tour SYSTEM : personne ne l'a écrit.
  authorUserId String? @db.Uuid

  /// NULL = « sur devis » : la distance dépasse la dernière tranche chiffrée, aucun
  /// montant n'est calculable. Le tour existe quand même — il porte les conditions.
  amountCents Int?

  /// ┌─ UN TOUR PORTE SES CONDITIONS, PAS SEULEMENT UN PRIX ─────────────────────┐
  /// │ Une contre-proposition peut changer les adresses, le créneau et la         │
  /// │ distance retenue, pas uniquement le montant (arbitrage I, 2026-08-13).     │
  /// │                                                                            │
  /// │ Chaque tour fige donc l'INTÉGRALITÉ de ce qu'il propose : arrêts, fenêtre, │
  /// │ distance. Accepter, c'est accepter UNE VERSION PRÉCISE — un accord sur un  │
  /// │ prix dont les conditions ont bougé entre-temps n'est pas un accord.        │
  /// │                                                                            │
  /// │ Snapshot COMPLET et non différentiel : quelques centaines d'octets contre  │
  /// │ une reconstitution par accumulation de diffs, qui se lit mal et se trompe. │
  /// └────────────────────────────────────────────────────────────────────────────┘
  terms Json

  /// Le détail du calcul, figé. Pour un tour automatique : la tranche appliquée,
  /// le HT, la TVA, le TTC. Pour un tour humain ajusté : le calcul de départ ET
  /// l'écart consenti. Jamais recalculé — une grille modifiée demain ne doit pas
  /// réécrire un devis déjà lu.
  breakdown Json?

  /// Le mot qui accompagne l'offre. C'est souvent lui qui débloque la négociation.
  message String?

  createdAt DateTime @default(now())

  @@unique([requestId, position])
  @@index([requestId, position])
  @@map("mission_quote_rounds")
}

/// La grille tarifaire d'une flotte — ce qui permet de calculer un devis.
///
/// Par flotte, comme `AgendaAgentSettings`, et NON un singleton : `PricingSettings`
/// (plus haut) est le prix de vente de Tracky lui-même, un autre domaine.
///
/// ⚠️ TANT QU'AUCUNE LIGNE N'EXISTE POUR UNE FLOTTE, LA DEMANDE DE MISSION EST
/// FERMÉE À SES DÉPÔTS. Un devis calculé sur une grille vide vaudrait zéro euro et
/// partirait quand même : mieux vaut une fonctionnalité indisponible qu'une offre
/// commerciale fausse.
model MissionPricingSettings {
  id      String @id @default(uuid()) @db.Uuid
  fleetId String @unique @db.Uuid
  fleet   Fleet  @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  /// Interrupteur explicite. Une grille remplie mais désactivée ferme la demande
  /// sans effacer les tarifs — utile le temps de les revoir.
  enabled Boolean @default(false)

  /// ── LES TRANCHES SONT LE CŒUR DU CALCUL ──────────────────────────────────────
  /// La grille réelle du client n'est PAS un prix au kilomètre : c'est un forfait
  /// par tranche de distance (79 € de 0 à 50 km, 169 € de 51 à 100…). Un modèle
  /// unitaire aurait produit des montants faux à chaque borne.
  tiers MissionPricingTier[]

  /// ── SUPPLÉMENTS, TOUS OPTIONNELS ─────────────────────────────────────────────
  /// À zéro par défaut : « modulable et non stricte » (client, 2026-08-13). Une
  /// flotte dont les tranches couvrent tout les laisse à zéro et ils disparaissent
  /// du devis.
  /// Chaque livraison au-delà de la première.
  extraStopCents   Int @default(0)
  /// Attente sur site, à l'heure entamée.
  waitingHourCents Int @default(0)

  /// TVA en pourcentage entier appliqué au total HT. 20 = 20 %.
  vatPct Int @default(20)

  /// Durée de validité d'un devis, en heures. Au-delà, la demande expire.
  quoteValidityHours Int @default(48)

  /// Mot affiché au dépôt sous le devis — conditions, délais de paiement.
  quoteFooterNote String?

  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("mission_pricing_settings")
}

/// Une tranche de distance et son forfait.
///
/// ┌─ « SUR DEVIS » EST UN ÉTAT, PAS UN PRIX ───────────────────────────────────┐
/// │ La grille du client s'arrête à 400 km : au-delà, « Sur devis ». On le      │
/// │ représente par `priceCents = NULL`, et cela se propage jusqu'au bout :     │
/// │ aucun tour 0 automatique n'est écrit, la demande part SANS montant, et le  │
/// │ transporteur chiffre lui-même.                                            │
/// │                                                                            │
/// │ Mettre zéro à la place aurait produit un devis à 0 € — une offre           │
/// │ commerciale fausse, envoyée à un client final.                            │
/// └────────────────────────────────────────────────────────────────────────────┘
model MissionPricingTier {
  id         String                 @id @default(uuid()) @db.Uuid
  settingsId String                 @db.Uuid
  settings   MissionPricingSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  /// La prestation. Libellé libre : la grille du client est numérotée
  /// (« 2. Courses Express »), donc d'autres suivront, et une énumération figée
  /// imposerait une migration à chaque ajout.
  category String

  /// Rang d'affichage et d'évaluation, à partir de 0.
  position Int

  /// Bornes en KILOMÈTRES, toutes deux INCLUSES. `toKm` nul = pas de limite haute.
  /// Le service refuse les trous et les recouvrements : une distance doit tomber
  /// dans une tranche et une seule.
  fromKm Int
  toKm   Int?

  /// Forfait HT en centimes. NULL = « sur devis » (cf. l'encadré).
  priceCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([settingsId, category, position])
  @@index([settingsId, category, fromKm])
  @@map("mission_pricing_tiers")
}

/// Conducteur — variante "hybride" (Phase 2).
///
/// - Le driver est une entite metier de la fleet, pas necessairement une
///   personne ayant un acces a l'app. `userId` est null par defaut : on
///   peut creer un driver "tag" sans login pour juste tracer qui conduisait.
/// - Phase 3 (futur) : on pourra "promouvoir" un driver en lui creant un
///   compte User avec role DRIVER (table User + relation 1:1 ici).
/// - Soft delete via `isActive=false` (idem User). On n'efface pas un driver
///   pour preserver l'historique des Trip.driverId snappes.
/// - Couleur servant de pastille UI pour repere visuel rapide (ex: planning).
model Driver {
  id              String    @id @default(uuid()) @db.Uuid
  fleetId         String    @db.Uuid
  fleet           Fleet     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  /// E.164 (+33612345678) — utile pour SMS/whatsapp futur, validation cote app.
  phone           String?
  email           String?
  /// Numero de permis (libre, usage interne — pas de validation officielle).
  licenseNumber   String?
  /// Couleur hex de pastille UI (default vert tracky).
  color           String?   @default("#10E0A0")
  /// Note libre sur le conducteur (a propos de lui, distinct de Trip.notes).
  notes           String?   @db.Text
  isActive        Boolean   @default(true)
  /// Phase 3 — Si renseigne, ce driver a un compte User (login) avec role DRIVER.
  /// 1:1 strict (un User = un Driver max).
  userId          String?   @unique @db.Uuid
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Vehicules dont ce driver est le conducteur "courant" (defaut sur les
  /// prochains trajets). Souvent 1, peut etre N si plusieurs vehicules.
  currentVehicles Vehicle[] @relation("VehicleCurrentDriver")
  /// Tous les trajets snappes sur ce driver (historique).
  trips           Trip[]    @relation("TripDriver")
  /// Espace depot (2026-08) — missions affectees a ce conducteur. La mission garde le
  /// conducteur historique meme s'il est retire du vehicule (SetNull a la suppression).
  missions        Mission[] @relation("MissionDriver")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([fleetId])
  @@index([fleetId, isActive])
  @@map("drivers")
}

/// `geometry` (geography 4326) ajouté manuellement dans la migration.
model Geofence {
  id             String            @id @default(uuid()) @db.Uuid
  fleetId        String            @db.Uuid
  fleet          Fleet             @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  name           String
  type           GeofenceType
  rule           GeofenceRule      @default(BOTH)
  centerLat      Float             @default(0)
  centerLng      Float             @default(0)
  radiusMeters   Int               @default(500)
  /// Pour les geofences POLYGON : liste ordonnee de sommets [{lat, lng}, ...].
  /// Sprint F.2 V1.4. Ignore si type = CIRCLE.
  polygonPoints  Json?
  /// V1.5 (Sprint N) — pour les geofences CORRIDOR : polyligne ordonnee
  /// + largeur en metres. Alerte si le vehicule sort du buffer.
  corridorPoints Json?
  corridorWidthM Int?              @default(100)
  color          String?           @default("#10e0a0")
  active         Boolean           @default(true)
  vehicleTargets GeofenceVehicle[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([fleetId])
  @@map("geofences")
}

/// V1.5 (Sprint N) — Ciblage explicite d'une geofence sur des vehicules.
/// Si une geofence n'a aucune ligne dans cette table, elle s'applique a tous
/// les vehicules de la fleet (mode global, compat V1). Si elle a au moins une
/// ligne, elle ne s'applique qu'aux vehicules listes ici.
model GeofenceVehicle {
  geofenceId String   @db.Uuid
  vehicleId  String   @db.Uuid
  geofence   Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([geofenceId, vehicleId])
  @@index([vehicleId])
  @@map("geofence_vehicles")
}

model Alert {
  id                String             @id @default(uuid()) @db.Uuid
  fleetId           String             @db.Uuid
  fleet             Fleet              @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  vehicleId         String?            @db.Uuid
  vehicle           Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  trackerId         String?            @db.Uuid
  tracker           Tracker?           @relation(fields: [trackerId], references: [id], onDelete: SetNull)
  type              AlertType
  severity          AlertSeverity      @default(WARNING)
  title             String
  message           String?
  payload           Json?
  latitude          Float?
  longitude         Float?
  acknowledgedAt    DateTime?
  acknowledgedBy    String?            @db.Uuid
  acknowledgedUser  User?              @relation("AlertAcknowledgedBy", fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  // V1.5 (Sprint M) — escalade automatique si CRITICAL non-ack > N min.
  // Une alerte ne peut etre escaladee qu'une seule fois (escalatedAt non null).
  escalatedAt       DateTime?
  surveillanceEvent SurveillanceEvent?
  createdAt         DateTime           @default(now())

  @@index([fleetId, createdAt(sort: Desc)])
  @@index([fleetId, acknowledgedAt])
  // V1.10 (Sprint 2 perf) — KPI dashboard "alertes critiques recentes" — sans cet
  // index la query alert.count({where:{fleetId, severity, acknowledgedAt:null}})
  // doit full-scan le fleet bucket. A 100 vehicules + 10k alertes/mois c'est 20-50ms
  // a chaque rafraichissement KPI (toutes les 30s par user dashboard).
  @@index([fleetId, severity, createdAt(sort: Desc)])
  @@index([vehicleId])
  @@index([trackerId])
  @@map("alerts")
}

/// Zones mortes GPS (2026-07, suivi FS-253) — regroupe les endroits ou un vehicule perd
/// RECURREMMENT son lock GPS. Ancre = derniere position VALIDE avant la perte (figee cote
/// Tracker.lastLat/lastLng pendant toute une perte continue) = point d'entree de la zone
/// (rampe de parking, entree de tunnel). Le clustering incremental (centroide en moyenne
/// mobile + rayon observe borne) est fait par GpsDeadZonesService. Une zone confirmee
/// « normale » (parking souterrain) par un operateur cesse de generer des alertes GPS_LOST.
model GpsDeadZone {
  id           String            @id @default(uuid()) @db.Uuid
  vehicleId    String            @db.Uuid
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  // fleetId denormalise (pas de relation) — scoping/filtre societe sans back-relation Fleet.
  fleetId      String            @db.Uuid
  // Centroide (moyenne mobile des points de perte) + rayon observe (m), borne cote service.
  centroidLat  Float
  centroidLng  Float
  radiusM      Float             @default(0)
  // Nombre d'EPISODES distincts de perte rattaches (1 episode continu = 1 occurrence).
  occurrences  Int               @default(1)
  firstSeenAt  DateTime          @default(now())
  lastSeenAt   DateTime          @default(now())
  status       GpsDeadZoneStatus @default(LEARNING)
  label        GpsDeadZoneLabel  @default(UNKNOWN)
  // Libelle geocode best-effort (ville/commune via Nominatim), null si inconnu/indisponible.
  placeLabel   String?
  note         String?
  // Tracabilite de la revue operateur (confirmation/qualification).
  reviewedById String?           @db.Uuid
  reviewedAt   DateTime?
  events       GpsLossEvent[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([vehicleId])
  @@index([fleetId])
  @@map("gps_dead_zones")
}

/// Un episode de perte GPS rattache (ou non) a une GpsDeadZone. `lostAt` = horodatage de la
/// derniere position valide (point d'entree) : FIGE pendant toute une perte continue, donc il
/// IDENTIFIE l'episode. La contrainte unique (vehicleId, lostAt) rend l'enregistrement
/// IDEMPOTENT — le cron gps-integrity peut re-selectionner le meme boitier a chaque tick sans
/// gonfler les occurrences ; deux stationnements distincts ont un `lostAt` different (= 2 lignes).
model GpsLossEvent {
  id         String       @id @default(uuid()) @db.Uuid
  vehicleId  String       @db.Uuid
  vehicle    Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fleetId    String       @db.Uuid
  trackerId  String?      @db.Uuid
  zoneId     String?      @db.Uuid
  zone       GpsDeadZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  // Point d'entree = derniere position valide connue avant la perte.
  lat        Float
  lng        Float
  lostAt     DateTime
  detectedAt DateTime     @default(now())
  /// Retour du signal : horodatage de la PREMIERE position valide apres la perte, ecrit a
  /// l'ingestion (TRK-028). NULL tant que le vehicule n'est pas ressorti — un episode
  /// ouvert. C'est la seule donnee qui permet de dire « le signal revient apres X »
  /// plutot que de constater une absence sans fin.
  recoveredAt DateTime?

  @@unique([vehicleId, lostAt])
  @@index([zoneId])
  @@index([fleetId, detectedAt])
  /// Retrouver les episodes OUVERTS d'un vehicule sans balayer la table : c'est la
  /// requete du chemin d'ingestion, la plus chaude du systeme.
  @@index([vehicleId, recoveredAt])
  @@map("gps_loss_events")
}

/// Lieux cles (2026-07) — referentiel METIER des lieux de la flotte, cree/valide A LA MAIN par
/// l'exploitant : stations-service retenues, parkings & stationnements recurrents (ex. « CDEF
/// Launaguet »), depots. Pilote la couleur sur la carte (station VALIDEE vs simplement detectee)
/// et sert de point de reference pour regrouper les arrets. Distinct de `FuelStation` (catalogue
/// externe prix-carburants) et de `GpsDeadZone` (detectee automatiquement, par vehicule).
model FleetPlace {
  id          String         @id @default(uuid()) @db.Uuid
  fleetId     String         @db.Uuid
  name        String
  kind        FleetPlaceKind @default(OTHER)
  lat         Float
  lng         Float
  /// Rayon de rattachement (m) : « ce vehicule s'est arrete A ce lieu ».
  radiusM     Float          @default(120)
  note        String?
  /// Station d'origine quand le lieu vient de la VALIDATION d'un passage detecte (FuelStation.id).
  /// Unique par flotte -> une station ne peut pas etre validee deux fois. NULL pour un parking
  /// cree a la main (plusieurs NULL autorises par l'index unique Postgres).
  stationId   String?        @db.Uuid
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  /// Arrets de demandes de mission qui pointent sur ce lieu. SetNull cote arret :
  /// supprimer un lieu cle ne doit pas effacer une demande deja negociee.
  requestStops MissionStop[]

  @@unique([fleetId, stationId])
  @@index([fleetId])
  @@index([fleetId, kind])
  @@map("fleet_places")
}

/// Analyse IA d'un lieu cle. UNE analyse COURANTE par lieu (re-analyser remplace).
/// `facts` fige les donnees OSM + flotte sur lesquelles l'IA a raisonne : sans ca on ne pourrait
/// pas verifier a posteriori d'ou sort une affirmation (l'IA REFORMULE des faits, elle n'en cree pas).
model PlaceAnalysis {
  id               String   @id @default(uuid()) @db.Uuid
  placeId          String   @unique @db.Uuid
  fleetId          String   @db.Uuid
  /// Faits sources figes (OSM + agregats flotte) au moment de l'analyse.
  facts            Json?
  summary          String   @db.Text
  /// Points cles (string[]) et actions proposees (string[]).
  highlights       Json
  recommendations  Json
  /// Attribution / audit : qui a repondu, quel modele, combien ca a coute.
  aiProvider       String?
  aiModel          String?
  costEur          Float?
  /// 'manual' (bouton) ou 'scheduled' (automatisation).
  origin           String   @default("manual")
  /// EMPREINTE des faits sources (hash stable). Garde-fou COUT n1 de l'automatisation : si les
  /// faits n'ont pas bouge depuis la derniere analyse, re-analyser produirait le meme texte pour
  /// le meme prix -> on saute. Null = analyses avant l'automatisation (jamais sautees a tort).
  factsHash        String?
  computedByUserId String?  @db.Uuid
  computedAt       DateTime @default(now())

  @@index([fleetId, computedAt])
  @@map("place_analyses")
}

/// Automatisation des analyses de lieux (singleton, comme AiBudget/TripAutomationSettings).
/// OPT-IN : `enabled` false par defaut — aucune depense tant que le super-admin n'a rien active.
/// Les bornes ci-dessous sont CUMULATIVES : la depense d'un run est majoree par le plus petit de
/// (maxAnalysesPerRun x cout unitaire) et (maxCostEurPerRun), et le budget mensuel global prime.
model PlaceAutomationSettings {
  id                String    @id @default(uuid()) @db.Uuid
  enabled           Boolean   @default(false)
  /// Heure du run quotidien (0-23, Europe/Paris). 3h = creux (les crons agenda/trajets sont a 2h/45).
  hour              Int       @default(3)
  /// Delai MINIMUM entre deux analyses d'un meme lieu (jours). Borne principale de la depense :
  /// un lieu coute au plus 1 analyse par periode, quoi qu'il arrive.
  minIntervalDays   Int       @default(30)
  /// Ne pas re-analyser un lieu dont les faits sont INCHANGES (compare `factsHash`).
  skipUnchanged     Boolean   @default(true)
  /// Bornes dures par run.
  maxAnalysesPerRun Int       @default(20)
  maxCostEurPerRun  Float     @default(1)
  lastRunAt         DateTime?
  lastRunStats      Json?
  updatedByUserId   String?   @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("place_automation_settings")
}

/// Historique des passages d'automatisation des lieux — 1 ligne par run. Sert a REPONDRE a
/// « qu'est-ce que ca m'a coute et pourquoi » : combien analyses, combien SAUTES et pour quelle
/// raison, cout reel en euros, et pourquoi le run s'est arrete.
model PlaceAutomationRun {
  id               String    @id @default(uuid()) @db.Uuid
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  /// 'scheduled' (cron) | 'manual' (bouton) | 'dry-run' (simulation, aucune depense).
  origin           String    @default("scheduled")
  fleets           Int       @default(0)
  candidates       Int       @default(0)
  analyzed         Int       @default(0)
  skippedUnchanged Int       @default(0)
  skippedCooldown  Int       @default(0)
  skippedAiOff     Int       @default(0)
  failed           Int       @default(0)
  costEur          Float     @default(0)
  durationMs       Int       @default(0)
  /// Raison d'arret : 'completed' | 'max_analyses' | 'max_cost' | 'month_budget' | 'error'.
  stopReason       String    @default("completed")
  /// Detail borne : [{ fleetId, fleetName, placeId, placeName, action, costEur }].
  items            Json?

  @@index([startedAt(sort: Desc)])
  @@map("place_automation_runs")
}

/// V1.6 — Surveillance Max : profil de surveillance renforcee par vehicule.
/// Un seul profil par vehicule. Quand `currentlyArmed = true`, toute trame
/// d'alarme `vibration` / `movement` / `door` recue cree un SurveillanceEvent
/// et eleve la severite de l'alerte associee a CRITICAL.
/// L'armement peut etre manuel (POST /surveillance/.../arm) ou automatique
/// via SurveillanceSchedulerService (cron toutes les minutes) selon les
/// plages horaires definies.
model SurveillanceProfile {
  id                      String                  @id @default(uuid()) @db.Uuid
  vehicleId               String                  @unique @db.Uuid
  vehicle                 Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fleetId                 String                  @db.Uuid
  fleet                   Fleet                   @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  mode                    SurveillanceMode        @default(OFF)
  sensitivity             SurveillanceSensitivity @default(MEDIUM)
  // Plage horaire (HH:mm, UTC). Si `scheduleStartTime > scheduleEndTime`,
  // la plage passe minuit (ex 20:00 -> 06:00).
  scheduleStartTime       String?
  scheduleEndTime         String?
  // Jours actifs : array de strings ["mon","tue","wed","thu","fri","sat","sun"].
  // Null = tous les jours.
  scheduleDays            Json?
  /// Samedi et dimanche COCHÉS sont surveillés 24 h, au lieu de suivre la plage.
  /// « Un week-end n'a pas d'heures ouvrées » : un profil 20:00-06:00 laissait le
  /// samedi de 06:00 à 20:00 SANS protection — quatorze heures où un dépôt est vide.
  ///
  /// ⚠️ Défaut `false` VOLONTAIRE. Passer les profils existants à 24 h le week-end
  /// changerait un antivol déjà en service sans que personne l'ait demandé (plus de
  /// protection, mais aussi plus de déclenchements sur une manœuvre légitime du
  /// samedi). C'est la même prudence que la migration `surveillance_horaires_locaux`.
  /// L'écran, lui, propose la case COCHÉE à la création. Décision client du 2026-08-16.
  weekendPermanent        Boolean                 @default(false)
  // Triggers actifs lors d'un armement.
  triggerVibration        Boolean                 @default(true)
  triggerMovement         Boolean                 @default(true)
  triggerDoor             Boolean                 @default(false)
  // Destinataires supplementaires (FLEET_MANAGER opt-in). Les FLEET_ADMIN
  // de la fleet sont notifies par defaut via NotificationDispatchService.
  additionalNotifyUserIds String[]
  // Etat courant — maintenu par armNow/disarmNow ou par le scheduler.
  currentlyArmed          Boolean                 @default(false)
  lastArmedAt             DateTime?
  lastDisarmedAt          DateTime?
  // Audit : qui a cree le profil.
  createdBy               String                  @db.Uuid
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  events SurveillanceEvent[]

  @@index([fleetId])
  @@index([mode, currentlyArmed])
  @@map("surveillance_profiles")
}

/// V1.6 — Surveillance Max : evenement de declenchement.
/// Cree par AlertsService.createFromCobanFrame() quand un vehicule arme
/// recoit une trame d'alarme correspondant a ses triggers actifs.
/// Lie a l'Alert correspondante (1:1, optionnel — l'Alert peut etre purgee).
model SurveillanceEvent {
  id             String                   @id @default(uuid()) @db.Uuid
  profileId      String                   @db.Uuid
  profile        SurveillanceProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  vehicleId      String                   @db.Uuid
  vehicle        Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fleetId        String                   @db.Uuid
  fleet          Fleet                    @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  alertId        String?                  @unique @db.Uuid
  alert          Alert?                   @relation(fields: [alertId], references: [id], onDelete: SetNull)
  trigger        SurveillanceEventTrigger
  triggeredAt    DateTime                 @default(now())
  latitude       Float?
  longitude      Float?
  speedKmh       Float?
  status         SurveillanceEventStatus  @default(PENDING)
  acknowledgedAt DateTime?
  acknowledgedBy String?                  @db.Uuid
  notes          String?
  createdAt      DateTime                 @default(now())

  @@index([fleetId, triggeredAt(sort: Desc)])
  @@index([vehicleId, triggeredAt(sort: Desc)])
  @@index([status])
  @@map("surveillance_events")
}

model VehicleGroup {
  id        String                   @id @default(uuid()) @db.Uuid
  name      String
  fleetId   String                   @db.Uuid
  fleet     Fleet                    @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  vehicles  VehicleGroupAssignment[]
  users     UserVehicleAccess[]
  createdAt DateTime                 @default(now())

  @@unique([fleetId, name])
  @@index([fleetId])
  @@map("vehicle_groups")
}

model VehicleGroupAssignment {
  vehicleId String       @db.Uuid
  groupId   String       @db.Uuid
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  group     VehicleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([vehicleId, groupId])
  @@map("vehicle_group_assignments")
}

/// V1.11 (Phase 1 refonte permissions) — `permissions` JSONB porte les
/// permissions resolues par scope. Resolution per-vehicle : on trie les lignes
/// qui couvrent ce vehicleId selon VEHICLE > GROUP > ALL et on prend la premiere.
/// Si `permissions` est null, on fallback sur `User.permissions`, puis sur
/// `getDefaultPermissions(role)`. Cf. PermissionsResolverService.
model UserVehicleAccess {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessType  AccessType
  groupId     String?       @db.Uuid
  group       VehicleGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  vehicleId   String?       @db.Uuid
  vehicle     Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  permissions Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([userId, accessType])
  @@map("user_vehicle_access")
}

enum TrackerCommandStatus {
  PENDING
  SCHEDULED
  SENT
  ACKNOWLEDGED
  FAILED
  CANCELLED
}

enum TrackerProvisioningStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum TrackerCommandChannel {
  TCP
  SMS
}

model TrackerCommand {
  id              String                @id @default(uuid()) @db.Uuid
  trackerId       String                @db.Uuid
  tracker         Tracker               @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  templateId      String
  category        String
  params          Json                  @default("{}")
  payload         String
  channel         TrackerCommandChannel @default(TCP)
  status          TrackerCommandStatus  @default(PENDING)
  scheduledAt     DateTime?
  sentAt          DateTime?
  ackedAt         DateTime?
  ackResponse     String?
  lastError       String?
  // V1.5 (Sprint H3) — observabilite admin enrichie. `expectedResult`/`observedResult`
  // sont des descriptions textuelles courtes, `contextSnapshot` est l'instantane JSON
  // capture au moment de l'envoi (etat vehicule, signal, derniere position).
  // `diagnosticHint` est une suggestion textuelle generee par le service quand la
  // commande echoue (ex: "tester reset SMS"). `acknowledgedBy` permet a un admin de
  // marquer une erreur comme traitee depuis le centre d'alertes.
  expectedResult  String?
  observedResult  String?
  contextSnapshot Json?
  diagnosticHint  String?
  outcomeReason   String?
  acknowledgedBy  String?               @db.Uuid
  acknowledgedAt  DateTime?
  requestedBy     String                @db.Uuid
  requestedByUser User                  @relation(fields: [requestedBy], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([trackerId, createdAt(sort: Desc)])
  @@index([status])
  @@index([scheduledAt])
  @@index([category, status])
  @@map("tracker_commands")
}

model WireLog {
  id        String   @id @default(uuid()) @db.Uuid
  imei      String
  direction String // 'IN' | 'OUT'
  raw       String   @db.Text
  frameType String? // 'login' | 'heartbeat' | 'position' | 'unknown' | 'command' | 'ack'
  commandId String?  @db.Uuid
  context   Json?
  createdAt DateTime @default(now())

  @@index([imei, createdAt(sort: Desc)])
  @@index([commandId])
  @@index([createdAt])
  @@map("wire_logs")
}

model ErrorLog {
  id        String   @id @default(uuid()) @db.Uuid
  level     String // 'ERROR' | 'CRITICAL'
  source    String // 'tcp-server' | 'engine-control' | 'tracker-commands' | 'http' | ...
  message   String
  stack     String?  @db.Text
  imei      String?
  commandId String?  @db.Uuid
  userId    String?  @db.Uuid
  context   Json?
  createdAt DateTime @default(now())

  // ── ARCHIVAGE REVERSIBLE (2026-08-22) ────────────────────────────────────────
  // Decision du proprietaire : on n'EFFACE jamais une ligne du centre d'alerte, on
  // la marque « resolue ». Elle sort de la vue par defaut, le filtre la ramene, et
  // `resolvedAt = null` la rouvre.
  //
  // Pourquoi un marquage et pas une suppression : la regle « ne jamais vider
  // error_logs » existe depuis l'origine, et TRK-035 montre ce que coute une ligne
  // disparue — 66 ecrites, 73 effacees en 20,7 h le 22/08, et un audit qui ne sait
  // plus ce que disaient les 65 manquantes. Un archivage qui SUPPRIME reproduirait
  // volontairement le defaut qu'on cherche a attribuer.
  resolvedAt   DateTime?
  resolvedById String?   @db.Uuid
  /** Rouvrir efface `resolvedAt` : on garde qui avait archive, et pourquoi. */
  resolvedNote String?   @db.Text

  @@index([source, createdAt(sort: Desc)])
  @@index([imei])
  @@index([commandId])
  @@index([createdAt])
  // La vue par defaut du centre d'alerte est « non resolues, les plus recentes
  // d'abord » : sans cet index elle balaie toute la table a chaque ouverture.
  @@index([resolvedAt, createdAt(sort: Desc)])
  @@map("error_logs")
}

/// TEMOIN DES DISPARITIONS — TRK-035.
///
/// Une ligne par INSTRUCTION de suppression (jamais une par ligne supprimee : un
/// DELETE de 170 000 lignes ecrit UN constat, pas 170 000). Alimentee par deux
/// declencheurs PostgreSQL, jamais par le code applicatif.
///
/// Pourquoi cette table existe : le 22/08, 73 lignes ont disparu de `error_logs` en
/// 20,7 h alors que le cron de retention consignait `errorDeleted: 0` cinq jours de
/// suite. La base ne journalise rien (`log_statement = none`, `logging_collector =
/// off`) et un seul role porte DELETE et TRUNCATE : rien, nulle part, ne pouvait
/// nommer l'auteur. La sonde de recensement voit qu'il MANQUE des lignes ; celle-ci
/// dit QUI, QUAND, D'OU et AVEC QUELLE REQUETE.
model DisparitionLignes {
  id        String   @id @default(uuid()) @db.Uuid
  /// Table visee : 'error_logs' | 'alerts'.
  tableCible String
  /// 'DELETE' | 'TRUNCATE'.
  operation String
  /// Nombre de lignes emportees par l'instruction.
  lignes    Int
  /// Role PostgreSQL effectif au moment du geste.
  utilisateur String
  /// Role de connexion (peut differer de `utilisateur` apres un SET ROLE).
  utilisateurSession String
  /// NULL = connexion par SOCKET LOCALE, donc depuis un shell dans le conteneur.
  /// Non nul = connexion TCP (l'API de production se presente en 172.23.0.x).
  adresseClient String?
  /// `application_name` : 'psql' pour une session humaine, autre chose pour un client.
  application String?
  /// Le texte de l'instruction, tel que PostgreSQL l'execute.
  requete   String?  @db.Text
  /// PID du backend, pour recouper avec pg_stat_activity a chaud.
  pidBackend Int?
  /// Bornes de ce qui a disparu — un DELETE de rattrapage et un effacement total
  /// ne laissent pas le meme intervalle.
  plusAncienneSupprimee DateTime?
  plusRecenteSupprimee  DateTime?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([tableCible, createdAt(sort: Desc)])
  @@map("disparitions_lignes")
}

/// REFROIDISSEMENTS D ALERTE — TRK-038.
///
/// « Depuis quand n a-t-on pas crie ? », pour les gardes anti-repetition qui vivaient
/// jusque-la dans un champ d instance — donc remis a zero par CHAQUE redemarrage,
/// c est-a-dire par l evenement qui provoque le plus de rafales.
///
/// ⚠️ POURQUOI UNE TABLE DEDIEE ET PAS `error_logs`. Le correctif d origine proposait
/// de lire `max("createdAt")` dans la table des erreurs. Mesure du 22/08 sur
/// TRK-039 : un garde-fou dont la memoire vit dans `error_logs` SE FAIT REARMER par
/// l effaceur de TRK-035 — la ligne temoin disparait, la deduplication repart a zero,
/// et l alerte se rejoue. Un garde-fou ne doit pas ranger sa memoire dans la piece
/// qu il surveille.
model RefroidissementAlerte {
  /// Identifiant stable du garde ('speed-limit-osm', 'error-rate-watchdog', ...).
  cle                String   @id
  derniereEmissionAt DateTime
  /// Combien de fois ce garde a laisse passer une emission. Utile pour juger si un
  /// refroidissement est bien dimensionne, sans relire les alertes elles-memes.
  emissions          Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  @@map("refroidissements_alerte")
}

/// Palier « Coûts IA » — un enregistrement par appel Claude RÉUSSI (les échecs vont dans ErrorLog).
/// Sert au tableau de bord super-admin : coût par requête / jour / mois / flotte / utilisateur.
model AiUsageLog {
  id               String   @id @default(uuid()) @db.Uuid
  createdAt        DateTime @default(now())
  userId           String?  @db.Uuid
  fleetId          String?  @db.Uuid
  model            String
  action           String // 'capacity' | 'placement'
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheWriteTokens Int      @default(0)
  cacheReadTokens  Int      @default(0)
  /// Coût estimé en USD (tarifs figés côté serveur au moment de l'appel).
  costUsd          Float    @default(0)
  latencyMs        Int?
  ok               Boolean  @default(true)
  /// Combien d'objets cet appel a réellement PRODUITS (trajets analysés, lieux
  /// qualifiés, créneaux proposés…). La page « Coûts IA » disait ce que l'IA
  /// coûte sans jamais dire ce qu'elle rend : une facture sans ligne.
  ///
  /// ⚠️ NULLABLE, et c'est le point. `0` affirmerait « cet appel n'a rien produit » ;
  /// `null` dit « on ne l'a pas noté » — c'est le cas de toutes les lignes
  /// antérieures à ce champ, et on ne réécrit pas le passé.
  resultCount      Int?
  /// QUI a réellement exécuté l'appel : `api` (crédits Anthropic, facturés) ou `local`
  /// (agent sur le poste du propriétaire, absorbé par l'abonnement Claude Code).
  ///
  /// Sans ce champ, un agent local travaillerait SANS TRACE dans les écrans de coûts : le
  /// travail disparaîtrait des tableaux au moment même où il cesse d'être facturé, et la
  /// page « Coûts IA » montrerait une baisse de dépense sans pouvoir dire pourquoi.
  ///
  /// ⚠️ NON nullable avec défaut `api`, contrairement à `resultCount` juste au-dessus — et la
  /// différence est délibérée. Toutes les lignes antérieures à ce champ ONT bien été facturées
  /// par l'API : aucun autre exécutant n'existait. Écrire `api` sur le passé énonce un fait
  /// vrai, là où un `0` sur `resultCount` en aurait inventé un.
  executor         String   @default("api")

  @@index([createdAt])
  @@index([fleetId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@map("ai_usage_logs")
}

/// Palier « Coûts IA » — budget mensuel (singleton) posé par le super-admin. Le tableau de bord
/// vire au rouge quand la dépense du mois approche/dépasse ce plafond. 0 = pas de budget défini.
model AiBudget {
  id               String   @id @default(uuid()) @db.Uuid
  monthlyBudgetEur Float    @default(0)
  updatedAt        DateTime @updatedAt
  updatedByUserId  String?  @db.Uuid

  @@map("ai_budget")
}

/// Couche IA multi-provider (2026-07) — provider IA sélectionné (singleton, comme AiBudget).
/// Togglé depuis la page « Coûts IA ». 'claude' (Anthropic) | 'gpt' (OpenAI). Défaut = claude
/// (comportement existant). Le routeur peut être surchargé par appel (mixte « par tâche »).
model AiProviderSettings {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @default("claude")
  updatedAt       DateTime @updatedAt
  updatedByUserId String?  @db.Uuid

  @@map("ai_provider_settings")
}

/// Traçabilité fine des trajets (2026-07, Palier 2) — analyse DÉTERMINISTE persistée d'un trajet
/// (une par Trip). Calculée à partir des positions filtrées : résumé, arrêts, qualité GPS, excès de
/// vitesse (vs limites OSM), éco-conduite (accélérations/freinages, ralenti, conso estimée). Source
/// UNIQUE réutilisée partout (fiche véhicule, rapports, replay). Le récit/Trust Score LLM (Palier 3)
/// s'ajoute dans les colonnes `provider`/`narrative`/`trustScore` sans recalcul.
model TripAnalysis {
  id        String @id @default(uuid()) @db.Uuid
  tripId    String @unique @db.Uuid
  fleetId   String @db.Uuid
  vehicleId String @db.Uuid

  // Résumé
  distanceKm  Float
  durationSec Int
  movingSec   Int
  avgSpeedKmh Float
  maxSpeedKmh Float
  stopCount   Int
  idleSec     Int // moteur tournant à l'arrêt (ignition ON, vitesse ~0)

  // Qualité GPS
  gpsPoints     Int
  gpsValidRatio Float // 0..1
  gpsLostCount  Int // trous de signal détectés

  // Excès de vitesse (limites OSM quand connues)
  speedingCount Int // nb de segments en excès
  speedingSec   Int // durée cumulée en excès
  maxOverKmh    Float // plus gros dépassement (km/h au-dessus de la limite)
  limitsKnown   Boolean @default(false) // au moins une limite OSM résolue
  /// Part des points RAPIDES ayant obtenu une limite (0..1). `null` = aucun point assez rapide
  /// pour qu'une limite soit demandée, ou analyse antérieure à la mesure.
  ///
  /// ⚠️ `limitsKnown` ne dit que « au moins UN point résolu » : un trajet couvert à 2 % et un
  /// trajet couvert à 100 % lui répondaient tous deux oui. C'est cette colonne qui permet de
  /// repérer les analyses à rejouer quand les limites arrivent après coup — cas constaté le
  /// 2026-09-03, où la limite d'un point est entrée en cache le LENDEMAIN du trajet.
  limitsCoverage Float?

  // Éco-conduite
  harshAccel Int
  harshBrake Int
  ecoScore   Int // 0..100 (100 = conduite souple/éco)
  fuelLiters Float? // conso estimée
  co2Kg      Float?

  // Détail structuré réutilisable (arrêts, segments d'excès, itinéraire, tracé simplifié)
  detail Json

  // Couche LLM optionnelle (Palier 3) — récit + Trust Score, sans recalcul du déterministe
  provider   String? // 'claude' | 'gpt' | 'local' (agent du poste) | null (déterministe seul)
  narrative  String?
  advice     String?
  trustScore Int? // Tracky Trust Score 0..100
  /// Date d'écriture du RÉCIT, distincte de `computedAt` (chiffres) et de `updatedAt` (ligne).
  /// Un recalcul remplace tous les chiffres et CONSERVE le récit : sans cette colonne, rien ne
  /// permettait de savoir que le texte affiché décrivait un état antérieur — ni à l'écran, ni
  /// à l'agent local, dont la reprise ne regarde que `narrative IS NULL`.
  narratedAt DateTime?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([vehicleId, computedAt])
  @@index([fleetId, computedAt])
  @@map("trip_analyses")
}

/// Cache des limites de vitesse OSM (Overpass `maxspeed`) — clé = coords arrondies (~55 m), comme le
/// cache de géocodage. On mémorise MÊME l'inconnu (maxspeed=null) pour ne pas re-taper Overpass.
model SpeedLimitCache {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  maxspeed  Int? // km/h ; null = inconnu (route sans tag maxspeed)
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@map("speed_limit_cache")
}

/// Stations-service détectées (cache mutualisé). Source = API officielle prix carburants FR
/// (`gouv-fr`, avec prix) ou OSM (`osm`, surtout la marque). Une station rencontrée par un arrêt
/// de véhicule est mémorisée ici pour ne pas re-taper l'API et pour historiser ses prix.
model FuelStation {
  id         String   @id @default(uuid()) @db.Uuid
  source     String // 'gouv-fr' | 'osm'
  externalId String // id station gouv (ex "40500002") ou id de nœud OSM
  brand      String? // marque (Total, Esso, Avia...) — best-effort via OSM
  name       String?
  address    String?
  city       String?
  postalCode String?
  lat        Float
  lng        Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  prices    FuelStationPrice[]
  fuelStops TripFuelStop[]
  fillUps   FuelFillUp[]

  @@unique([source, externalId])
  @@index([lat, lng])
  @@map("fuel_stations")
}

/// Historique des prix carburant d'une station (les prix bougent beaucoup → on capte à chaque
/// résolution). Dédupliqué par (station, carburant, date de MAJ source) : un même relevé source
/// n'est stocké qu'une fois, mais on garde l'évolution dans le temps pour l'analyse des coûts.
model FuelStationPrice {
  id              String      @id @default(uuid()) @db.Uuid
  stationId       String      @db.Uuid
  station         FuelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  fuelType        String // 'gazole' | 'sp95' | 'sp98' | 'e10' | 'e85' | 'gplc'
  priceEur        Float // prix au litre
  sourceUpdatedAt DateTime // date de MAJ du prix côté source (gouv)
  capturedAt      DateTime    @default(now())

  @@unique([stationId, fuelType, sourceUpdatedAt])
  @@index([stationId, fuelType, capturedAt])
  @@map("fuel_station_prices")
}

/// Passage détecté d'un véhicule à une station (un ARRÊT du trajet tombe sur une station). Sert à
/// la fréquence (« passe tous les X jours »), à l'estimation de coût carburant (litres estimés ×
/// prix capté) et aux rapports. Suit la convention de TripAnalysis : ids en Uuid sans relation
/// Trip/Vehicle (seule la station est reliée). Re-analyse = les passages du trajet sont remplacés.
model TripFuelStop {
  id           String      @id @default(uuid()) @db.Uuid
  tripId       String      @db.Uuid
  fleetId      String      @db.Uuid
  vehicleId    String      @db.Uuid
  stationId    String      @db.Uuid
  station      FuelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  arrivedAt    DateTime // début de l'arrêt
  durationSec  Int
  lat          Float
  lng          Float
  distanceM    Float // distance arrêt <-> station (m)
  fuelType     String? // carburant du véhicule (mappé depuis vehicle.energy)
  unitPriceEur Float? // prix au litre capté au moment du passage
  createdAt    DateTime    @default(now())

  @@index([vehicleId, arrivedAt])
  @@index([fleetId, arrivedAt])
  @@index([tripId])
  @@map("trip_fuel_stops")
}

/// Plein carburant RENSEIGNÉ (méthode du plein) — vérité terrain pour CALIBRER la consommation RÉELLE
/// d'un véhicule = litres / distance entre 2 pleins complets. Optionnel : le client saisit ses pleins
/// (litres + € du reçu) et l'app en déduit la conso réelle + affine tous les coûts « au fur et à
/// mesure ». INDÉPENDANT de TripFuelStop (survit à la ré-analyse). Rattachable à une station détectée.
model FuelFillUp {
  id              String       @id @default(uuid()) @db.Uuid
  fleetId         String       @db.Uuid
  vehicleId       String       @db.Uuid
  filledAt        DateTime // date/heure du plein
  litersFilled    Float // litres ajoutés (vérité terrain)
  amountPaidEur   Float? // montant payé (reçu) ; sinon dérivé de litres × prix constaté
  fullTank        Boolean      @default(true) // plein COMPLET ? (la méthode du plein l'exige pour calibrer)
  odometerKm      Float? // relevé compteur au plein (optionnel : distance précise entre pleins)
  fuelType        String? // carburant ('gazole'…)
  stationId       String?      @db.Uuid // lien optionnel vers une station détectée
  station         FuelStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  note            String?
  createdByUserId String?      @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([vehicleId, filledAt])
  @@index([fleetId, filledAt])
  @@map("fuel_fill_ups")
}

/// Palier B — Journal des actions AUTOMATIQUES / système (arrière-plan), distinct de
/// UserActivity (actions manuelles front). Alimenté par les primitives d'envoi (email / SMS /
/// push), les commandes moteur, la purge de rétention et les rapports IA planifiés. Couche
/// « feed » lisible ; l'audit technique détaillé reste dans smsLog / engineControlCommand /
/// aiUsageLog. Purgé par LogCleanupService (rétention ERROR_LOGS_RETENTION_DAYS).
model SystemActivityLog {
  id                String   @id @default(uuid()) @db.Uuid
  createdAt         DateTime @default(now())
  /// 'EMAIL' | 'SMS' | 'PUSH' | 'ENGINE' | 'RETENTION' | 'AI_REPORT'
  category          String
  /// Libellé court machine ('email_sent', 'engine_cut', 'positions_purged'…).
  action            String
  /// 'SUCCESS' | 'FAILURE' | 'SKIPPED'
  status            String   @default("SUCCESS")
  /// Acteur d'origine : 'system' | 'planning' | nom d'un cron | nom d'utilisateur.
  actor             String?
  /// Cible lisible : destinataire (masqué), plaque véhicule, résumé…
  target            String?
  /// Détail lisible (sujet d'e-mail, motif, compteur…).
  detail            String?
  fleetId           String?  @db.Uuid
  /// Utilisateur déclencheur si l'action découle d'un acte manuel (sinon null = auto/système).
  triggeredByUserId String?  @db.Uuid
  durationMs        Int?
  meta              Json?

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([fleetId, createdAt])
  @@map("system_activity_logs")
}

/// Observabilité du trafic API PUBLIC + intelligence IP (demande client 2026-07).
/// Une ligne = soit un HIT d'API publique capté par ApiTrafficInterceptor (kind='REQUEST'),
/// soit un BEACON d'activité partenaire (Maestroo / LP) reçu sur POST /api/partner/activity
/// (kind='PARTNER_EVENT'). Alimenté best-effort (fire-and-forget) — un échec du journal ne
/// casse JAMAIS la requête observée. `ipKnown` = l'IP a déjà été vue liée à un utilisateur
/// reconnu (leads LP + IP d'appels authentifiés) → sépare le trafic « connu » de l'« inconnu ».
model ApiTrafficLog {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now())
  /// 'REQUEST' (hit API public capturé) | 'PARTNER_EVENT' (beacon Maestroo/LP)
  kind       String
  /// 'LP' | 'MAESTROO' | 'API' | 'WEBHOOK' | 'UNKNOWN'
  source     String   @default("UNKNOWN")
  method     String?
  path       String?
  statusCode Int?
  /// Sémantique des beacons (teaser_open, cta_click, teaser_close…).
  action     String?
  /// Libellé bouton / cible.
  target     String?
  ip         String?
  ipKnown    Boolean  @default(false)
  userId     String?  @db.Uuid
  userAgent  String?
  durationMs Int?
  meta       Json?

  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([source, createdAt])
  @@index([kind, createdAt])
  @@map("api_traffic_logs")
}

enum ActivityReportStatus {
  PENDING
  READY
  FAILED
}

/// Palier 3 — Rapport d'observation IA sur l'activité d'un ou plusieurs utilisateurs.
/// Généré à la demande (ou par planification), PERSISTÉ pour conserver + ré-exploiter
/// (parcours + points de friction + adoption + recommandations). Le coût est aussi
/// journalisé dans AiUsageLog (tableau de bord Coûts IA).
model ActivityReport {
  id              String               @id @default(uuid()) @db.Uuid
  createdAt       DateTime             @default(now())
  createdByUserId String?              @db.Uuid
  /// Utilisateurs observés (UUIDs). Vide = tous les actifs (cas planification « ALL »).
  targetUserIds   String[]             @db.Uuid
  fromAt          DateTime
  toAt            DateTime
  status          ActivityReportStatus @default(READY)
  /// 'manual' | 'scheduled'
  origin          String               @default("manual")
  title           String?
  /// Contenu structuré (résumé, parcours, friction, adoption, recommandations).
  content         Json?
  error           String?
  model           String?
  costUsd         Float                @default(0)

  @@index([createdAt])
  @@map("activity_reports")
}

/// Palier 3 — Planification RÉGLABLE de la génération de rapports (singleton).
model ActivityReportSchedule {
  id              String    @id @default(uuid()) @db.Uuid
  enabled         Boolean   @default(false)
  /// 'daily' | 'weekly' | 'monthly'
  frequency       String    @default("weekly")
  /// Périmètre : 'ACTIVE' (utilisateurs actifs sur la période) | 'ALL'.
  scope           String    @default("ACTIVE")
  lastRunAt       DateTime?
  updatedAt       DateTime  @updatedAt
  updatedByUserId String?   @db.Uuid

  @@map("activity_report_schedule")
}

/// Automatisation trajets (2026-07) — planification RÉGLABLE (singleton) du pipeline
/// « recalcul des trajets → analyse déterministe → récit IA » pour TOUTES les flottes.
/// Piloté depuis l'espace super-admin ; consommé par TripAutomationService (cron horaire).
model TripAutomationSettings {
  id                  String    @id @default(uuid()) @db.Uuid
  /// Interrupteur maître de l'automatisation.
  enabled             Boolean   @default(false)
  /// Cadence : 'hourly' (phase de test) | 'daily'.
  frequency           String    @default("hourly")
  /// Heure du run quotidien (0-23, Europe/Paris) — utilisée si frequency='daily'.
  hour                Int       @default(2)
  /// Fenêtre de trajets balayée à chaque run (heures).
  lookbackHours       Int       @default(26)
  /// Recalculer les trajets (segmentation propre) AVANT d'analyser — évite d'analyser
  /// 10 fragments au lieu de 3 vrais trajets, et de lancer 10 récits IA au lieu de 3.
  recomputeTrips      Boolean   @default(true)
  /// Générer aussi les récits IA (ignoré si l'IA est coupée pour la flotte).
  narrateEnabled      Boolean   @default(true)
  /// Bornes de charge par run (protègent le VPS + le budget IA).
  maxAnalysesPerRun   Int       @default(300)
  maxNarrationsPerRun Int       @default(60)
  lastRunAt           DateTime?
  /// Dernier bilan { fleets, vehicles, recomputed, analyzed, narrated, failed, durationMs, at }.
  lastRunStats        Json?
  updatedByUserId     String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("trip_automation_settings")
}

/// Historique des passages d'automatisation — 1 ligne par run, pour tout retrouver
/// (QUAND, POUR QUI, QUOI) + les récits produits (cliquables). Élagué (garde les récents).
model TripAutomationRun {
  id         String    @id @default(uuid()) @db.Uuid
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// 'scheduled' (cron) | 'manual' (bouton « Lancer maintenant »).
  origin     String    @default("scheduled")
  fleets     Int       @default(0)
  vehicles   Int       @default(0)
  recomputed Int       @default(0)
  analyzed   Int       @default(0)
  narrated   Int       @default(0)
  failed     Int       @default(0)
  durationMs Int       @default(0)
  /// Détail borné des trajets traités : [{ fleetId, fleetName, vehicleId, plate, tripId, tripStartedAt, action }].
  items      Json?

  @@index([startedAt(sort: Desc)])
  @@map("trip_automation_runs")
}

/// Refonte agenda/IA (2026-07) — Reglages de l'agent d'optimisation d'agenda, PAR FLOTTE.
/// Pilotes depuis la roue crantee « Parametres de l'agenda ». Consommes par l'agent nocturne (P3).
/// 1 ligne par flotte (opt-in : enabled=false par defaut).
model AgendaAgentSettings {
  id                           String    @id @default(uuid()) @db.Uuid
  fleetId                      String    @unique @db.Uuid
  fleet                        Fleet     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  /// Interrupteur global de l'agent pour cette societe.
  enabled                      Boolean   @default(false)
  /// Heure de l'analyse nocturne (0-23, Europe/Paris). Defaut 2h.
  nightlyHour                  Int       @default(2)
  /// 'daily' | 'weekly'.
  frequency                    String    @default("daily")
  /// 'suggest' (propose seulement) | 'auto_high_confidence' (reserve ferme au-dessus du seuil).
  autonomy                     String    @default("suggest")
  /// Seuil de confiance % (0-100) au-dessus duquel l'auto reserve fermement.
  confidenceThreshold          Int       @default(80)
  /// Apres une reservation, l'IA optimise autour (mutualisation, cout).
  autoCompleteAfterReservation Boolean   @default(false)
  /// Declencheurs de (re)analyse.
  triggerNightly               Boolean   @default(true)
  triggerIncident              Boolean   @default(true)
  triggerMaintenance           Boolean   @default(true)
  triggerReservation           Boolean   @default(false)
  lastRunAt                    DateTime?
  updatedByUserId              String?   @db.Uuid
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@map("agenda_agent_settings")
}

/// Refonte agenda/IA (2026-07, P3) — Cache de géocodage inverse (Nominatim/OSM).
/// Nomme un point d'arrivée récurrent (ex. « Carcassonne ») sans re-taper l'API à chaque analyse.
/// Clé = "lat,lng" arrondi à 3 décimales (~110 m). `label` vide = géocodage sans résultat (mémorisé).
model GeocodeCache {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  label     String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@map("geocode_cache")
}

/// Refonte agenda/IA (2026-07, P3) — Propositions de l'agent nocturne (par flotte).
/// Une occurrence récurrente projetée : soit une SUGGESTION (`pending`) à valider, soit une
/// réservation AUTO déjà créée (`auto_applied`, `createdEventId` renseigné). L'unicité
/// (fleet, véhicule, créneau) évite de re-proposer la même occurrence à chaque nuit.
model AgendaAgentProposal {
  id               String   @id @default(uuid()) @db.Uuid
  fleetId          String   @db.Uuid
  vehicleId        String   @db.Uuid
  startAt          DateTime
  endAt            DateTime
  dayOfWeek        Int
  destinationLabel String?
  destLat          Float
  destLng          Float
  confidence       Float
  basis            String
  reasoning        String
  /// 'pending' | 'auto_applied' | 'applied' | 'dismissed'
  status           String   @default("pending")
  /// Réservation créée si appliquée / auto (VehicleEvent.id).
  createdEventId   String?  @db.Uuid
  /// 'scheduled' | 'manual' | 'incident' | 'maintenance' | 'reservation'
  origin           String   @default("scheduled")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([fleetId, vehicleId, startAt])
  @@index([fleetId, status, startAt])
  @@map("agenda_agent_proposals")
}

/// Historique des PASSAGES de l'agent d'agenda. Jusqu'ici seul `lastRunAt` survivait : on savait
/// QUAND il avait tourné, jamais ce qu'il avait fait ni pourquoi un passage n'avait rien donné.
/// Une ligne par passage RÉEL (les passages sautés parce que l'agent est désactivé, ou parce qu'un
/// autre tourne déjà, n'en produisent pas : ils n'ont rien exécuté).
/// `fleetId` dénormalisé (pas de FK), même convention que les propositions.
model AgendaAgentRun {
  id         String    @id @default(uuid()) @db.Uuid
  fleetId    String    @db.Uuid
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// 'scheduled' | 'manual'
  origin     String    @default("scheduled")
  /// 'completed' | 'error'
  status     String    @default("completed")
  /// Récurrences détectées en amont — un passage à 0 motif explique un passage à 0 proposition.
  patterns   Int       @default(0)
  created    Int       @default(0)
  proposed   Int       @default(0)
  skipped    Int       @default(0)
  /// La couche IA a-t-elle réellement produit des jugements ? (false = agent déterministe seul,
  /// parce que l'IA est coupée pour la société ou non configurée). Distingue « pas d'IA » de
  /// « IA sans effet ».
  aiUsed     Boolean   @default(false)
  durationMs Int       @default(0)
  error      String?

  @@index([fleetId, startedAt])
  @@map("agenda_agent_runs")
}

/// Refonte agenda/IA (2026-07, P4) — Lien PUBLIC de demande de réservation (façon Calendly).
/// Porte une SOCIÉTÉ FIXE (choisie à la création) : un tiers décrit un besoin (places, date,
/// destination) sur une page hors auth, l'app propose des véhicules/combinaisons DISPONIBLES,
/// et la demande atterrit en REQUESTED (file de validation). `token` public en clair (256 bits).
model ReservationBookingLink {
  id              String    @id @default(uuid()) @db.Uuid
  fleetId         String    @db.Uuid
  fleet           Fleet     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  token           String    @unique
  label           String?
  active          Boolean   @default(true)
  expiresAt       DateTime?
  /// Bornes des créneaux proposables.
  horizonDays     Int       @default(30)
  leadHours       Int       @default(2)
  openCount       Int       @default(0)
  firstOpenedAt   DateTime?
  lastOpenedAt    DateTime?
  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([fleetId, createdAt])
  @@map("reservation_booking_links")
}

/// V1.5 (Sprint I) — Etat de la sequence d'init SMS d'un tracker neuf.
/// Le SUPER_ADMIN lance le workflow depuis /admin/sms/provision/:imei,
/// le service envoie 9 SMS sequentiels avec ACK entre chaque etape.
model TrackerProvisioning {
  id              String                    @id @default(uuid()) @db.Uuid
  imei            String
  phoneNumber     String
  status          TrackerProvisioningStatus @default(PENDING)
  currentStep     Int                       @default(0)
  apn             String?
  apnUser         String?
  apnPasswd       String?
  serverIp        String?
  serverPort      Int?
  lowBatteryPhone String?
  steps           Json                      @default("[]")
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  startedBy       String                    @db.Uuid
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([imei])
  @@index([status])
  @@map("tracker_provisionings")
}

/// V1.5 (Sprint I) — Trace complete des SMS sortants/entrants pour audit.
/// Reuse du wire_logs n'est pas adapte (different vocabulaire). Retention 90j.
/// V1.5 (Sprint I) — Trace de chaque backup Postgres pour monitoring.
/// Le script `deploy/vps/backup-db.sh` ping l'endpoint /internal/backup-health
/// apres chaque execution. Si le dernier ping est > 30h, l'admin voit une
/// alerte rouge dans /admin/alerts.
model BackupRun {
  id           String   @id @default(uuid()) @db.Uuid
  status       String // 'OK' | 'FAILED'
  sizeBytes    BigInt?
  durationMs   Int?
  destination  String? // 'local' | 's3' | 'backblaze' | 'rclone:remote_name'
  filename     String?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("backup_runs")
}

/// Lead capturé via le formulaire de la landing page.
/// Stocké en DB + notification email à l'admin.
model Lead {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  email           String
  phone           String?
  company         String?
  fleetSize       String? // ex: "1-10", "11-50", "50+"
  message         String?  @db.Text
  source          String   @default("lp") // "lp" | "whatsapp" | "manual"
  status          String   @default("NEW") // "NEW" | "CONTACTED" | "CONVERTED" | "REJECTED"
  ipAddress       String?
  submissionCount Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("leads")
}

model SmsLog {
  id          String   @id @default(uuid()) @db.Uuid
  direction   String   // 'OUT' | 'IN'
  /// Modèle d'envoi (SmsTemplateId) — alimente le centre « Communications » admin.
  /// Nullable : les lignes écrites avant le catalogue n'en portent pas, et un SMS
  /// ENTRANT (direction 'IN') n'a pas de modèle.
  template    String?
  fromNumber  String?
  toNumber    String?
  body        String   @db.Text
  twilioSid   String?
  status      String?  // queued / sent / delivered / failed / received / undelivered
  errorCode   String?
  errorMessage String?
  imei        String?
  provisioningId String?  @db.Uuid
  context        Json?
  createdAt      DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([imei])
  @@index([provisioningId])
  @@index([template, createdAt])
  @@map("sms_logs")
}

/// Journal des notifications push (centre « Communications » admin). Une ligne PAR
/// APPAREIL ciblé : c'est le seul endroit où l'on voit qu'un push a réellement été
/// accepté — ou rejeté parce que l'abonnement est mort (404/410), ce qui explique
/// qu'un utilisateur « ne reçoive plus rien ». Avant, ces issues étaient calculées
/// puis jetées ; seul un compteur agrégé survivait dans le journal système.
enum PushStatus {
  SENT // accepté par le service de push du navigateur
  FAILED // erreur d'envoi (réseau, payload, VAPID)
  EXPIRED // abonnement expiré/révoqué (404/410) — l'appareil ne recevra plus rien
}

model PushLog {
  id             String     @id @default(cuid())
  template       String // PushTemplateId
  userId         String?    @db.Uuid
  subscriptionId String?    @db.Uuid
  title          String
  severity       String? // INFO | WARNING | CRITICAL
  status         PushStatus @default(SENT)
  statusCode     Int?
  errorMessage   String?
  fleetId        String?
  createdAt      DateTime   @default(now())

  @@index([template, createdAt])
  @@index([status, createdAt])
  @@index([userId])
  @@map("push_logs")
}

/// Centre de gestion des e-mails (admin) — journal des envois transactionnels.
/// Alimenté best-effort par EmailService.send() ; mis à jour par le webhook Resend.
enum EmailStatus {
  QUEUED // accepté par Resend, pas encore remis
  SENT // envoyé (mode no-op, ou avant le 1er event webhook)
  DELIVERED // delivered
  OPENED // opened (pixel)
  CLICKED // clicked
  BOUNCED // bounced (soft/hard)
  COMPLAINED // marqué spam
  FAILED // delivery_failed / erreur d'envoi
}

model EmailLog {
  id           String      @id @default(cuid())
  providerId   String?     @unique // id Resend (re_…)
  template     String // 'invitation' | 'password_reset' | 'weekly_report' | 'alert' | 'lead' | 'audio_activation' | 'audio_info'
  toAddress    String
  subject      String
  status       EmailStatus @default(SENT)
  fleetId      String? // contexte flotte si connu
  errorCode    String?
  errorMessage String?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([template, createdAt])
  @@index([status, createdAt])
  @@index([toAddress])
  @@map("email_logs")
}

model EngineControlCommand {
  id                   String        @id @default(uuid()) @db.Uuid
  trackerId            String        @db.Uuid
  tracker              Tracker       @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  action               EngineAction
  scheduledAt          DateTime?
  status               CommandStatus @default(PENDING)
  reason               String?
  requestedBy          String        @db.Uuid
  source               String        @default("MANUAL") // "MANUAL" | "SCHEDULER" | "DEVICE_OBSERVED"
  // Sprint 2 (Fiabilisation) — true si une chute d'ignition est attendable comme
  // preuve reelle de coupure (CUT d'un vehicule en marche). false pour RESTORE ou
  // CUT a l'arret => etat affiche "non verifiable" (pas de transition observable).
  confirmationExpected Boolean       @default(false)
  /// TRK-018 — canal REELLEMENT emprunte : 'TCP' | 'SMS'. Jusqu'au 2026-08-24, cette
  /// information de ROUTAGE etait ecrite dans `lastError` (« Envoyé via SMS (TCP
  /// indisponible) ») — un champ dont le nom annonce une erreur et le contenu livre autre
  /// chose. Consequence mesuree : un lecteur qui trie sur `lastError IS NOT NULL` comptait
  /// 153 echecs qui n'en sont pas. Meme defaut que `outcomeReason` (TRK-007).
  /// Les lignes anterieures sont retro-remplies depuis `lastError` par la migration ;
  /// `lastError` n'est PAS efface — detruire une donnee pour corriger un nom serait pire
  /// que le nom.
  channel              String?
  lastError            String?
  sentAt               DateTime?
  ackedAt              DateTime?
  /// TRK-018 — instant de cloture par ECHEANCE (statut SENT_UNCONFIRMED). Purement
  /// temporel : la lecon de TRK-007 est qu'une echeance conditionnee a un etat du boitier
  /// retombe dans le piege qu'elle pretend fermer.
  expiredAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([trackerId, status])
  // V1.10 (Sprint 2 perf) — vehicles.snapshot et positions.service appellent
  // findFirst({trackerId, ...}, orderBy:{createdAt:'desc'}) tres souvent pour
  // verifier le dernier CUT/RESTORE. L'index [trackerId, status] ne couvre pas
  // l'orderBy createdAt → table sort. Cet index couvre directement.
  @@index([trackerId, createdAt(sort: Desc)])
  // Review 2026-06-26 — l'audit admin GET /admin/activity/engine-commands trie
  // ORDER BY createdAt DESC SANS filtre trackerId ; l'index composite ci-dessus
  // (colonne de tête trackerId) ne couvre pas ce tri global → table sort qui se
  // dégrade avec le volume. Index global dédié.
  @@index([createdAt(sort: Desc)])
  @@map("engine_control_commands")
}

/// Sprint 4 — Écoute audio à distance (micro embarqué), LÉGALEMENT CRITIQUE.
/// AUDIT IMMUABLE (garde-fou #7) : miroir d'EngineControlCommand, mais pour l'écoute.
/// Scénario A confirmé (appel live) : l'« écoute » = le boîtier ouvre son micro et
/// l'admin APPELLE la SIM pour entendre la cabine. AUCUN clip n'est uploadé au serveur
/// → PAS de clipId. Append-only : INSERT + transitions de statut uniquement, jamais de
/// DELETE par l'usage (purge éventuelle = cron dédié, hors usage). Aucun endpoint de
/// suppression exposé.
model AudioMonitoringCommand {
  id              String             @id @default(uuid()) @db.Uuid
  trackerId       String             @db.Uuid
  tracker         Tracker            @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  vehicleId       String?            @db.Uuid // snapshot du véhicule au déclenchement
  fleetId         String             @db.Uuid // scope tenant
  status          AudioCommandStatus @default(PENDING) // PENDING|SENT|ACKNOWLEDGED|FAILED|REJECTED
  reason          String             @db.Text // MOTIF — NOT NULL (garde-fou #4)
  requestedBy     String             @db.Uuid // qui (garde-fou #7)
  requestedByRole String // rôle au déclenchement (traçabilité #3)
  requestedInEnv  String // 'development'|'production' (traçabilité du gate #3)
  source          String             @default("MANUAL")
  lastError       String?
  sentAt          DateTime?
  ackedAt         DateTime?
  // Sprint 4 — DISARM : horodatage du retour du boîtier en mode « track » (SMS
  // `tracker<password>`). Une écoute ARMÉE est SENT + disarmedAt=null ; le désarmement
  // (manuel /stop OU filet auto-disarm) pose ce timestamp. CRITIQUE : le mode monitor
  // coupe le report GPS, donc une ligne SENT+disarmedAt=null = véhicule potentiellement
  // « dark » sur la carte → c'est exactement la cible du cron AudioAutoDisarmService.
  disarmedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([fleetId, createdAt(sort: Desc)])
  @@index([vehicleId, createdAt(sort: Desc)])
  @@index([trackerId, status])
  // Sprint 4 — le cron auto-disarm scanne les écoutes ARMÉES restées ouvertes
  // (status=SENT AND disarmedAt IS NULL), filtré par sentAt. Cet index couvre la
  // requête du filet de sécurité sans full-scan de la table d'audit.
  @@index([status, disarmedAt, sentAt])
  @@map("audio_monitoring_commands")
}

enum AudioCommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  FAILED
  REJECTED
}

/// Sprint 4 — Activation de l'écoute audio PAR FLOTTE — gating à DEUX étages.
/// N1 `superAdminEnabled` (prestataire/super-admin) : la flotte est-elle ÉLIGIBLE ?
///   OFF par défaut — tant que false, RIEN n'est possible et le fleet-admin ne voit
///   même pas le « Mode assistance ».
/// N2 `assistanceEnabled` (fleet-admin) : le CONSENTEMENT « Mode assistance » de la
///   flotte. OFF par défaut, ne peut passer ON que si superAdminEnabled est true.
/// Une écoute n'est permise que si superAdminEnabled ET assistanceEnabled sont true.
/// #5 : passer assistanceEnabled à true EXIGE une attestation (le client atteste avoir
/// informé occupants/conducteurs + posé la signalétique) — tracée ici.
/// Scénario A : pas de clip → pas de retentionDays.
model FleetAudioConfig {
  id                    String    @id @default(uuid()) @db.Uuid
  fleetId               String    @unique @db.Uuid
  fleet                 Fleet     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  superAdminEnabled     Boolean   @default(false) // N1 éligibilité prestataire — OFF par défaut
  assistanceEnabled     Boolean   @default(false) // N2 consentement « Mode assistance » fleet-admin — OFF par défaut
  attestedByUserId      String?   @db.Uuid // #5 qui a attesté
  attestedAt            DateTime?
  attestationVersion    String? // version du texte d'attestation accepté
  activationEmailSentAt DateTime? // #6 trace du mail flotte
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("fleet_audio_configs")
}

model VehicleSchedule {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @unique @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  enabled   Boolean @default(false)
  timezone  String  @default("Europe/Paris")

  mondayEnabled    Boolean @default(true)
  mondayStart      String? // "08:00"
  mondayEnd        String? // "20:00"
  tuesdayEnabled   Boolean @default(true)
  tuesdayStart     String?
  tuesdayEnd       String?
  wednesdayEnabled Boolean @default(true)
  wednesdayStart   String?
  wednesdayEnd     String?
  thursdayEnabled  Boolean @default(true)
  thursdayStart    String?
  thursdayEnd      String?
  fridayEnabled    Boolean @default(true)
  fridayStart      String?
  fridayEnd        String?
  saturdayEnabled  Boolean @default(false)
  saturdayStart    String?
  saturdayEnd      String?
  sundayEnabled    Boolean @default(false)
  sundayStart      String?
  sundayEnd        String?

  // V1.5 (Sprint K) — Multi-plages par jour. Si non null, override les paires
  // start/end legacy ci-dessus. Format : [{ start: "08:00", end: "12:00" },
  // { start: "14:00", end: "18:00" }]. Max 3 plages par jour cote app (validation).
  mondaySlots    Json?
  tuesdaySlots   Json?
  wednesdaySlots Json?
  thursdaySlots  Json?
  fridaySlots    Json?
  saturdaySlots  Json?
  sundaySlots    Json?

  // V1.5 (Sprint K) — Calendrier jours feries (lib `date-holidays`).
  // 'FR' = France metropolitaine. Liste : FR / MA / BE / LU / CH (config UI).
  countryCode   String  @default("FR")
  // INCIDENT 2026-07-14 — coupe automatique les jours FÉRIÉS. OPT-IN, défaut FALSE :
  // par défaut un férié suit les horaires NORMAUX du jour (une flotte de location doit rouler
  // le 14 juillet !). Avant, le seul `countryCode` (défaut 'FR') coupait TOUT tous les fériés →
  // 29/30 véhicules cdef31 immobilisés le 14/07. À n'activer que pour une flotte qui veut
  // vraiment être à l'arrêt les fériés (les fermetures précises passent par customDates).
  cutOnHolidays Boolean @default(false)

  // V1.5 (Sprint K) — Override ponctuel pour une date specifique :
  // [{ date: "2026-12-24", slots: [{ start: "08:00", end: "16:00" }] },
  //  { date: "2026-12-25", closed: true }]
  customDates Json?

  lastEvaluatedAt    DateTime?
  lastEvaluatedState String? // "IN_WINDOW" | "OUT_OF_WINDOW"
  overrideUntil      DateTime? // scheduler ignores until this time after manual action

  history ScheduleHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_schedules")
}

/// V1.5 (Sprint K) — Trace des transitions automatiques du scheduler.
/// Une ligne par CUT/RESTORE auto, avec la raison detaillee. Sert pour la
/// timeline UI de la fiche vehicule + l'audit operateur.
model ScheduleHistory {
  id         String          @id @default(uuid()) @db.Uuid
  scheduleId String          @db.Uuid
  schedule   VehicleSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  vehicleId  String          @db.Uuid
  occurredAt DateTime        @default(now())
  action     String // 'CUT' | 'RESTORE'
  reason     String // 'OUT_OF_WINDOW' | 'IN_WINDOW_RESUME' | 'HOLIDAY' | 'CUSTOM_DATE_CLOSED' | 'CUSTOM_DATE_RANGE'
  windowDesc String? // ex: "08:00-12:00 + 14:00-18:00" ou "Ferie : 1er mai"

  @@index([scheduleId, occurredAt(sort: Desc)])
  @@index([vehicleId, occurredAt(sort: Desc)])
  @@map("schedule_history")
}

/// V1.15 — Planning d'installation de boitiers GPS pour une flotte cliente.
/// Cree/edite par le SUPER_ADMIN (operateur). Consultable par le FLEET_ADMIN
/// de la flotte une fois PUBLISHED (cf. InstallationsService.planWhereForRead).
/// Les themes de journee sont stockes en JSON `dayThemes` (cle = date ISO
/// "YYYY-MM-DD", valeur = libelle) pour eviter une 3eme table.
model InstallationPlan {
  id            String                    @id @default(uuid()) @db.Uuid
  fleetId       String                    @db.Uuid
  fleet         Fleet                     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  clientName    String
  clientAddress String?
  description   String?
  startDate     DateTime?                 @db.Date
  endDate       DateTime?                 @db.Date
  status        InstallationPlanStatus    @default(DRAFT)
  // { "2026-06-08": "Vieux diesels (coupure simple)", ... }
  dayThemes     Json?
  tasks         InstallationTask[]
  bookingLinks  InstallationBookingLink[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([fleetId])
  @@index([fleetId, status])
  @@map("installation_plans")
}

/// V1.15 — Une ligne = un vehicule a equiper. `orderIndex` (modifiable par le
/// client) + `scheduledDate` portent le "sens d'installation". A la pose
/// (completeTask), on capture imei/simNumber/notes puis on provisionne en
/// transaction le Vehicle + Tracker reels dans la flotte (vehicleId/trackerId).
/// La FK etant portee par la tache, le `onDelete: SetNull` garantit que
/// supprimer le plan/la tache n'efface jamais le vehicule/tracker operationnel.
model InstallationTask {
  id                    String                 @id @default(uuid()) @db.Uuid
  planId                String                 @db.Uuid
  plan                  InstallationPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  orderIndex            Int
  scheduledDate         DateTime?              @db.Date
  plate                 String
  brand                 String?
  model                 String?
  energy                InstallationEnergy?
  firstRegistrationDate DateTime?              @db.Date
  cutoffProcedure       String?                @db.Text
  status                InstallationTaskStatus @default(PENDING)
  installedAt           DateTime?
  imei                  String?
  simNumber             String?
  fieldNotes            String?                @db.Text
  vehicleId             String?                @db.Uuid
  vehicle               Vehicle?               @relation("InstallationTaskVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  trackerId             String?                @db.Uuid
  tracker               Tracker?               @relation("InstallationTaskTracker", fields: [trackerId], references: [id], onDelete: SetNull)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  booking InstallationBooking?

  @@index([planId, orderIndex])
  @@index([planId, scheduledDate])
  @@index([vehicleId])
  @@index([trackerId])
  @@map("installation_tasks")
}

/// Prise de RDV en ligne — LIEN PUBLIC de reservation de creneau d'installation.
///
/// Le SUPER_ADMIN genere un lien (scope flotte) a envoyer au client. Le client
/// ouvre `/book/<token>` (page publique, hors auth), choisit un creneau LIBRE et
/// depose une demande (InstallationBooking). Le `token` brut vit dans l'URL ; seul
/// son SHA-256 (`tokenHash`) est stocke (meme pattern que les invitations).
///
/// Deux modes :
///  - GENERIQUE (clientEmail null) : la page publique demande les infos du client.
///  - DIRECT CLIENT CONNU (clientEmail renseigne) : infos pre-remplies, l'email
///    n'est PAS redemande (on a deja tout ce qu'il faut pour le prevenir).
///
/// `planId` = le planning d'installation alimente par ce lien : cree a la 1re
/// validation (lazy) OU lie a un plan existant choisi a la creation. Meme lien =>
/// meme planning (les creneaux valides s'y ajoutent comme des poses).
///
/// Config creneaux reglable par lien (defaut : 2h, 08h-21h, lun-ven, horizon 6
/// semaines, delai mini 24h).
model InstallationBookingLink {
  id              String            @id @default(uuid()) @db.Uuid
  fleetId         String            @db.Uuid
  fleet           Fleet             @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  planId          String?           @db.Uuid
  plan            InstallationPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  /// Libelle interne (identifie le lien cote admin).
  label           String
  /// Token public (aleatoire, 256 bits) porte par l'URL `/book/<token>`. Lien
  /// PARTAGEABLE facon Calendly (faible enjeu) : stocke tel quel pour pouvoir
  /// re-afficher/re-copier l'URL cote admin a tout moment.
  token           String            @unique
  /// Client pre-connu (mode « lien direct »). clientEmail present => page publique sans saisie d'email.
  clientName      String?
  clientEmail     String?
  clientPhone     String?
  clientAddress   String?
  /// Config creneaux (minutes depuis minuit, fuseau Europe/Paris).
  slotMinutes     Int               @default(120)
  dayStartMinutes Int               @default(480)
  dayEndMinutes   Int               @default(1260)
  /// Jours ouvres ISO (1=lundi … 7=dimanche).
  workingDays     Int[]             @default([1, 2, 3, 4, 5])
  /// Horizon de reservation (jours) et delai minimum avant un creneau (heures).
  horizonDays     Int               @default(42)
  leadHours       Int               @default(24)
  active          Boolean           @default(true)
  /// true => le lien se ferme apres la 1re reservation confirmee.
  singleUse       Boolean           @default(false)
  expiresAt       DateTime?
  /// Observabilite : combien de fois la page publique a ete OUVERTE (chargee), +
  /// 1re et derniere ouverture. Repond a « le client a-t-il cliqué / ouvert le lien ? ».
  openCount       Int               @default(0)
  firstOpenedAt   DateTime?
  lastOpenedAt    DateTime?
  createdBy       String?           @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  bookings InstallationBooking[]
  watchers InstallationSlotWatcher[]

  @@index([fleetId])
  @@index([token])
  @@map("installation_booking_links")
}

/// Une demande de creneau deposee via un lien public. `startAt`/`endAt` = le
/// creneau choisi (instants UTC ; affichage en Europe/Paris). L'occupation du
/// planning est portee par CETTE table (une pose = un booking) : la contrainte
/// EXCLUDE (btree_gist) garantit qu'aucun creneau actif (PENDING/CONFIRMED) ne
/// chevauche un autre — anti-double-reservation RACE-PROOF (capacite 1 equipe).
/// A la validation, on cree la pose (`taskId`) dans le planning du lien.
model InstallationBooking {
  id              String                    @id @default(uuid()) @db.Uuid
  linkId          String                    @db.Uuid
  link            InstallationBookingLink   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  /// Denormalise depuis le lien (scoping/filtre sans jointure).
  fleetId         String                    @db.Uuid
  startAt         DateTime
  endAt           DateTime
  status          InstallationBookingStatus @default(PENDING)
  clientName      String
  clientEmail     String
  clientPhone     String?
  clientAddress   String?
  vehiclePlate    String?
  vehicleBrand    String?
  vehicleModel    String?
  vehicleEnergy   InstallationEnergy?
  notes           String?                   @db.Text
  /// Pose creee a la validation (SetNull : supprimer la pose n'efface pas l'historique).
  taskId          String?                   @unique @db.Uuid
  task            InstallationTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  rejectionReason String?
  confirmedAt     DateTime?
  confirmedBy     String?                   @db.Uuid
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([linkId])
  @@index([fleetId, status])
  @@index([status, startAt])
  @@map("installation_bookings")
}

/// V1.16 — Carte SIM M2M du parc WhereverSIM.
///
/// Le `Sim` local est un MIROIR du SIM cote WhereverSIM (source de verite pour
/// l'inventaire, le statut operateur, la conso data) + une couche Tracky :
///  - `fleetId`  : allocation a une societe/flotte (pose par le SUPER_ADMIN).
///  - `trackerId`: assignation physique a un boitier (1:1), posee par le
///                 FLEET_ADMIN/SUPER_ADMIN. A la pose, `msisdn` est recopie dans
///                 `Tracker.simPhoneNumber` (fallback SMS + allowlist vizyo-texto)
///                 et l'IMEI du tracker est ecrit dans `customField1` cote
///                 WhereverSIM (lien bidirectionnel visible dans leur portail).
///
/// Le sync (cron + manuel, cf. SimsSyncService) upsert par `iccid` et n'ecrase
/// QUE les champs miroir : `fleetId`/`trackerId`/`label`/`notes` sont preserves.
/// `statusId` = statusid brut WhereverSIM (2=Activated, 12=Suspended, ...).
/// Timestamps WhereverSIM recus en millisecondes -> DateTime.
model Sim {
  id                       String    @id @default(uuid()) @db.Uuid
  /// ICCID — numero de serie imprime sur les supports plastique (= valeur du code-barres).
  iccid                    String    @unique
  msisdn                   String?
  imsi                     String?
  /// IMEI du device vu par l'operateur (peut differer du tracker tant que non pose).
  imei                     String?
  // ---- Miroir WhereverSIM ----
  provider                 String    @default("wherever-sim")
  providerId               Int?
  statusId                 Int?
  statusLabel              String?
  apn                      String?
  ipAddress                String?
  networkOperator          String?
  monthlyDataVolumeBytes   BigInt?
  monthlyDataLimitBytes    BigInt?
  prevMonthDataVolumeBytes BigInt?
  inSessionSince           DateTime?
  activationAt             DateTime?
  /// `custom_field_1` cote WhereverSIM ("Device name") — on y inscrit l'IMEI du tracker.
  customField1             String?
  // ---- Couche Tracky (preservee au sync) ----
  label                    String?
  fleetId                  String?   @db.Uuid
  fleet                    Fleet?    @relation(fields: [fleetId], references: [id], onDelete: SetNull)
  trackerId                String?   @unique @db.Uuid
  tracker                  Tracker?  @relation(fields: [trackerId], references: [id], onDelete: SetNull)
  notes                    String?   @db.Text
  // ---- Bookkeeping sync ----
  externalSyncedAt         DateTime?
  /// Dernier payload brut WhereverSIM (debug + champs non modelises).
  rawProvider              Json?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([fleetId])
  @@index([statusId])
  @@map("sims")
}

/// Snapshot périodique des perfs système (monitoring VPS — espace admin).
/// Collecté toutes les 60s par MetricsCollectorService, purgé après 30j.
/// CPU/RAM/load lus via `os` côté API = niveau HÔTE (pas de mount, pas de
/// docker.sock). Lu par /admin/system (KPI + historique).
model SystemMetric {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp  DateTime @default(now())
  loadAvg1   Float
  loadAvg5   Float
  loadAvg15  Float
  cpuCount   Int
  cpuPercent Float
  memUsedMb  Float
  memTotalMb Float
  dbSizeMb   Float

  @@index([timestamp])
  @@map("system_metrics")
}

/// Sprint 6 — Snapshot de rétention des positions, calculé par DataRetentionService
/// (cron nocturne 3h30 + rafraîchissement à la demande super-admin). Une ligne
/// `scope='GLOBAL'` + une par flotte. Évite de scanner `positions` (table volumineuse)
/// à chaque ouverture des vues de suivi. `scope` = 'GLOBAL' ou un fleetId.
model RetentionSnapshot {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope           String    @unique
  fleetName       String    @default("")
  activeCount     Int       @default(0)
  archiveCount    Int       @default(0)
  toDeleteCount   Int       @default(0)
  oldestCreatedAt DateTime?
  nextDeletionAt  DateTime?
  computedAt      DateTime  @default(now())

  @@map("retention_snapshots")
}

/// Sprint user-activity — une session = une présence continue d'un user dans
/// l'app (du login/connexion jusqu'au départ/timeout). `status` reflète la
/// présence rapportée par le client (ACTIVE/IDLE/AWAY) ; OFFLINE est dérivé au
/// read-time (lastSeenAt périmé ou endedAt non nul). `fleetId` nullable car les
/// SUPER_ADMIN n'ont pas de flotte.
model UserSession {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fleetId      String?        @db.Uuid
  startedAt    DateTime       @default(now())
  endedAt      DateTime?
  lastSeenAt   DateTime       @default(now())
  status       String         @default("ACTIVE")
  currentRoute String?
  userAgent    String?
  deviceType   String?
  activities   UserActivity[]

  @@index([userId])
  @@index([fleetId])
  @@index([endedAt])
  @@index([lastSeenAt])
  @@map("user_sessions")
}

/// Sprint user-activity — une action atomique : vue de page, clic, transition de
/// présence. Volumétrie faible (petite base d'utilisateurs), purgée après 90j.
model UserActivity {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String      @db.Uuid
  session    UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String      @db.Uuid
  fleetId    String?     @db.Uuid
  /// PAGE_VIEW | CLICK | SESSION_START | SESSION_END | SESSION_RESUME | IDLE | AWAY | HEARTBEAT
  type       String
  route      String?
  routeLabel String?
  target     String?
  durationMs Int?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([fleetId])
  @@index([createdAt])
  @@index([type])
  @@map("user_activities")
}

/// ───────────────────────────────────────────────────────────────────────────
/// RGPD — consentements & permissions (cf. docs/consent/REDACTION_CONSENTEMENTS.md)
/// ───────────────────────────────────────────────────────────────────────────

/// Consentement RGPD d'un utilisateur à un document versionné (CGU / Politique de
/// confidentialité) — PREUVE de consentement (CNIL) : horodatée, IP + userAgent.
/// Une ligne par acceptation. Le gate d'accès (403 CONSENT_REQUIRED) compare la
/// version courante serveur (CONSENT_VERSION) à la dernière version acceptée.
model UserConsent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType    String // 'CGU' | 'PRIVACY'
  version    String // ex. '2026-07-16'
  accepted   Boolean  @default(true)
  acceptedAt DateTime @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, docType])
  @@map("user_consents")
}

/// Consentement traceurs d'un VISITEUR de la landing page (anonyme, non lié à un
/// User) — preuve du choix accepter/refuser avec IP, pour l'admin. Alimenté par le
/// bandeau CNIL de la LP (POST public NON gaté : enregistrer le choix est
/// strictement nécessaire).
model LpConsent {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String?
  choice     String // 'granted' | 'denied'
  categories Json? // { measure: boolean }
  ip         String?
  userAgent  String?
  page       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("lp_consents")
}

/// Permission « device » accordée par un utilisateur (notifications, localisation),
/// par appareil — traçable + révisable. Distinct de User.permissions (Json = droits
/// applicatifs).
model UserPermission {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  kind      String // 'PUSH' | 'GEOLOCATION'
  granted   Boolean
  ip        String?
  userAgent String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, deviceId, kind])
  @@index([userId])
  @@map("user_permissions")
}

/// SÉCURITÉ (2026-07-17) — Appareil « de confiance » pour la vérification e-mail
/// des NOUVEAUX appareils (2FA app, opt-in par flotte via Fleet.requireDeviceVerification).
/// Un device devient de confiance après avoir passé le code e-mail, OU
/// automatiquement s'il s'agit du tout premier appareil vu pour cet utilisateur
/// (« pas à la première connexion » — et grandfathering des appareils déjà actifs
/// au moment où une flotte active l'option). Le gate (403 DEVICE_VERIFICATION_REQUIRED)
/// laisse passer quand (userId, deviceId) existe ici. deviceId = identifiant client
/// stable (localStorage `tracky.device.id`).
model TrustedDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  label      String?
  ip         String?
  userAgent  String?
  trustedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("trusted_devices")
}

/// SÉCURITÉ (2026-07-17) — Journal des CONNEXIONS d'un utilisateur. Une ligne par
/// ouverture de session : appareil + position (géolocalisation par IP, niveau
/// ville/région, via geoip-lite — AUCUNE donnée envoyée à un tiers) + résultat
/// (anomalie détectée ? challenge demandé ? vérifié ?). Sert de socle à la
/// détection adaptative (« appareil/zone inhabituels ») ET à la carte admin des
/// lieux de connexion. ⚠️ Donnée personnelle (RGPD) : à couvrir par la politique
/// de confidentialité + rétention limitée.
model LoginEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String?
  ip           String?
  /// Position géo-IP (approx. ville/région). Null si IP privée/non localisable.
  lat          Float?
  lng          Float?
  city         String?
  region       String?
  country      String?
  userAgent    String?
  /// Signaux d'anomalie au moment de la connexion.
  newDevice    Boolean  @default(false)
  farFromUsual Boolean  @default(false)
  /// A-t-on demandé un code (challenge) ? A-t-il été validé ?
  challenged   Boolean  @default(false)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("login_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Intégration partenaire (Tracky × Maestroo) — LOT 0 : socle & interrupteur
// Spec : docs/23-integration-maestroo-phase0-spec.md
//
// Tracky est AUTORITAIRE : la copie côté partenaire n'est qu'un cache de « ai-je
// encore le droit ». Aucune donnée métier ne transite en lot 0 — ces tables ne
// portent que le lien, son consentement vivant (scopes), ses jetons et son audit.
// ─────────────────────────────────────────────────────────────────────────────

enum PartnerLinkStatus {
  ACTIVE
  /// Coupé — réversible. Par le client (choix) OU par la plateforme (impayé,
  /// cf. `suspendedByPlatform` qui est un axe DISTINCT).
  SUSPENDED
  /// TERMINAL. On ne « réactive » pas un lien révoqué : on refait un handshake
  /// complet, ce qui reconstruit le consentement. La ligne est CONSERVÉE (preuve
  /// de qui a coupé quoi et quand) et son `liveKey` passe à null pour libérer le
  /// créneau d'unicité.
  REVOKED
}

/// Lien de partage entre une flotte Tracky et une organisation partenaire.
///
/// ⚠️ UNICITÉ (décision D4) — le piège : un simple `@@unique([fleetId, partner])`
/// interdirait DÉFINITIVEMENT de se reconnecter après une révocation, puisque la
/// ligne révoquée (qu'on conserve pour l'audit) occuperait le créneau à vie.
/// D'où `liveKey` : il vaut `partner` tant que le lien est VIVANT et passe à NULL
/// à la révocation. Postgres ne fait pas conflit sur les NULL dans un index
/// unique → on obtient « au plus UN lien vivant » côté flotte ET côté organisation
/// partenaire, tout en gardant un historique illimité. C'est une garantie de BASE,
/// pas une règle de service : deux liens vivants rendraient « purger le lien »
/// ambigu, et la révocation ne voudrait plus rien dire.
model PartnerLink {
  id               String  @id @default(uuid()) @db.Uuid
  fleetId          String  @db.Uuid
  fleet            Fleet   @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  /// 'MAESTROO' — String et non enum : ajouter un partenaire ne doit pas coûter
  /// une migration d'enum.
  partner          String
  externalOrgId    String
  externalOrgName  String
  externalOrgSiret String?

  status PartnerLinkStatus @default(ACTIVE)

  /// Créneau d'unicité (cf. commentaire du modèle). INVARIANT maintenu par le
  /// service : `liveKey = partner` si status != REVOKED, `null` sinon.
  liveKey String?

  /// D8 — 'COMP' (offert) | 'ACTIVE' (payant) | 'NONE'. AUCUN paiement n'est
  /// branché en lot 0 : le point de contrôle existe pour que passer au payant
  /// soit un changement d'état et non une refonte. Patron repris d'AiSubscription.
  /// ⚠️ Axe INDÉPENDANT de `status` : un client peut être COMP (offert) ET
  /// SUSPENDED (impayé sur son abonnement principal).
  billingStatus String @default("COMP")

  /// ⚠️ Suspension PLATEFORME (impayé) — DISTINCTE de `status`. Tant qu'elle est
  /// levée, le client ne peut NI réactiver, NI refaire un handshake sur cette
  /// flotte. Sans ce refus au niveau du handshake, le client révoque, recommence,
  /// et le levier commercial ne vaut rien. Seul un SUPER_ADMIN peut la lever.
  suspendedByPlatform Boolean @default(false)
  suspendedReason     String?

  /// Scopes ACTIFS (PartnerScope[] — cf. packages/shared/src/partner/scopes.ts).
  /// ÉTAT VIVANT vérifié à CHAQUE requête partenaire, pas un consentement figé.
  /// Une liste vide veut dire « plus rien n'est partagé », jamais « applique les
  /// défauts ».
  scopes Json @default("[]")

  /// Secret du lien, remis UNE SEULE FOIS au partenaire, stocké HASHÉ.
  /// Propre à ce lien : sa compromission n'expose pas la plateforme.
  secretHash      String
  secretRotatedAt DateTime?

  createdByUserId  String?   @db.Uuid
  approvedByUserId String?   @db.Uuid
  approvedAt       DateTime?
  /// Dernier appel partenaire authentifié — alimente « dernière activité ».
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  events PartnerLinkEvent[]
  tokens PartnerAccessToken[]
  outbox PartnerOutboxEvent[]

  /// Au plus UN lien vivant par (flotte, partenaire).
  @@unique([fleetId, liveKey])
  /// Au plus UN lien vivant par (organisation partenaire, partenaire) : deux
  /// flottes ne peuvent pas alimenter la même organisation Maestroo.
  @@unique([externalOrgId, liveKey])
  @@index([fleetId])
  @@index([status])
  @@map("partner_links")
}

/// Journal IMMUABLE du lien — jamais purgé. C'est la preuve de qui a coupé quoi,
/// quand, et sur quel scope : un acte à conséquence financière pour le client.
model PartnerLinkEvent {
  id        String      @id @default(uuid()) @db.Uuid
  linkId    String      @db.Uuid
  link      PartnerLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  /// 'created' | 'approved' | 'scope_enabled' | 'scope_disabled' | 'suspended'
  /// | 'resumed' | 'platform_suspended' | 'platform_resumed' | 'revoked'
  /// | 'secret_rotated' | 'billing_changed'
  action    String
  /// 'USER' | 'PLATFORM' | 'PARTNER' | 'SYSTEM'
  actorType String
  actorId   String?     @db.Uuid
  /// Renseigné pour les actions de scope (révocation partielle).
  scope     String?
  detail    String?
  createdAt DateTime    @default(now())

  @@index([linkId, createdAt(sort: Desc)])
  @@map("partner_link_events")
}

/// Jeton d'accès OPAQUE (bail, 10 min). Volontairement pas un JWT : un JWT reste
/// valide jusqu'à son expiration, donc jusqu'à 10 min APRÈS la coupure. Ici, la
/// révocation supprime les clés Redis et marque ces lignes → effet en
/// millisecondes. Le TTL devient le filet de sécurité, pas le chemin normal.
/// Redis est le chemin chaud ; cette table est la source de vérité.
model PartnerAccessToken {
  id        String      @id @default(uuid()) @db.Uuid
  linkId    String      @db.Uuid
  link      PartnerLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  /// SHA-256 du jeton — le jeton en clair n'est jamais persisté.
  tokenHash String      @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([linkId, expiresAt])
  @@map("partner_access_tokens")
}

/// Outbox des webhooks sortants. Un webhook de révocation PERDU est une
/// révocation perdue : on persiste avant d'émettre, et un cron rejoue les
/// non-délivrés. `id` sert de clé d'idempotence au receveur.
model PartnerOutboxEvent {
  id            String      @id @default(uuid()) @db.Uuid
  linkId        String      @db.Uuid
  link          PartnerLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  /// 'link.revoked' | 'link.suspended' | 'link.resumed' | 'scope.revoked'
  /// | 'scope.granted'
  type          String
  payload       Json
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  deliveredAt   DateTime?
  lastError     String?
  createdAt     DateTime    @default(now())

  /// Index de balayage du cron : les non-délivrés dont l'heure est venue.
  @@index([deliveredAt, nextAttemptAt])
  @@index([linkId])
  @@map("partner_outbox_events")
}

/// « Prévenez-moi si un créneau se libère » — la sortie n° 3 de la page publique.
///
/// Sans elle, un client qui ne trouve aucun créneau qui lui convient est dans un
/// cul-de-sac : il referme l'onglet et personne ne le sait.
///
/// ┌───────────────────────────────────────────────────────────────────────────┐
/// │ CE MODÈLE COLLECTE UNE DONNÉE PERSONNELLE SUR UNE PAGE PUBLIQUE            │
/// │                                                                            │
/// │ Donc il porte sa propre limite : `expiresAt`, purgé par le cron. On ne     │
/// │ garde pas une adresse « au cas où » — la finalité s'épuise, la donnée      │
/// │ part avec elle. Rien d'autre n'est demandé : ni nom, ni téléphone, ni      │
/// │ adresse. Le strict nécessaire pour envoyer UN e-mail.                      │
/// │                                                                            │
/// │ La DURÉE — 90 jours — est une décision du client, prise le 2026-08-16 (cf. │
/// │ `SLOT_WATCH_RETENTION_DAYS`). Ne pas l'allonger sans nouvelle décision :   │
/// │ c'est elle qui rend la collecte proportionnée.                             │
/// └───────────────────────────────────────────────────────────────────────────┘
model InstallationSlotWatcher {
  id        String                  @id @default(uuid()) @db.Uuid
  linkId    String                  @db.Uuid
  link      InstallationBookingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime                @default(now())
  /// Prévenu une fois → la finalité est remplie, la ligne devient purgeable.
  notifiedAt DateTime?
  /// Limite dure de conservation. Passée cette date, la ligne est supprimée
  /// qu'elle ait servi ou non.
  expiresAt DateTime

  @@unique([linkId, email])
  @@index([expiresAt])
  @@map("installation_slot_watchers")
}

/// Invitation à consentir, envoyée par e-mail au fleet-admin.
///
/// ⚠️ `token` N'EST PAS UNE AUTORISATION. Il identifie une invitation, rien de
/// plus : le destinataire doit quand même se connecter et porter la permission
/// `integrations_manage`. Ne jamais lui faire ouvrir un accès — le jour où
/// quelqu'un le prendra pour un jeton d'authentification, un e-mail transféré
/// deviendra une faille.
///
/// Sert aussi de PREUVE DE CONSENTEMENT (RGPD) : qui a été sollicité, quand, qui
/// a cliqué, depuis quelle IP, et ce qui a été accepté.
model PartnerInvitation {
  id          String @id @default(uuid()) @db.Uuid
  fleetId     String @db.Uuid
  fleet       Fleet  @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  partner     String
  /// Code émis par le partenaire, recopié dans le lien profond.
  /// ⚠️ Non unique à dessein : une invitation peut être renvoyée sur le même code.
  pairingCode String
  token       String @unique
  email       String

  sentByUserId String?  @db.Uuid
  sentAt       DateTime @default(now())
  /// Au-delà, le lien ne redirige plus : un lien de consentement qui traîne des
  /// mois dans une boîte mail n'a plus rien à voir avec une décision éclairée.
  expiresAt    DateTime

  /// Premier clic — c'est LUI qui fait foi (« le client a-t-il ouvert ? »).
  /// Un pixel de suivi mesurerait l'affichage, pas l'intention, et la moitié des
  /// clients mail le bloquent.
  openedAt      DateTime?
  lastOpenedAt  DateTime?
  openCount     Int       @default(0)
  openIp        String?
  openUserAgent String?

  acceptedAt       DateTime?
  acceptedByUserId String?   @db.Uuid
  /// Catégories effectivement acceptées — l'état vivant est dans PartnerLink.scopes,
  /// ceci fige ce qui a été consenti CE JOUR-LÀ.
  acceptedScopes   Json      @default("[]")
  linkId           String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Recherche du garde anti-transfert : « ce code est-il déjà promis à une flotte ? »
  @@index([partner, pairingCode])
  @@index([fleetId, sentAt(sort: Desc)])
  @@map("partner_invitations")
}

/// Préférences de notification PUSH, par utilisateur.
///
/// Une ligne PAR UTILISATEUR (pas par type) : les types désactivés sont stockés dans
/// `mutedTypes`. Ce choix évite d'écrire 24 lignes par utilisateur (une par AlertType) et
/// de devoir migrer la table à chaque nouveau type d'alerte — un type inconnu est
/// simplement absent de `mutedTypes`, donc actif.
///
/// ⚠️ ABSENCE DE LIGNE = état par défaut, jamais « tout coupé ». Un utilisateur qui n'a
/// jamais ouvert ses réglages doit recevoir quelque chose d'utile, pas le silence : le
/// défaut est porté par le code (`DEFAULT_MIN_SEVERITY`), pas par la base.
model NotificationPreference {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Interrupteur MAÎTRE. `false` = plus aucun push, quels que soient les autres réglages.
  /// Volontairement distinct d'un `mutedTypes` contenant tous les types : l'utilisateur
  /// qui coupe tout puis réactive doit retrouver sa configuration fine intacte.
  pushEnabled Boolean @default(true)

  /// Seuil de sévérité : on n'envoie que les alertes de sévérité >= à ce niveau.
  /// Le parc produit ~580 alertes WARNING par semaine (excès de vitesse) : sans ce
  /// seuil, activer le push revient à recevoir ~80 notifications par jour.
  minSeverity AlertSeverity @default(CRITICAL)

  /// Types d'alerte explicitement coupés (valeurs de `AlertType`). Stocké en texte et
  /// non en enum[] pour qu'un type retiré du code ne casse pas la lecture des lignes
  /// existantes.
  mutedTypes String[] @default([])

  /// Cet utilisateur fait-il partie des DESTINATAIRES des alertes de sa flotte ?
  ///
  /// ⚠️ NULLABLE À DESSEIN — `null` signifie « dérive du rôle », pas « non ».
  /// Avant ce champ, la liste des destinataires était CODÉE EN DUR : tous les
  /// FLEET_ADMIN de la flotte, personne d'autre. Constat prod 2026-07-28 : la flotte
  /// cdef31 compte 6 utilisateurs actifs et 1 seul recevait quoi que ce soit — les
  /// managers, le veilleur de nuit et les lecteurs n'avaient aucun moyen d'être
  /// prévenus, ni eux ni leur administrateur.
  ///
  /// Le `null` garantit que l'ouverture de ce réglage ne change RIEN tant que
  /// personne n'y touche : le défaut par rôle reproduit exactement l'ancien
  /// comportement. On rend configurable sans rien déplacer sous les pieds.
  receivesFleetAlerts Boolean?

  /// Catégories de notification explicitement coupées ('MAINTENANCE', 'REPORT'…).
  ///
  /// Distinct de `mutedTypes`, qui ne concerne QUE les types d'alerte véhicule. Une
  /// notification n'est pas toujours une alerte : un rappel d'entretien ou un rapport
  /// hebdomadaire n'a ni type d'alerte ni sévérité, et devait pourtant pouvoir se couper.
  /// Sans cette colonne, la seule façon de ne plus recevoir un rappel était de couper
  /// TOUT le push.
  mutedCategories String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

/// Issue d'une notification, PAR DESTINATAIRE — la matière du centre de notifications.
///
/// Aujourd'hui, seuls des agrégats existent (`system_activity_logs`, catégorie PUSH) :
/// « 3 envoyés, 1 échec ». Impossible de répondre à « qui a reçu quoi, quand, et pourquoi
/// untel n'a rien reçu ». Or c'est précisément ce silence qui a laissé le push mort trois
/// mois sans que personne ne le voie.
///
/// ⚠️ On journalise AUSSI les non-envois (`SUPPRESSED`, `GROUPED`) avec leur raison. Une
/// notification volontairement retenue doit être aussi visible qu'une notification partie —
/// sinon on remplace un silence invisible par un autre.
model NotificationDelivery {
  id String @id @default(uuid()) @db.Uuid

  /// Alerte d'origine. NULL pour un envoi de test ou une notification hors alerte.
  alertId   String? @db.Uuid
  /// Dénormalisés : permettent de filtrer/compter sans jointure, et surtout de garder une
  /// trace lisible même après purge de l'alerte d'origine (rétention plus courte).
  alertType String?
  severity  String?

  userId  String  @db.Uuid
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Flotte de l'alerte. NULL pour un envoi cross-flotte à un SUPER_ADMIN.
  fleetId String? @db.Uuid

  /// Nature de la notification : 'ALERT', 'MAINTENANCE', 'REPORT'…
  ///
  /// Défaut 'ALERT' : toutes les lignes écrites avant l'ouverture du socle générique
  /// étaient des alertes véhicule, et le rester est exact — pas une approximation.
  category String @default("ALERT")

  /// Sujet concerné, pour l'anti-spam et la lecture : véhicule pour une alerte, plan
  /// d'entretien pour un rappel, etc.
  ///
  /// ⚠️ Existe AUSSI pour une raison de performance : sans elle, le contrôle anti-spam
  /// devait faire une 2ᵉ requête sur `alerts` pour retrouver le véhicule d'une ligne de
  /// journal — le seul lien étant `alertId`. La clé rend le cooldown auto-suffisant.
  subjectKey String?

  /// 'WEB_PUSH' aujourd'hui ; le modèle est prêt pour EMAIL/WHATSAPP/SMS.
  channel String

  /// SENT       — au moins un appareil a accepté.
  /// FAILED     — tous les appareils ont échoué (ou aucun appareil abonné).
  /// SUPPRESSED — volontairement non envoyée (préférence, seuil, périmètre de déploiement).
  /// GROUPED    — repliée dans un envoi précédent (anti-spam), avec le compte.
  status String

  /// Raison lisible, TOUJOURS renseignée quand ce n'est pas SENT. C'est la colonne qui
  /// transforme « je n'ai rien reçu » en diagnostic immédiat.
  reason String?

  /// Contenu réellement présenté, pour que l'admin voie ce que l'utilisateur a vu.
  title String?
  body  String?

  /// Appareils ciblés / ayant accepté / en échec.
  deviceCount Int @default(0)
  sentCount   Int @default(0)
  failedCount Int @default(0)

  /// Nombre d'événements repliés dans cet envoi (anti-spam). 0 = envoi simple.
  groupedCount Int @default(0)

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([fleetId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([alertId])
  @@index([createdAt])
  /// Cooldown : « ce destinataire a-t-il déjà reçu CE sujet récemment ? »
  @@index([userId, category, subjectKey, createdAt(sort: Desc)])
  @@map("notification_deliveries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Assistance IA (2026-08)
// ─────────────────────────────────────────────────────────────────────────────

/// Une conversation d'assistance : la question d'un utilisateur, la réponse de l'agent, et
/// tout ce qui a servi à la produire.
///
/// TOUT est conservé, et c'est le point : l'espace admin doit pouvoir relire une réponse des
/// mois plus tard, la corriger, et recontacter la personne. Une assistance dont les échanges
/// s'effacent ne permet ni de mesurer la qualité de l'agent, ni de réparer ce qu'il a raté.
model AssistanceConversation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Auteur de la demande. JAMAIS null : une assistance sans demandeur n'a aucun périmètre de
  /// lecture, donc aucun moyen d'être cloisonnée.
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Société du demandeur AU MOMENT de la demande — figée volontairement. Un utilisateur peut
  /// changer de société ; l'archive doit rester lisible sous le périmètre qui était le sien,
  /// sinon on relit une réponse en croyant qu'elle portait sur d'autres données.
  fleetId String? @db.Uuid

  /// Titre déduit de la première question (liste admin).
  title String

  /// open | closed | escalated
  status String @default("open")

  /// Gravité estimée par l'agent : LOW | MEDIUM | HIGH | CRITICAL. Null tant qu'aucune
  /// synthèse n'a été produite — `LOW` par défaut affirmerait « anodin » sans l'avoir jugé.
  severity String?

  /// Synthèse structurée de fin de conversation (résumé, problème, résolution, actions).
  summary Json?

  /// Un humain a repris la main (escalade IA, ou demande de rappel urgent).
  escalatedAt     DateTime?
  escalatedReason String?

  /// Relecture admin : qui a relu, quand, et la correction éventuelle à retenir.
  reviewedAt       DateTime?
  reviewedByUserId String?   @db.Uuid
  reviewNote       String?

  messages AssistanceMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([fleetId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("assistance_conversations")
}

/// Un message d'une conversation d'assistance.
model AssistanceMessage {
  id             String                 @id @default(uuid()) @db.Uuid
  createdAt      DateTime               @default(now())
  conversationId String                 @db.Uuid
  conversation   AssistanceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// user | assistant | admin
  role    String
  content String

  /// Modèle ayant produit la réponse. Null pour un message humain (utilisateur ou conseiller).
  model     String?
  costUsd   Float   @default(0)
  latencyMs Int?

  /// QUELLES données ont réellement été montrées au modèle pour produire cette réponse.
  ///
  /// C'est la trace d'audit du cloisonnement, et elle n'est pas décorative : l'agent lit des
  /// données réelles (activité, erreurs, trajets). Le jour où quelqu'un demande « qu'est-ce que
  /// l'IA a vu de mon compte ? », la réponse doit être lisible en base, pas reconstituée de
  /// mémoire. Ne contient que les CLÉS des lots consultés et leur volume — jamais les données
  /// elles-mêmes, qui seraient alors dupliquées hors de leur table d'origine.
  contextUsed Json?

  @@index([conversationId, createdAt])
  @@map("assistance_messages")
}

/// Ce qu'on a ENVOYÉ à un modèle, et ce qu'il a RENDU — le couple, pas seulement le résultat.
///
/// ── Pourquoi cette table ────────────────────────────────────────────────────────────
/// L'application conservait déjà les RÉSULTATS : le récit d'un trajet, le contenu d'un rapport
/// d'activité, les propositions d'agenda. Mais jamais l'ENTRÉE. Or on n'améliore pas un agent en
/// relisant ses bonnes réponses : on l'améliore en retrouvant les payloads qui ont produit une
/// réponse fausse, vide ou hors sujet. Sans l'entrée, un échec n'est pas reproductible, et la
/// seule correction possible reste l'intuition.
///
/// ⚠️ CETTE TABLE DUPLIQUE DE LA DONNÉE MÉTIER hors de sa table d'origine — activité réelle
///    d'utilisateurs, trajets, erreurs. C'est le prix à payer pour pouvoir rejouer un cas, mais ça
///    en fait une seconde copie à protéger ET à purger. D'où `fleetId` (purger avec la société),
///    un plafond par action, et des payloads bornés.
model AiAgentTrace {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  /// Même vocabulaire que `ai_usage_logs.action` — les deux tables se lisent ensemble.
  action String
  /// `api` (crédits facturés) ou `local` (agent sur le poste). Cf. `AiExecutor`.
  executor String  @default("api")
  model    String?
  /// Société concernée, quand l'appel en vise une. Sert au périmètre ET à la purge.
  fleetId  String? @db.Uuid

  /// Ce qui a été envoyé au modèle. Borné : au-delà, tronqué et MARQUÉ comme tel.
  input Json
  /// Ce qu'il a rendu, brut, avant tout assainissement. `null` si l'appel a échoué.
  output Json?
  /// Message d'échec, quand il n'y a pas de sortie à conserver.
  error     String?
  latencyMs Int?

  /// `concluant` (le résultat a été retenu) ou `rejete` (écarté). C'est CE champ qui a de la
  /// valeur : il sépare les cas à rejouer du bruit.
  verdict String
  /// Pourquoi rejeté, en clair. Vide sur un concluant.
  verdictNote String?

  @@index([action, createdAt(sort: Desc)])
  @@index([verdict, createdAt(sort: Desc)])
  @@index([fleetId])
  @@map("ai_agent_traces")
}

/// Diagnostic de ZONE MORTE — plusieurs véhicules perdent le signal au même endroit.
///
/// ── Pourquoi une table, et pas le champ `note` des zones existantes ─────────────────
/// Une zone de perte est apprise PAR VÉHICULE : le même parking produit une ligne par véhicule
/// qui y entre. Le diagnostic, lui, porte sur le LIEU — il agrège plusieurs zones et plusieurs
/// véhicules. Il n'a donc pas de ligne d'accueil naturelle. Et `GpsDeadZone.note` appartient à la
/// revue humaine : l'écraser chaque nuit effacerait le travail d'un opérateur.
///
/// Le diagnostic de BOÎTIER, lui, ne vient PAS ici : un boîtier défaillant demande une action
/// datée, et il part au centre d'alerte, canal déjà surveillé.
model GpsZoneDiagnostic {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fleetId   String   @db.Uuid

  /// Clé STABLE du lieu (société + coordonnées arrondies). C'est elle qui empêche l'agent de
  /// recréer le même diagnostic chaque nuit : il met à jour la ligne existante.
  cle String @unique

  lat        Float
  lng        Float
  placeLabel String?

  /// Plaques concernées, et volume observé. Dénormalisés à dessein : un diagnostic doit rester
  /// lisible même si un véhicule est archivé entre-temps.
  vehicules  String[]
  episodes   Int      @default(0)
  etalementM Int      @default(0)

  /// Ce qu'on affirme, et ce qu'il faut faire — rédigés par l'agent, en français.
  constat        String
  recommandation String

  /// Qualification humaine. Tant qu'elle est nulle, le diagnostic attend une décision.
  traiteAt        DateTime?
  traiteParUserId String?   @db.Uuid
  note            String?

  @@index([fleetId, createdAt(sort: Desc)])
  @@index([traiteAt])
  @@map("gps_zone_diagnostics")
}

/// PASSAGE d'un agent qui tourne sur le poste, et non sur ce serveur.
///
/// ── Le trou que cette table bouche ─────────────────────────────────────────────────
/// Les deux premiers agents locaux déduisent leur état du travail qu'ils ont ÉCRIT : la dernière
/// limite de vitesse résolue, le dernier récit rédigé. C'était juste pour eux — ils ont toujours
/// du travail en attente, donc une date qui n'avance plus signifie vraiment une panne.
///
/// L'agent de qualité GPS, lui, peut légitimement ne RIEN écrire d'une nuit : s'il ne trouve
/// aucune zone partagée par deux véhicules et aucun boîtier dispersé, il n'a rien à signaler, et
/// c'est le résultat normal. Déduire sa santé de sa production annoncerait donc « agent à
/// l'arrêt » précisément quand tout va bien — le contraire de ce qu'une supervision doit faire.
///
/// D'où la séparation, qui est tout l'intérêt de cette table :
///   « a-t-il TOURNÉ ? »   -> cette table, une ligne par passage, même vide.
///   « a-t-il TROUVÉ ? »   -> ses écritures métier, inchangées.
///
/// ⚠️ Un simple signal de démarrage mentirait de la même façon que le ferait un `psql` qui sort
/// en 0 sur une erreur SQL : la ligne n'est écrite qu'à la FIN du passage, avec son issue.
model PassageAgentLocal {
  id String @id @default(uuid()) @db.Uuid

  /// Identifiant de l'agent, aligné sur l'`id` du catalogue des tâches de fond
  /// (`agent-qualite-gps`, `agent-recit-trajet`, …). C'est la clé de jointure entre le poste et
  /// l'écran de supervision.
  agent String

  demarreA DateTime
  finiA    DateTime @default(now())
  dureeMs  Int      @default(0)

  /// Issue réelle du passage. `false` sur une sortie en erreur — un agent qui échoue doit se voir.
  succes Boolean

  /// Ce que le passage a produit, en une phrase lisible sans contexte. Vaut aussi pour le rien :
  /// « aucune zone à signaler » est une information, pas une absence d'information.
  resume String

  /// Message d'échec quand `succes` est faux. Tronqué à la source.
  erreur String?

  @@index([agent, finiA(sort: Desc)])
  @@map("passages_agents_locaux")
}

/// File de travaux IA executes sur le POSTE du proprietaire (design/C1-TRAVAUX-IA-LOCAUX.md).
/// Le serveur PREPARE (payload complet : prompt, schema, donnees) et CONSOMME (validation +
/// persistance par ses fonctions existantes) ; l'agent du poste n'est qu'un courrier qui
/// remplit `resultat`. Aucune logique metier ne quitte le serveur.
model TravailIaLocal {
  id String @id @default(uuid()) @db.Uuid

  /// 'rapport-activite' | 'analyse-lieu' | futur type — l'agent n'en connait aucun.
  type String

  /// a-faire -> pris -> fait -> (consomme = ligne effacee) ; echec apres 3 tentatives.
  statut String @default("a-faire")

  /// { system, schema, userPayload, maxTokens } : tout ce qu'il faut pour l'appel modele.
  payload  Json
  /// Ce que le consommateur serveur doit savoir pour persister (ids, periode, titre...).
  contexte Json

  resultat   Json?
  erreur     String?
  tentatives Int     @default(0)

  creeA DateTime  @default(now())
  prisA DateTime?
  finiA DateTime?

  @@index([statut, type])
  @@map("travaux_ia_locaux")
}

/// Rapport hebdomadaire (2026-09) — réglage PAR SOCIÉTÉ de l'envoi automatique du rapport PDF.
///
/// Avant : un cron unique (lundi 08:00 UTC), un destinataire (`Fleet.weeklyReportEmail` ou le
/// premier admin), un contenu figé, et un PDF annoncé « en pièce jointe » jamais joint. Rien
/// de réglable, rien de visible par le client. Une société SANS ligne ici garde l'ancien
/// comportement (lundi 08:00 Paris, administrateurs actifs, toutes les sections) — cf.
/// ReportScheduleService.effective().
model FleetReportSchedule {
  fleetId         String    @id @db.Uuid
  fleet           Fleet     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  enabled         Boolean   @default(true)
  /// Jour d'envoi, 1 = lundi … 7 = dimanche (Europe/Paris).
  weekday         Int       @default(1)
  /// Heure d'envoi, 0-23 (Europe/Paris).
  hour            Int       @default(8)
  /// Destinataires choisis. Vide = les administrateurs actifs de la société.
  recipients      String[]  @default([])
  /// Sections du PDF : 'kpi' | 'alerts' | 'topVehicles' | 'trips' (mêmes que l'export à la main).
  sections        String[]  @default(["kpi", "alerts", "topVehicles", "trips"])
  /// Périmètre véhicules. Vide = tous les véhicules de la société.
  vehicleIds      String[]  @default([])
  maxTrips        Int       @default(30)
  topN            Int       @default(10)
  /// Dernier passage (cron OU envoi manuel) et son issue — lus par la sonde des tâches.
  lastRunAt       DateTime?
  lastStatus      String?
  lastError       String?
  updatedAt       DateTime  @updatedAt
  updatedByUserId String?   @db.Uuid

  @@map("fleet_report_schedules")
}

/// Journal des envois du rapport hebdomadaire — un enregistrement par passage, réussi ou non,
/// pour que la société ET l'admin voient ce qui est parti, à qui, et pourquoi ça n'est pas parti.
model FleetReportDispatch {
  id                String   @id @default(uuid()) @db.Uuid
  fleetId           String   @db.Uuid
  fleet             Fleet    @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  /// 'cron' | 'manual'
  trigger           String
  /// 'SENT' | 'FAILED' | 'SKIPPED'
  status            String
  /// Période couverte, bornes API (fin exclusive = lendemain minuit Paris).
  periodFrom        DateTime
  periodTo          DateTime
  recipients        String[] @default([])
  tripsCount        Int      @default(0)
  pdfBytes          Int      @default(0)
  error             String?
  requestedByUserId String?  @db.Uuid
  createdAt         DateTime @default(now())

  @@index([fleetId, createdAt])
  @@index([createdAt])
  @@map("fleet_report_dispatches")
}
