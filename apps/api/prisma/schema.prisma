generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto, uuidOssp(map: "uuid-ossp")]
}

enum UserRole {
  SUPER_ADMIN
  FLEET_ADMIN
  FLEET_MANAGER
  VIEWER
}

enum TrackerStatus {
  ONLINE
  OFFLINE
  IDLE
}

enum GeofenceType {
  CIRCLE
  POLYGON
  // V1.5 (Sprint N) — corridor lineaire le long d'un trajet (polyligne avec
  // largeur en metres). Alerte si le vehicule s'eloigne du corridor.
  CORRIDOR
}

enum GeofenceRule {
  ENTER
  EXIT
  BOTH
}

enum AlertType {
  SOS
  POWER_CUT
  ACCIDENT
  COLLISION
  LOW_BATTERY
  OVERSPEED
  GEOFENCE_ENTER
  GEOFENCE_EXIT
  MOVEMENT_IDLE
  HARSH_BRAKING
  HARSH_ACCELERATION
  HARSH_TURN
  BONNET
  DOOR
  VIBRATION
  TOW
  TAMPER
  FATIGUE
  ILLEGAL_IGNITION
  GPS_LOST
  IDLE_TIME
  SURVEILLANCE_TRIGGERED
  UNKNOWN
}

enum SurveillanceMode {
  OFF
  FULL_TIME
  SCHEDULED
}

enum SurveillanceSensitivity {
  LOW
  MEDIUM
  HIGH
}

enum SurveillanceEventTrigger {
  VIBRATION
  MOVEMENT
  DOOR
}

enum SurveillanceEventStatus {
  PENDING
  ACKNOWLEDGED
  CONFIRMED_THEFT
  FALSE_ALARM
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum VehicleType {
  CAR
  TRUCK
  VAN
  MOTORCYCLE
  BICYCLE
  BUS
  CONSTRUCTION
  OTHER
}

enum AccessType {
  ALL
  GROUP
  VEHICLE
}

enum EngineAction {
  CUT
  RESTORE
}

enum CommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  FAILED
  REJECTED_SPEED
}

model Fleet {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  clientId  String?
  // V1.5 (Sprint H1) — sampling adaptatif des positions cote serveur.
  // true = positions redondantes (vehicule arrete) ne sont pas persistees pour
  // economiser le stockage. UX-first : le broadcast WS reste integral.
  // Opt-out par fleet pour les contrats imposant un tracage continu (legal).
  adaptiveSamplingEnabled Boolean @default(true)
  // V1.5 (Sprint H3) — pilotage adaptatif du fix interval boitier (fix030s en
  // mouvement, fix120s/300s a l'arret). Reduit la conso batterie + data SIM.
  // Opt-out pour les contrats imposant le mode 30s permanent.
  adaptiveFixModeEnabled  Boolean @default(true)
  // V1.5 (Sprint L) — Tarif litre essence pour estimer la consommation dans
  // les rapports. Default 1.85 EUR/L (moyenne FR fin 2025). Override par fleet.
  fuelPriceEurL           Float   @default(1.85)
  // V1.5 (Sprint L) — Email de contact pour le rapport hebdomadaire automatique
  // envoye chaque lundi 08:00 UTC. Si null, fallback sur l'email du premier
  // FLEET_ADMIN de la fleet. Si vide explicite ('-'), on n'envoie pas le rapport.
  weeklyReportEmail       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  vehicles      Vehicle[]
  geofences     Geofence[]
  alerts        Alert[]
  vehicleGroups VehicleGroup[]
  drivers       Driver[]
  surveillanceProfiles SurveillanceProfile[]
  surveillanceEvents   SurveillanceEvent[]

  @@map("fleets")
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  authUserId String   @unique
  email      String   @unique
  firstName  String?
  lastName   String?
  role        UserRole @default(VIEWER)
  permissions Json?
  isActive    Boolean  @default(true)
  fleetId    String?  @db.Uuid
  fleet      Fleet?   @relation(fields: [fleetId], references: [id], onDelete: SetNull)
  // V1.5 (Sprint J) — onboarding + profil enrichi.
  // phone : E.164 (+33612345678), utilise pour les notifications WhatsApp Sprint M.
  // onboardingCompletedAt : null = wizard non termine, declenche au premier login.
  // escalationContactUserId : si une alerte CRITICAL n'est pas ack en 10min,
  //   on notifie ce user (Sprint M).
  phone                   String?
  onboardingCompletedAt   DateTime?
  /// V1.12 — preferences UI per-user (JSON extensible).
  /// Aujourd'hui : `{ uiMode: 'tracky' | 'baanool' }`. Default null = mode Tracky
  /// (UI riche dashboard + sidebar). Mode 'baanool' = layout simplifie inspire
  /// de l'app Baanool : sidebar cachee, post-login direct sur /map, navigation
  /// via burger uniquement. Toutes les pages restent accessibles.
  preferences             Json?
  escalationContactUserId String?  @db.Uuid
  escalationContact       User?    @relation("UserEscalation", fields: [escalationContactUserId], references: [id], onDelete: SetNull)
  escalatedTo             User[]   @relation("UserEscalation")
  acknowledgedAlerts Alert[]           @relation("AlertAcknowledgedBy")
  trackerCommands    TrackerCommand[]
  vehicleAccess      UserVehicleAccess[]
  invitationsSent    Invitation[]      @relation("InvitationCreatedBy")
  tripNotesAuthored  Trip[]            @relation("TripNotesAuthor")
  /// Phase 3 (futur) : si ce User est lie a un compte conducteur (driver login).
  /// Aujourd'hui null pour tous les Users existants. Cf. Driver.userId.
  driverProfile      Driver?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fleetId])
  @@map("users")
}

/// V1.5 (Sprint M) — Subscription Web Push d'un utilisateur (1 abonnement
/// par device/browser). Une ligne = un endpoint push valide.
model PushSubscription {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?
  /// Identifiant stable du device cote client (UUID genere une fois, stocke en
  /// localStorage). Permet de dedupliquer parfaitement une re-inscription apres
  /// reinstallation PWA ou rotation d'endpoint : on upsert sur (userId, deviceId)
  /// au lieu de creer une nouvelle ligne a chaque endpoint regenere. Optionnel
  /// pour la backward-compat (les subs existantes restent valides).
  deviceId    String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, deviceId])
  @@map("push_subscriptions")
}

/// V1.5 (Sprint M) — Regles de notification personnalisables par fleet/vehicule.
/// Si vehicleId est null, la regle s'applique a tous les vehicules de la fleet.
/// Si alertType est '*', la regle s'applique a tous les types d'alerte.
/// channels = ['IN_APP', 'WEB_PUSH', 'EMAIL', 'WHATSAPP'] — l'in-app est
/// toujours actif (legacy ALERT_NEW WS) ; cette table active push/email/whatsapp.
model AlertRule {
  id           String   @id @default(uuid()) @db.Uuid
  fleetId      String   @db.Uuid
  vehicleId    String?  @db.Uuid
  alertType    String   // ex: 'OVERSPEED', 'SOS', '*' = tous
  enabled      Boolean  @default(true)
  channels     Json     @default("[]") // ['WEB_PUSH', 'EMAIL', 'WHATSAPP']
  // Escalade : si l'alerte n'est pas acquittee en `escalateAfterMin` minutes
  // ET sa severity est CRITICAL, on notifie escalateTo (ou User.escalationContactUserId
  // si null).
  escalateAfterMin Int?
  escalateToUserId String? @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([fleetId])
  @@index([vehicleId])
  @@index([alertType])
  @@map("alert_rules")
}

/// V1.5 (Sprint J) — Invitations utilisateur.
/// SUPER_ADMIN ou FLEET_ADMIN cree une invitation pour un email + role + fleet.
/// Tracky envoie un email avec lien `/accept-invite?token=...` (JWT 24h).
/// L'utilisateur clique, set son password, on call Vizyo Auth.register puis
/// on cree le User Tracky local avec authUserId retourne.
model Invitation {
  id          String   @id @default(uuid()) @db.Uuid
  email       String
  role        UserRole
  fleetId     String?  @db.Uuid
  tokenHash   String   @unique
  expiresAt   DateTime
  permissions Json?
  status      String   @default("PENDING") // 'PENDING' | 'ACCEPTED' | 'EXPIRED' | 'REVOKED'
  createdById String   @db.Uuid
  createdBy   User     @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([status])
  // V1.10 (Sprint 2 perf) — list par fleet est la query par defaut de la page
  // /admin/invitations. Sans index dedie, on scanne toutes les invitations.
  @@index([fleetId])
  @@map("invitations")
}

model Vehicle {
  id        String   @id @default(uuid()) @db.Uuid
  fleetId   String   @db.Uuid
  fleet     Fleet    @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  plate     String
  type      VehicleType @default(CAR)
  brand     String?
  model     String?
  year      Int?
  color     String?
  // V1.5 (Sprint L) — Estimation consommation pour les rapports : litres
  // au 100km par defaut selon le type vehicule. Si null, on utilise une valeur
  // par defaut cote service (CAR=7, TRUCK=22, VAN=10, MOTO=4, BUS=28).
  fuelConsumptionL100km Float?
  /// Conducteur "courant" du vehicule. Sert de defaut snappe sur Trip.driverId
  /// au moment de la cloture du trajet (driverSource='AUTO'). Modifiable a
  /// posteriori par les admins/managers.
  currentDriverId String?  @db.Uuid
  currentDriver   Driver?  @relation("VehicleCurrentDriver", fields: [currentDriverId], references: [id], onDelete: SetNull)
  tracker    Tracker?
  schedule   VehicleSchedule?
  trips      Trip[]
  alerts     Alert[]
  groups     VehicleGroupAssignment[]
  userAccess UserVehicleAccess[]
  surveillanceProfile SurveillanceProfile?
  surveillanceEvents  SurveillanceEvent[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fleetId, plate])
  @@index([fleetId])
  @@index([currentDriverId])
  @@map("vehicles")
}

model Tracker {
  id                   String                 @id @default(uuid()) @db.Uuid
  imei                 String                 @unique
  model                String                 @default("COBAN_GPS403D")
  status               TrackerStatus          @default(OFFLINE)
  lastSeenAt           DateTime?
  // V1.4 — etat ignition fiable (remote `2c7e29b`)
  lastKnownIgnition    Boolean?
  lastIgnitionChangeAt DateTime?
  // V1.4 — denormalisation derniere position connue (Sprint A — hydratation au login)
  // Permet l'hydratation immediate de la carte au login sans attendre la prochaine trame.
  lastLat              Float?
  lastLng              Float?
  lastSpeedKmh         Float?
  lastHeading          Float?
  lastIgnition         Boolean?
  lastValid            Boolean?
  lastPositionAt       DateTime?
  // V1.5 (Sprint H1) — etat du sampling adaptatif.
  // lastWriteAt = derniere fois ou une trame a ete reellement persistee dans `positions`
  //              (different de lastPositionAt qui suit `deviceTime` de la trame brute).
  // lastSampledState = derniere classification appliquee (MOVING / IDLE_ENGINE_ON / STOPPED).
  // verboseUntil = override admin temporaire qui force l'INSERT de chaque trame (debugging).
  lastWriteAt          DateTime?
  lastSampledState     String?
  verboseUntil         DateTime?
  // V1.5 (Sprint H3) — pilotage du fix interval boitier (commande Coban `fix...***n`).
  // desired = ce que le serveur veut que le boitier emette ; current = ce qu'on observe
  // reellement. Si desired != current pendant > 6 trames, on incrementre le compteur
  // d'echec et on marque le tracker FAILING.
  desiredFixIntervalS     Int       @default(30)
  currentFixIntervalS     Int?
  lastFixIntervalSyncAt   DateTime?
  // Compteur d'echecs consecutifs (commande envoyee non prise en compte par le boitier).
  fixCommandFailureCount  Int       @default(0)
  fixCommandFailing       Boolean   @default(false)
  // Override admin : si > now, le serveur ne tente pas de nouvelles transitions
  // automatiques (utile pour figer le tracker en mode 30s pour 24h depuis l'admin).
  fixModeOverrideUntil    DateTime?
  // Timestamp deviceTime de la derniere trame valide observee — sert au reconciler
  // pour calculer le delta entre 2 trames et inferer l'intervalle reel.
  lastValidFrameAt        DateTime?
  // V1.5 (Sprint I) — numero E.164 de la SIM data du boitier. Permet le fallback
  // SMS quand la socket TCP est indisponible. Renseigne au moment du provisionnement
  // SMS via /admin/sms/provision.
  simPhoneNumber          String?
  /// V1.7 — Indique si le fil ACC du boitier (jaune) est physiquement connecte
  /// au +12V apres contact. Si false, le serveur infere `ignition` depuis la
  /// vitesse GPS (>3 km/h => ON). Reglable par SUPER_ADMIN uniquement depuis
  /// la fiche vehicule. Default true (cas standard en flotte pro).
  accConnected            Boolean   @default(true)
  vehicleId            String?                @unique @db.Uuid
  vehicle    Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  positions  Position[]
  samplingDecisions PositionSamplingDecision[]
  commands        EngineControlCommand[]
  trackerCommands TrackerCommand[]
  alerts          Alert[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([status])
  @@map("trackers")
}

/// V1.5 (Sprint H1) — audit trail du sampling adaptatif.
/// Chaque trame entrante (valide) genere une ligne ici, qu'elle soit persistee
/// dans `positions` ou skippee. Permet a l'admin d'auditer l'efficacite du
/// sampling et de detecter un boitier qui spam des positions identiques ou
/// un sampling trop agressif.
/// Retention courte : purge auto au-dela de 7 jours (cron quotidien).
model PositionSamplingDecision {
  id          String   @id @default(uuid()) @db.Uuid
  trackerId   String   @db.Uuid
  tracker     Tracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  decision    String   // 'INSERTED' | 'SKIPPED_DUP' | 'SKIPPED_THROTTLE' | 'INSERTED_VERBOSE'
  state       String   // 'MOVING' | 'IDLE_ENGINE_ON' | 'STOPPED'
  reason      String?  // ex: "haversine 3m < 15m radius, throttle 90s active"
  speedKmh    Float?
  ignition    Boolean?
  distanceM   Float?   // distance haversine vs derniere position persistee
  receivedAt  DateTime @default(now())

  @@index([trackerId, receivedAt(sort: Desc)])
  @@index([receivedAt])
  @@map("position_sampling_decisions")
}

/// `location` (geography Point 4326) ajouté manuellement dans la migration.
model Position {
  id         String   @id @default(uuid()) @db.Uuid
  trackerId  String   @db.Uuid
  tracker    Tracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  speedKmh   Float    @default(0)
  heading    Float    @default(0)
  altitude   Float?
  satellites Int?
  valid      Boolean  @default(true)
  ignition   Boolean?
  timestamp  DateTime
  createdAt  DateTime @default(now())

  @@index([trackerId, timestamp(sort: Desc)])
  @@map("positions")
}

model Trip {
  id                 String   @id @default(uuid()) @db.Uuid
  vehicleId          String   @db.Uuid
  vehicle            Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trackerId          String?  @db.Uuid
  fleetId            String?  @db.Uuid
  startedAt          DateTime
  endedAt            DateTime?
  durationSeconds    Int      @default(0)
  startLat           Float    @default(0)
  startLng           Float    @default(0)
  endLat             Float?
  endLng             Float?
  distanceKm         Float    @default(0)
  distanceMeters     Float    @default(0)
  maxSpeed           Float    @default(0)
  avgSpeed           Float    @default(0)
  positionCount      Int      @default(0)
  segmentationSource String   @default("live")
  polyline           String?
  /// Sprint G.3 V1.4 : polyligne snappee aux routes via OSRM /match.
  /// Si null, le frontend affiche `polyline` (raw GPS).
  polylineMatched    String?
  /// Note libre attachee au trajet, max ~500 chars cote app (libre cote DB).
  /// Editable par FLEET_ADMIN, FLEET_MANAGER (avec perm `trips_edit_notes`)
  /// et SUPER_ADMIN. On ne garde pas l'historique : seul le dernier auteur
  /// est trace via `notesUpdatedBy*` pour traçabilite minimale.
  notes              String?  @db.Text
  notesUpdatedAt     DateTime?
  notesUpdatedById   String?  @db.Uuid
  notesUpdatedBy     User?    @relation("TripNotesAuthor", fields: [notesUpdatedById], references: [id], onDelete: SetNull)
  /// Conducteur snape sur ce trajet. Renseigne automatiquement a la cloture
  /// (`driverSource='AUTO'`) depuis Vehicle.currentDriverId si defini.
  /// Editable a posteriori par les admins/managers (`driverSource='MANUAL'`).
  driverId           String?  @db.Uuid
  driver             Driver?  @relation("TripDriver", fields: [driverId], references: [id], onDelete: SetNull)
  /// 'AUTO' = snape depuis Vehicle.currentDriver au finalize.
  /// 'MANUAL' = modifie manuellement par un admin/manager.
  /// null = pas de driver (jamais assigne).
  driverSource       String?
  createdAt          DateTime @default(now())

  @@index([vehicleId, startedAt(sort: Desc)])
  @@index([fleetId, startedAt(sort: Desc)])
  @@index([driverId, startedAt(sort: Desc)])
  @@map("trips")
}

/// Conducteur — variante "hybride" (Phase 2).
///
/// - Le driver est une entite metier de la fleet, pas necessairement une
///   personne ayant un acces a l'app. `userId` est null par defaut : on
///   peut creer un driver "tag" sans login pour juste tracer qui conduisait.
/// - Phase 3 (futur) : on pourra "promouvoir" un driver en lui creant un
///   compte User avec role DRIVER (table User + relation 1:1 ici).
/// - Soft delete via `isActive=false` (idem User). On n'efface pas un driver
///   pour preserver l'historique des Trip.driverId snappes.
/// - Couleur servant de pastille UI pour repere visuel rapide (ex: planning).
model Driver {
  id             String   @id @default(uuid()) @db.Uuid
  fleetId        String   @db.Uuid
  fleet          Fleet    @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  /// E.164 (+33612345678) — utile pour SMS/whatsapp futur, validation cote app.
  phone          String?
  email          String?
  /// Numero de permis (libre, usage interne — pas de validation officielle).
  licenseNumber  String?
  /// Couleur hex de pastille UI (default vert tracky).
  color          String?  @default("#10E0A0")
  /// Note libre sur le conducteur (a propos de lui, distinct de Trip.notes).
  notes          String?  @db.Text
  isActive       Boolean  @default(true)
  /// Phase 3 — Si renseigne, ce driver a un compte User (login) avec role DRIVER.
  /// 1:1 strict (un User = un Driver max).
  userId         String?  @unique @db.Uuid
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Vehicules dont ce driver est le conducteur "courant" (defaut sur les
  /// prochains trajets). Souvent 1, peut etre N si plusieurs vehicules.
  currentVehicles Vehicle[] @relation("VehicleCurrentDriver")
  /// Tous les trajets snappes sur ce driver (historique).
  trips          Trip[]   @relation("TripDriver")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([fleetId])
  @@index([fleetId, isActive])
  @@map("drivers")
}

/// `geometry` (geography 4326) ajouté manuellement dans la migration.
model Geofence {
  id           String       @id @default(uuid()) @db.Uuid
  fleetId      String       @db.Uuid
  fleet        Fleet        @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  name         String
  type         GeofenceType
  rule         GeofenceRule @default(BOTH)
  centerLat    Float        @default(0)
  centerLng    Float        @default(0)
  radiusMeters Int          @default(500)
  /// Pour les geofences POLYGON : liste ordonnee de sommets [{lat, lng}, ...].
  /// Sprint F.2 V1.4. Ignore si type = CIRCLE.
  polygonPoints Json?
  /// V1.5 (Sprint N) — pour les geofences CORRIDOR : polyligne ordonnee
  /// + largeur en metres. Alerte si le vehicule sort du buffer.
  corridorPoints  Json?
  corridorWidthM  Int?         @default(100)
  color        String?      @default("#10e0a0")
  active       Boolean      @default(true)
  vehicleTargets GeofenceVehicle[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([fleetId])
  @@map("geofences")
}

/// V1.5 (Sprint N) — Ciblage explicite d'une geofence sur des vehicules.
/// Si une geofence n'a aucune ligne dans cette table, elle s'applique a tous
/// les vehicules de la fleet (mode global, compat V1). Si elle a au moins une
/// ligne, elle ne s'applique qu'aux vehicules listes ici.
model GeofenceVehicle {
  geofenceId String   @db.Uuid
  vehicleId  String   @db.Uuid
  geofence   Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([geofenceId, vehicleId])
  @@index([vehicleId])
  @@map("geofence_vehicles")
}

model Alert {
  id               String        @id @default(uuid()) @db.Uuid
  fleetId          String        @db.Uuid
  fleet            Fleet         @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  vehicleId        String?       @db.Uuid
  vehicle          Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  trackerId        String?       @db.Uuid
  tracker          Tracker?      @relation(fields: [trackerId], references: [id], onDelete: SetNull)
  type             AlertType
  severity         AlertSeverity @default(WARNING)
  title            String
  message          String?
  payload          Json?
  latitude         Float?
  longitude        Float?
  acknowledgedAt   DateTime?
  acknowledgedBy   String?       @db.Uuid
  acknowledgedUser User?         @relation("AlertAcknowledgedBy", fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  // V1.5 (Sprint M) — escalade automatique si CRITICAL non-ack > N min.
  // Une alerte ne peut etre escaladee qu'une seule fois (escalatedAt non null).
  escalatedAt      DateTime?
  surveillanceEvent SurveillanceEvent?
  createdAt        DateTime      @default(now())

  @@index([fleetId, createdAt(sort: Desc)])
  @@index([fleetId, acknowledgedAt])
  // V1.10 (Sprint 2 perf) — KPI dashboard "alertes critiques recentes" — sans cet
  // index la query alert.count({where:{fleetId, severity, acknowledgedAt:null}})
  // doit full-scan le fleet bucket. A 100 vehicules + 10k alertes/mois c'est 20-50ms
  // a chaque rafraichissement KPI (toutes les 30s par user dashboard).
  @@index([fleetId, severity, createdAt(sort: Desc)])
  @@index([vehicleId])
  @@index([trackerId])
  @@map("alerts")
}

/// V1.6 — Surveillance Max : profil de surveillance renforcee par vehicule.
/// Un seul profil par vehicule. Quand `currentlyArmed = true`, toute trame
/// d'alarme `vibration` / `movement` / `door` recue cree un SurveillanceEvent
/// et eleve la severite de l'alerte associee a CRITICAL.
/// L'armement peut etre manuel (POST /surveillance/.../arm) ou automatique
/// via SurveillanceSchedulerService (cron toutes les minutes) selon les
/// plages horaires definies.
model SurveillanceProfile {
  id           String                  @id @default(uuid()) @db.Uuid
  vehicleId    String                  @unique @db.Uuid
  vehicle      Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fleetId      String                  @db.Uuid
  fleet        Fleet                   @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  mode         SurveillanceMode        @default(OFF)
  sensitivity  SurveillanceSensitivity @default(MEDIUM)
  // Plage horaire (HH:mm, UTC). Si `scheduleStartTime > scheduleEndTime`,
  // la plage passe minuit (ex 20:00 -> 06:00).
  scheduleStartTime String?
  scheduleEndTime   String?
  // Jours actifs : array de strings ["mon","tue","wed","thu","fri","sat","sun"].
  // Null = tous les jours.
  scheduleDays      Json?
  // Triggers actifs lors d'un armement.
  triggerVibration  Boolean @default(true)
  triggerMovement   Boolean @default(true)
  triggerDoor       Boolean @default(false)
  // Destinataires supplementaires (FLEET_MANAGER opt-in). Les FLEET_ADMIN
  // de la fleet sont notifies par defaut via NotificationDispatchService.
  additionalNotifyUserIds String[]
  // Etat courant — maintenu par armNow/disarmNow ou par le scheduler.
  currentlyArmed Boolean   @default(false)
  lastArmedAt    DateTime?
  lastDisarmedAt DateTime?
  // Audit : qui a cree le profil.
  createdBy      String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  events SurveillanceEvent[]

  @@index([fleetId])
  @@index([mode, currentlyArmed])
  @@map("surveillance_profiles")
}

/// V1.6 — Surveillance Max : evenement de declenchement.
/// Cree par AlertsService.createFromCobanFrame() quand un vehicule arme
/// recoit une trame d'alarme correspondant a ses triggers actifs.
/// Lie a l'Alert correspondante (1:1, optionnel — l'Alert peut etre purgee).
model SurveillanceEvent {
  id             String                   @id @default(uuid()) @db.Uuid
  profileId      String                   @db.Uuid
  profile        SurveillanceProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  vehicleId      String                   @db.Uuid
  vehicle        Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fleetId        String                   @db.Uuid
  fleet          Fleet                    @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  alertId        String?                  @unique @db.Uuid
  alert          Alert?                   @relation(fields: [alertId], references: [id], onDelete: SetNull)
  trigger        SurveillanceEventTrigger
  triggeredAt    DateTime                 @default(now())
  latitude       Float?
  longitude      Float?
  speedKmh       Float?
  status         SurveillanceEventStatus  @default(PENDING)
  acknowledgedAt DateTime?
  acknowledgedBy String?                  @db.Uuid
  notes          String?
  createdAt      DateTime                 @default(now())

  @@index([fleetId, triggeredAt(sort: Desc)])
  @@index([vehicleId, triggeredAt(sort: Desc)])
  @@index([status])
  @@map("surveillance_events")
}

model VehicleGroup {
  id        String                   @id @default(uuid()) @db.Uuid
  name      String
  fleetId   String                   @db.Uuid
  fleet     Fleet                    @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  vehicles  VehicleGroupAssignment[]
  users     UserVehicleAccess[]
  createdAt DateTime                 @default(now())

  @@unique([fleetId, name])
  @@index([fleetId])
  @@map("vehicle_groups")
}

model VehicleGroupAssignment {
  vehicleId String       @db.Uuid
  groupId   String       @db.Uuid
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  group     VehicleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([vehicleId, groupId])
  @@map("vehicle_group_assignments")
}

/// V1.11 (Phase 1 refonte permissions) — `permissions` JSONB porte les
/// permissions resolues par scope. Resolution per-vehicle : on trie les lignes
/// qui couvrent ce vehicleId selon VEHICLE > GROUP > ALL et on prend la premiere.
/// Si `permissions` est null, on fallback sur `User.permissions`, puis sur
/// `getDefaultPermissions(role)`. Cf. PermissionsResolverService.
model UserVehicleAccess {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessType  AccessType
  groupId     String?       @db.Uuid
  group       VehicleGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  vehicleId   String?       @db.Uuid
  vehicle     Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  permissions Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([userId, accessType])
  @@map("user_vehicle_access")
}

enum TrackerCommandStatus {
  PENDING
  SCHEDULED
  SENT
  ACKNOWLEDGED
  FAILED
  CANCELLED
}

enum TrackerProvisioningStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum TrackerCommandChannel {
  TCP
  SMS
}

model TrackerCommand {
  id              String                @id @default(uuid()) @db.Uuid
  trackerId       String                @db.Uuid
  tracker         Tracker               @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  templateId      String
  category        String
  params          Json                  @default("{}")
  payload         String
  channel         TrackerCommandChannel @default(TCP)
  status          TrackerCommandStatus  @default(PENDING)
  scheduledAt     DateTime?
  sentAt          DateTime?
  ackedAt         DateTime?
  ackResponse     String?
  lastError       String?
  // V1.5 (Sprint H3) — observabilite admin enrichie. `expectedResult`/`observedResult`
  // sont des descriptions textuelles courtes, `contextSnapshot` est l'instantane JSON
  // capture au moment de l'envoi (etat vehicule, signal, derniere position).
  // `diagnosticHint` est une suggestion textuelle generee par le service quand la
  // commande echoue (ex: "tester reset SMS"). `acknowledgedBy` permet a un admin de
  // marquer une erreur comme traitee depuis le centre d'alertes.
  expectedResult   String?
  observedResult   String?
  contextSnapshot  Json?
  diagnosticHint   String?
  outcomeReason    String?
  acknowledgedBy   String?              @db.Uuid
  acknowledgedAt   DateTime?
  requestedBy     String                @db.Uuid
  requestedByUser User                  @relation(fields: [requestedBy], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([trackerId, createdAt(sort: Desc)])
  @@index([status])
  @@index([scheduledAt])
  @@index([category, status])
  @@map("tracker_commands")
}

model WireLog {
  id        String   @id @default(uuid()) @db.Uuid
  imei      String
  direction String   // 'IN' | 'OUT'
  raw       String   @db.Text
  frameType String?  // 'login' | 'heartbeat' | 'position' | 'unknown' | 'command' | 'ack'
  commandId String?  @db.Uuid
  context   Json?
  createdAt DateTime @default(now())

  @@index([imei, createdAt(sort: Desc)])
  @@index([commandId])
  @@index([createdAt])
  @@map("wire_logs")
}

model ErrorLog {
  id        String   @id @default(uuid()) @db.Uuid
  level     String   // 'ERROR' | 'CRITICAL'
  source    String   // 'tcp-server' | 'engine-control' | 'tracker-commands' | 'http' | ...
  message   String
  stack     String?  @db.Text
  imei      String?
  commandId String?  @db.Uuid
  userId    String?  @db.Uuid
  context   Json?
  createdAt DateTime @default(now())

  @@index([source, createdAt(sort: Desc)])
  @@index([imei])
  @@index([commandId])
  @@index([createdAt])
  @@map("error_logs")
}

/// V1.5 (Sprint I) — Etat de la sequence d'init SMS d'un tracker neuf.
/// Le SUPER_ADMIN lance le workflow depuis /admin/sms/provision/:imei,
/// le service envoie 9 SMS sequentiels avec ACK entre chaque etape.
model TrackerProvisioning {
  id              String                    @id @default(uuid()) @db.Uuid
  imei            String
  phoneNumber     String
  status          TrackerProvisioningStatus @default(PENDING)
  currentStep     Int                       @default(0)
  apn             String?
  apnUser         String?
  apnPasswd       String?
  serverIp        String?
  serverPort      Int?
  lowBatteryPhone String?
  steps           Json                      @default("[]")
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  startedBy       String                    @db.Uuid
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([imei])
  @@index([status])
  @@map("tracker_provisionings")
}

/// V1.5 (Sprint I) — Trace complete des SMS sortants/entrants pour audit.
/// Reuse du wire_logs n'est pas adapte (different vocabulaire). Retention 90j.
/// V1.5 (Sprint I) — Trace de chaque backup Postgres pour monitoring.
/// Le script `deploy/vps/backup-db.sh` ping l'endpoint /internal/backup-health
/// apres chaque execution. Si le dernier ping est > 30h, l'admin voit une
/// alerte rouge dans /admin/alerts.
model BackupRun {
  id           String   @id @default(uuid()) @db.Uuid
  status       String   // 'OK' | 'FAILED'
  sizeBytes    BigInt?
  durationMs   Int?
  destination  String?  // 'local' | 's3' | 'backblaze' | 'rclone:remote_name'
  filename     String?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("backup_runs")
}

model SmsLog {
  id          String   @id @default(uuid()) @db.Uuid
  direction   String   // 'OUT' | 'IN'
  fromNumber  String?
  toNumber    String?
  body        String   @db.Text
  twilioSid   String?
  status      String?  // queued / sent / delivered / failed / received / undelivered
  errorCode   String?
  errorMessage String?
  imei        String?
  provisioningId String?  @db.Uuid
  context     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([imei])
  @@index([provisioningId])
  @@map("sms_logs")
}

model EngineControlCommand {
  id          String        @id @default(uuid()) @db.Uuid
  trackerId   String        @db.Uuid
  tracker     Tracker       @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  action      EngineAction
  scheduledAt DateTime?
  status      CommandStatus @default(PENDING)
  reason      String?
  requestedBy String        @db.Uuid
  source      String        @default("MANUAL") // "MANUAL" | "SCHEDULER"
  lastError   String?
  sentAt      DateTime?
  ackedAt     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([trackerId, status])
  // V1.10 (Sprint 2 perf) — vehicles.snapshot et positions.service appellent
  // findFirst({trackerId, ...}, orderBy:{createdAt:'desc'}) tres souvent pour
  // verifier le dernier CUT/RESTORE. L'index [trackerId, status] ne couvre pas
  // l'orderBy createdAt → table sort. Cet index couvre directement.
  @@index([trackerId, createdAt(sort: Desc)])
  @@map("engine_control_commands")
}

model VehicleSchedule {
  id        String @id @default(uuid()) @db.Uuid
  vehicleId String @unique @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  enabled   Boolean @default(false)
  timezone  String  @default("Europe/Paris")

  mondayEnabled    Boolean @default(true)
  mondayStart      String? // "08:00"
  mondayEnd        String? // "20:00"
  tuesdayEnabled   Boolean @default(true)
  tuesdayStart     String?
  tuesdayEnd       String?
  wednesdayEnabled Boolean @default(true)
  wednesdayStart   String?
  wednesdayEnd     String?
  thursdayEnabled  Boolean @default(true)
  thursdayStart    String?
  thursdayEnd      String?
  fridayEnabled    Boolean @default(true)
  fridayStart      String?
  fridayEnd        String?
  saturdayEnabled  Boolean @default(false)
  saturdayStart    String?
  saturdayEnd      String?
  sundayEnabled    Boolean @default(false)
  sundayStart      String?
  sundayEnd        String?

  // V1.5 (Sprint K) — Multi-plages par jour. Si non null, override les paires
  // start/end legacy ci-dessus. Format : [{ start: "08:00", end: "12:00" },
  // { start: "14:00", end: "18:00" }]. Max 3 plages par jour cote app (validation).
  mondaySlots    Json?
  tuesdaySlots   Json?
  wednesdaySlots Json?
  thursdaySlots  Json?
  fridaySlots    Json?
  saturdaySlots  Json?
  sundaySlots    Json?

  // V1.5 (Sprint K) — Calendrier jours feries (lib `date-holidays`).
  // 'FR' = France metropolitaine. Liste : FR / MA / BE / LU / CH (config UI).
  countryCode    String @default("FR")

  // V1.5 (Sprint K) — Override ponctuel pour une date specifique :
  // [{ date: "2026-12-24", slots: [{ start: "08:00", end: "16:00" }] },
  //  { date: "2026-12-25", closed: true }]
  customDates    Json?

  lastEvaluatedAt    DateTime?
  lastEvaluatedState String?   // "IN_WINDOW" | "OUT_OF_WINDOW"
  overrideUntil      DateTime? // scheduler ignores until this time after manual action

  history ScheduleHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_schedules")
}

/// V1.5 (Sprint K) — Trace des transitions automatiques du scheduler.
/// Une ligne par CUT/RESTORE auto, avec la raison detaillee. Sert pour la
/// timeline UI de la fiche vehicule + l'audit operateur.
model ScheduleHistory {
  id          String   @id @default(uuid()) @db.Uuid
  scheduleId  String   @db.Uuid
  schedule    VehicleSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  vehicleId   String   @db.Uuid
  occurredAt  DateTime @default(now())
  action      String   // 'CUT' | 'RESTORE'
  reason      String   // 'OUT_OF_WINDOW' | 'IN_WINDOW_RESUME' | 'HOLIDAY' | 'CUSTOM_DATE_CLOSED' | 'CUSTOM_DATE_RANGE'
  windowDesc  String?  // ex: "08:00-12:00 + 14:00-18:00" ou "Ferie : 1er mai"

  @@index([scheduleId, occurredAt(sort: Desc)])
  @@index([vehicleId, occurredAt(sort: Desc)])
  @@map("schedule_history")
}
