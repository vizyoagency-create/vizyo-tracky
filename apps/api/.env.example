# Variables environment pour @vizyo/tracky-api.
# Si ce fichier n'existe pas localement, NestJS lit `../../.env` (racine du monorepo).
# Le fichier racine reste la source de verite — celui-ci sert seulement quand l'API
# est lancee de maniere isolee (CI, Docker build, debug standalone).

# ========== Postgres ==========
POSTGRES_USER=vizyo
POSTGRES_PASSWORD=vizyo_dev_pwd
POSTGRES_DB=vizyo_tracky
POSTGRES_PORT=5432

# ========== Redis ==========
REDIS_PORT=6379

# ========== API ==========
NODE_ENV=development
API_PORT=3000
TRACKER_TCP_PORT=5023
DATABASE_URL=postgresql://vizyo:vizyo_dev_pwd@localhost:5432/vizyo_tracky?schema=public
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:4200
MOCK_POSITIONS=false

# ========== Vizyo Auth ==========
VIZYO_AUTH_API_URL=https://api.auth.vizyoagency.com
VIZYO_AUTH_APP_ID=app_xxxxxxxxxxxx
VIZYO_AUTH_APP_SECRET=sk_xxxxxxxxxxxx
VIZYO_AUTH_JWT_ACCESS_SECRET=your-jwt-access-secret
VIZYO_AUTH_JWT_ISSUER=https://api.auth.vizyoagency.com
VIZYO_AUTH_APP_INTERNAL_ID=cxxxxxxxxxxxxxxxx

# ========== Sonde active des dependances ==========
# URL PUBLIQUES sondees toutes les 5 min par DependencyHeartbeatService : elles
# doivent traverser Traefik/TLS, sinon une panne de ROUTAGE reste invisible
# (cf. coupure Vizyo Auth du 18-21/07/2026 — conteneur sain, route perdue).
# Vide => repli sur VIZYO_AUTH_API_URL / VIZYO_TEXTO_URL + avertissement au boot.
DEPENDENCY_PROBE_AUTH_URL=https://api.auth.vizyoagency.com
DEPENDENCY_PROBE_TEXTO_URL=https://texto.vizyoagency.com

# ========== Internal API ==========
INTERNAL_API_SECRET=change-me-minimum-32-chars

# ========== Seed ==========
SEED_ADMIN_AUTH_USER_ID=cxxxxxxxxxxxxxxxx

# ========== Web ==========
WEB_PORT=4200
API_BASE_URL=http://localhost:3000
WS_BASE_URL=ws://localhost:3000

# ========== Web Push (VAPID) ==========
# Generer une seule fois (regenerer invalide tous les devices abonnes) :
#   npx web-push generate-vapid-keys
# Si VAPID_PUBLIC_KEY est vide, le push est en mode no-op (pas d'envoi).
# VAPID_SUBJECT doit etre un mailto: ou https:// (RFC 8292).
# Cf. docs/18-web-push-deployment.md pour la procedure prod.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@vizyoagency.com

# ========== SMS heartbeat (preuve de vie) ==========
# CSV de numeros E.164 recevant chaque lundi 09h00 (Europe/Paris) un SMS de test.
# Vide => cron skip (no-op safe). Cf. SmsHeartbeatService + docs racine .env.example.
SMS_HEARTBEAT_RECIPIENTS=

# ========== Retention donnees (purge auto 3h30) ==========
# Cf. DataRetentionService. Purge nocturne par lots des tables volumineuses.
# Audit-trail du sampling : retention courte (defaut 7j). 0 => desactive.
SAMPLING_DECISIONS_RETENTION_DAYS=7
# Positions GPS : 0 => retention INFINIE (defaut, comportement historique).
# Mettre un nombre de jours (ex: 365) ACTIVE la purge des positions au-dela de
# cette fenetre => supprime le replay des trajets plus anciens. Decision
# metier/legale : a tester sur l'env cible avant activation en prod.
POSITIONS_RETENTION_DAYS=0

# ─── Integration partenaire (Tracky x Maestroo) — lot 0 ──────────────────────
# KILL-SWITCH de deploiement : false = module inerte (routes -> 404).
PARTNER_MAESTROO_ENABLED=false
PARTNER_MAESTROO_API_URL=
# Secret d'amorcage partage entre les deux DEPLOIEMENTS (pas par client).
# Doit etre IDENTIQUE a TRACKY_PARTNER_PLATFORM_SECRET cote Maestroo.
# Generer : node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
PARTNER_PLATFORM_SECRET=
PARTNER_TOKEN_TTL_SECONDS=600

# ── Prise de rendez-vous en ligne (page PUBLIQUE /book/:token) ───────────────
# Telephone affiche au client qui ne trouve pas de creneau qui lui convient.
#
# ⚠️ NUMERO DE L'ATELIER, JAMAIS CELUI D'UNE PERSONNE (decision client du
# 2026-08-16). Cette page est publique et son URL circule par e-mail et par SMS :
# un numero personnel expose la ne se reprend plus.
#
# Laisse vide, le bouton « Appeler » n'apparait pas du tout — mieux vaut deux
# sorties que trois dont une qui ne sonne nulle part.
INSTALLATION_PUBLIC_PHONE=
