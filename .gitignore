# deps
node_modules
.pnpm-store

# Fichiers scratch de démo/test local (seed CDEF31, mint JWT, census) — jamais versionnés.
_scratch-*
**/_scratch-*

# build
dist
.turbo
.angular
coverage

# env — MOTIF, jamais une liste de noms exacts.
#
# `.env.local`, `.env.production`… n'attrapent QUE ces noms-là. Une sauvegarde s'appelle
# `.env.prod.bak-20260907-060023` : elle passait au travers et restait visible de git, secrets
# en clair compris. Tout suffixe est donc couvert, et seuls les gabarits sont réintégrés.
.env
.env.*
!.env*.example

# Sauvegardes prises à la main (exports CSV, dumps) : jamais dans le dépôt.
backups/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# IDE
.vscode/*
!.vscode/extensions.json
.idea
.zed/
.DS_Store

# Claude Code
.claude/

# npm lockfile (project uses pnpm)
package-lock.json

# prisma generated
apps/api/prisma/generated

# Audit sécurité : carte des failles NON corrigées — ne JAMAIS versionner
# (reconstructible depuis la session d'audit ; backup hors repo).
docs/review_loop/

# Sorties de la recette Playwright. Le SCÉNARIO est versionné, ses artefacts non :
# ce sont des captures d'un état de base local, qui changent à chaque exécution et
# qu'aucune relecture de diff ne peut juger.
apps/web/e2e-captures/
apps/web/test-results/
apps/web/playwright-report/
outils/*.log
outils/.osm/
outils/node_modules/
