# ========== Postgres ==========
POSTGRES_USER=vizyo
POSTGRES_PASSWORD=vizyo_dev_pwd
POSTGRES_DB=vizyo_tracky
POSTGRES_PORT=5432

# ========== Redis ==========
REDIS_PORT=6379

# ========== API ==========
NODE_ENV=development
API_PORT=3000
TRACKER_TCP_PORT=5023
# V1.10 (Sprint 2 perf) — connection_limit doit etre dimensionne pour absorber
# les WebSocket persistantes (1 connexion par client connecte) + HTTP concurrent
# + jobs background (cron, ingestion TCP). Defaut Prisma = num_cpus*2+1 (~17 pour
# 8 cores) = pool overflow des 10-15 users connectes simultanement a 100 vehicules.
# 40 = marge confortable pour 50 users + 50 trackers connectes en TCP.
# Ajuster en prod selon `pg_stat_activity` (`SELECT count(*) FROM pg_stat_activity`).
DATABASE_URL=postgresql://vizyo:vizyo_dev_pwd@localhost:5432/vizyo_tracky?schema=public&connection_limit=40
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:4200

# ========== Vizyo Auth ==========
VIZYO_AUTH_API_URL=https://api.auth.vizyoagency.com
VIZYO_AUTH_APP_ID=app_xxxxxxxxxxxx
VIZYO_AUTH_APP_SECRET=sk_xxxxxxxxxxxx
VIZYO_AUTH_JWT_ACCESS_SECRET=your-jwt-access-secret
VIZYO_AUTH_JWT_ISSUER=https://api.auth.vizyoagency.com
VIZYO_AUTH_APP_INTERNAL_ID=cxxxxxxxxxxxxxxxx

# ========== Sonde active des dependances ==========
# URL PUBLIQUES sondees toutes les 5 min par DependencyHeartbeatService.
# Elles DOIVENT traverser Traefik/TLS : c'est la couche qui avait lache lors de
# la coupure Vizyo Auth du 18-21/07/2026 (conteneur sain, route perdue). Sonder
# l'adresse interne du conteneur aurait affiche VERT pendant les 3 jours.
# ⚠️ En prod VIZYO_AUTH_API_URL vaut http://vizyo-auth-api:3200 (interne) :
# sans la variable ci-dessous, la sonde ne verrait PAS une panne de routage.
# Vide => repli sur VIZYO_AUTH_API_URL / VIZYO_TEXTO_URL + avertissement au boot.
DEPENDENCY_PROBE_AUTH_URL=https://api.auth.vizyoagency.com
DEPENDENCY_PROBE_TEXTO_URL=https://texto.vizyoagency.com

# ========== Internal API ==========
INTERNAL_API_SECRET=change-me-minimum-32-chars

# ========== Observability ==========
WIRE_LOG_ENABLED=true
MOCK_POSITIONS=false

# ========== Seed ==========
# Get from Auth DB: SELECT id FROM "User" WHERE email = 'admin@vizyoagency.com'
SEED_ADMIN_AUTH_USER_ID=cxxxxxxxxxxxxxxxx

# ========== Web ==========
WEB_PORT=4200
API_BASE_URL=http://localhost:3000
WS_BASE_URL=ws://localhost:3000

# ========== Web Push (VAPID) ==========
# Generer une seule fois (regenerer invalide tous les devices abonnes) :
#   npx web-push generate-vapid-keys
# Si VAPID_PUBLIC_KEY est vide, le push est en mode no-op (pas d'envoi).
# VAPID_SUBJECT doit etre un mailto: ou https:// (RFC 8292).
# Cf. docs/18-web-push-deployment.md pour la procedure prod.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@vizyoagency.com

# ========== WhereverSIM (parc SIM M2M) ==========
# API GraphQL de gestion des cartes SIM. Le token se passe BRUT dans le header
# Authorization (pas de prefixe Bearer). Si WHEREVER_SIM_TOKEN est vide, le
# module SIM tourne sur le cache local sans appeler le fournisseur (no-op).
WHEREVER_SIM_API_URL=https://graphql.api.whereversim.com/graphql
WHEREVER_SIM_TOKEN=

# ========== IA (Anthropic / OpenAI) — A PLACER DANS apps/api/.env ==========
# ⚠️ Les cles IA ne vont PAS dans le .env racine (design/C3-CHANTIER-IA-2026-09-05.md,
# point 3). La racine est le repertoire de travail des agents du poste (outils/*.cmd),
# et une ANTHROPIC_API_KEY visible par la CLI Claude Code la ferait basculer de
# l'abonnement vers l'API facturee sans aucun signal — les agents REFUSENT d'ailleurs
# de tourner si elle est presente. L'API charge aussi apps/api/.env (app.module.ts :
# envFilePath ['../../.env', '.env']) : c'est la que ce bloc doit vivre.
# Vide = fonction IA indisponible (les endpoints /ai/* repondent 503, le reste tourne).
ANTHROPIC_API_KEY=
# Modele Anthropic impose au client (vide = defaut du client, cf. anthropic.client.ts).
ANTHROPIC_MODEL=
# Moteur GPT (OpenAI Responses API). Vide = fournisseur 'gpt' indisponible.
OPENAI_API_KEY=
# Modele OpenAI (vide = defaut du client, ex. gpt-4.1 / gpt-4.1-mini / gpt-4o).
OPENAI_MODEL=
# Taux USD→EUR de la page « Couts IA » (vide = 0,92 en dur ; marche ≈ 0,86 le 05/09/2026).
AI_USD_TO_EUR=

# ========== SMS heartbeat (preuve de vie) ==========
# CSV de numeros E.164 qui recoivent chaque lundi 09h00 (Europe/Paris) un SMS de
# test via la gateway SMS active (vizyo-texto / Twilio). Sert a detecter une SIM
# Android down avant qu'un SMS CRITICAL ne parte dans le vide : si la chaine
# casse, un ErrorLog CRITICAL `source=sms-heartbeat` est cree. Vide => le cron
# skip (no-op safe en dev). Declenchable a la demande via l'admin SMS > Statut.
SMS_HEARTBEAT_RECIPIENTS=
