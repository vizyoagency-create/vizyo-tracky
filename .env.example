# ========== Postgres ==========
POSTGRES_USER=vizyo
POSTGRES_PASSWORD=vizyo_dev_pwd
POSTGRES_DB=vizyo_tracky
POSTGRES_PORT=5432

# ========== Redis ==========
REDIS_PORT=6379

# ========== API ==========
NODE_ENV=development
API_PORT=3000
TRACKER_TCP_PORT=5023
# V1.10 (Sprint 2 perf) — connection_limit doit etre dimensionne pour absorber
# les WebSocket persistantes (1 connexion par client connecte) + HTTP concurrent
# + jobs background (cron, ingestion TCP). Defaut Prisma = num_cpus*2+1 (~17 pour
# 8 cores) = pool overflow des 10-15 users connectes simultanement a 100 vehicules.
# 40 = marge confortable pour 50 users + 50 trackers connectes en TCP.
# Ajuster en prod selon `pg_stat_activity` (`SELECT count(*) FROM pg_stat_activity`).
DATABASE_URL=postgresql://vizyo:vizyo_dev_pwd@localhost:5432/vizyo_tracky?schema=public&connection_limit=40
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:4200

# ========== Vizyo Auth ==========
VIZYO_AUTH_API_URL=https://api.auth.vizyoagency.com
VIZYO_AUTH_APP_ID=app_xxxxxxxxxxxx
VIZYO_AUTH_APP_SECRET=sk_xxxxxxxxxxxx
VIZYO_AUTH_JWT_ACCESS_SECRET=your-jwt-access-secret
VIZYO_AUTH_JWT_ISSUER=https://api.auth.vizyoagency.com
VIZYO_AUTH_APP_INTERNAL_ID=cxxxxxxxxxxxxxxxx

# ========== Internal API ==========
INTERNAL_API_SECRET=change-me-minimum-32-chars

# ========== Observability ==========
WIRE_LOG_ENABLED=true
MOCK_POSITIONS=false

# ========== Seed ==========
# Get from Auth DB: SELECT id FROM "User" WHERE email = 'admin@vizyoagency.com'
SEED_ADMIN_AUTH_USER_ID=cxxxxxxxxxxxxxxxx

# ========== Web ==========
WEB_PORT=4200
API_BASE_URL=http://localhost:3000
WS_BASE_URL=ws://localhost:3000

# ========== Web Push (VAPID) ==========
# Generer une seule fois (regenerer invalide tous les devices abonnes) :
#   npx web-push generate-vapid-keys
# Si VAPID_PUBLIC_KEY est vide, le push est en mode no-op (pas d'envoi).
# VAPID_SUBJECT doit etre un mailto: ou https:// (RFC 8292).
# Cf. docs/18-web-push-deployment.md pour la procedure prod.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@vizyoagency.com

# ========== SMS heartbeat (preuve de vie) ==========
# CSV de numeros E.164 qui recoivent chaque lundi 09h00 (Europe/Paris) un SMS de
# test via la gateway SMS active (vizyo-texto / Twilio). Sert a detecter une SIM
# Android down avant qu'un SMS CRITICAL ne parte dans le vide : si la chaine
# casse, un ErrorLog CRITICAL `source=sms-heartbeat` est cree. Vide => le cron
# skip (no-op safe en dev). Declenchable a la demande via l'admin SMS > Statut.
SMS_HEARTBEAT_RECIPIENTS=
