[Unit]
Description=Vizyo Tracky — Trigger quotidien du backup PostgreSQL

[Timer]
# Tous les jours a 03:00 UTC. RandomizedDelaySec evite les pics si plusieurs services
# de backup sont configures sur le meme VPS.
OnCalendar=*-*-* 03:00:00 UTC
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
