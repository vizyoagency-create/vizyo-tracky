# ═══ .env.demo — configuration de l'ENVIRONNEMENT DE DÉMONSTRATION ═════════════════════════
#
# Copier en `.env.demo` (ignoré par git) à côté de docker-compose.demo.yml, puis :
#   docker compose --env-file .env.demo -f docker-compose.demo.yml up -d
#
# Procédure complète : docs/environnement-demo/EXPLOITATION.md.
#
# ⚠️ CE QUI EST VIDE ICI EST VIDE EXPRÈS. Sans clé SMS, push, Stripe, SIM, partenaire ni IA,
# les modules correspondants sont INERTES (apps/api/src/config/env.validation.ts). C'est, avec
# l'absence de port boîtiers, ce qui rend la démo incapable d'atteindre un véhicule ou d'envoyer
# quoi que ce soit à un vrai client. Ne rien « compléter » ici sans relire le plan (§ 2.1).

# === Traefik (infra existante — mêmes valeurs que .env.prod) ===
TRAEFIK_NETWORK=foodsqan-public
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT=websecure

# === Domaine de la démo (enregistrement DNS à créer ; certificat automatique par Traefik) ===
DEMO_DOMAIN=demo-tracky.vizyoagency.com
APP_BASE_URL=https://demo-tracky.vizyoagency.com
CORS_ORIGIN=https://demo-tracky.vizyoagency.com

# === Postgres de la démo (conteneur tracky-demo-postgres — RIEN à voir avec tracky-postgres) ===
POSTGRES_DB=tracky_demo
POSTGRES_USER=tracky_demo
POSTGRES_PASSWORD=__GENERATE_WITH_openssl_rand_-base64_32__

# === Vizyo Auth — application « Tracky Démo », DISTINCTE de celle de la production ===
# Un jeton de la démo est refusé par la prod (appId différent) et réciproquement ; les prospects
# n'apparaissent pas dans la liste des utilisateurs de l'application de production.
VIZYO_AUTH_API_URL=https://api.auth.vizyoagency.com
VIZYO_AUTH_APP_ID=app_xxxxxxxxxxxx
VIZYO_AUTH_APP_SECRET=sk_xxxxxxxxxxxx
VIZYO_AUTH_JWT_ACCESS_SECRET=__SAME_AS_VIZYO_AUTH_SERVICE__
VIZYO_AUTH_JWT_ISSUER=https://api.auth.vizyoagency.com
VIZYO_AUTH_APP_INTERNAL_ID=cxxxxxxxxxxxxxxxx
VIZYO_AUTH_WEB_URL=https://auth.vizyoagency.com
DEPENDENCY_PROBE_AUTH_URL=https://api.auth.vizyoagency.com

# === Secret interne — un secret PROPRE, jamais celui de la production ===
INTERNAL_API_SECRET=__GENERATE_WITH_openssl_rand_-base64_32__

# === E-mail (décision du 2026-09-07, § 9 point 5 : OUI, expéditeur dédié) ===
# Nécessaire aux invitations (« un prospect = une invitation ») et au mot de passe oublié. La
# base de démo ne contient AUCUNE adresse réelle hormis celles des prospects et la vôtre : un
# courrier parti de la démo ne peut atteindre personne d'autre. Vide = pas d'e-mail (les
# invitations sont créées mais rien n'est envoyé).
RESEND_API_KEY=
RESEND_FROM=Tracky Démo <demo@vizyoagency.com>
EMAIL_REPLY_TO=contact@vizyoagency.com
RESEND_WEBHOOK_SECRET=

# === Tout ce qui suit reste VIDE (voir l'avertissement en tête) ===
VIZYO_TEXTO_URL=
VIZYO_TEXTO_API_KEY=
VIZYO_TEXTO_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_HEARTBEAT_RECIPIENTS=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
WHEREVER_SIM_TOKEN=
PARTNER_MAESTROO_ENABLED=false
PARTNER_PLATFORM_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOCK_POSITIONS=false
WIRE_LOG_ENABLED=false
LOG_LEVEL=info

# === Import depuis la production (importeur éphémère, cf. docker-compose.demo.yml) ===
# Le rôle `tracky_ro` est SELECT SEULEMENT — créé sur la prod par la procédure d'exploitation.
# L'importeur le VÉRIFIE (has_table_privilege) et refuse tout rôle capable d'écrire, superutilisateur compris.
# `application_name` : pour que le journal de connexions de la prod nomme l'appelant (leçon TRK-035).
DEMO_SOURCE_DATABASE_URL=postgresql://tracky_ro:__MOT_DE_PASSE_TRACKY_RO__@tracky-postgres:5432/tracky_prod?schema=public&application_name=tracky-demo-import
# CSV des sociétés source (UUID de `fleets.id` en prod). Plusieurs = fusionnées en une seule
# société de démo.
# ⚠️ L'ORDRE COMPTE : la PREMIÈRE de la liste donne l'identité de la société de démo (son
# identifiant en est dérivé, et le seed fait le même calcul) ainsi que ses réglages — métier,
# prix du carburant, seuils d'alerte de vitesse. Mettre en tête celle dont le métier ne dit
# rien du client : un métier « transport d'enfants » désigne un établissement.
DEMO_SOURCE_FLEET_IDS=
DEMO_FLEET_NAME=Transports Démo
# Sel des pseudonymes et des identifiants. ≥ 16 caractères. LE CHANGER CHANGE TOUTES LES
# IDENTITÉS (plaques, IMEI, noms) et orpheline les droits posés sur les véhicules : ne le faire
# qu'avec une remise à zéro complète de la démo.
DEMO_SALT=__GENERATE_WITH_openssl_rand_-hex_24__
DEMO_POSITIONS_DAYS=30
DEMO_TRIPS_MONTHS=12

# === Comptes de démonstration (apps/api/prisma/seed-demo.ts) ===
# Votre compte Vizyo Auth, lié à l'application « Tracky Démo » : il devient SUPER_ADMIN de la démo.
SEED_ADMIN_AUTH_USER_ID=
SEED_ADMIN_EMAIL=admin@vizyoagency.com
# Les comptes de rôle (demo-admin@…, demo-gestionnaire@…, demo-lecteur@…, demo-veilleur@…,
# demo-conducteur@…) : un domaine, UN mot de passe. Vide = pas de comptes de rôle.
# ⚠️ Le mot de passe doit satisfaire la politique de VIZYO AUTH, pas seulement une longueur :
# au moins 12 caractères, une MAJUSCULE, une minuscule et un chiffre. Le seed le vérifie avant
# d'appeler Vizyo Auth — sinon le refus arrive au milieu de la séquence, sans nommer la variable.
DEMO_ACCOUNTS_DOMAIN=demo.vizyoagency.com
DEMO_ACCOUNTS_PASSWORD=

# ── Purge des comptes de démonstration dormants ─────────────────────────────────────────
# Un compte sans connexion depuis ce nombre de jours est purgé chaque nuit à 05:35 :
# suspendu dans Vizyo Auth, puis ses données personnelles et ses invitations sont effacées.
# Son activité survit, anonyme. Vide = 30 jours.
DEMO_PURGE_JOURS=30
# ⚠️ LES COMMERCIAUX VONT ICI. Rien ne les distingue structurellement d'un prospect : sans
# cette liste, la purge effacerait le compte de la personne qui fait visiter la démonstration.
# Adresses séparées par des virgules ; casse et espaces ignorés.
DEMO_COMPTES_PERMANENTS=
