# === Traefik (infra existante foodsqan) ===
TRAEFIK_NETWORK=foodsqan-public
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT=websecure

# === Domaines ===
APP_DOMAIN=app-tracky.vizyoagency.com
LP_DOMAIN=tracky.vizyoagency.com
APP_BASE_URL=https://app-tracky.vizyoagency.com

# === Postgres ===
POSTGRES_DB=tracky_prod
POSTGRES_USER=tracky
POSTGRES_PASSWORD=__GENERATE_WITH_openssl_rand_-base64_32__

# === Vizyo Auth (service partagé) ===
VIZYO_AUTH_API_URL=https://api.auth.vizyoagency.com
VIZYO_AUTH_APP_ID=app_xxxxxxxxxxxx
VIZYO_AUTH_APP_SECRET=sk_xxxxxxxxxxxx
VIZYO_AUTH_JWT_ACCESS_SECRET=__SAME_AS_VIZYO_AUTH_SERVICE__
VIZYO_AUTH_JWT_ISSUER=https://api.auth.vizyoagency.com
VIZYO_AUTH_APP_INTERNAL_ID=cxxxxxxxxxxxxxxxx
VIZYO_AUTH_WEB_URL=https://auth.vizyoagency.com
DEPENDENCY_PROBE_AUTH_URL=https://api.auth.vizyoagency.com

# === Secret API interne ===
INTERNAL_API_SECRET=__GENERATE_WITH_openssl_rand_-base64_32__

# === Observability ===
WIRE_LOG_ENABLED=true
LOG_LEVEL=info

# === SMS et fiabilité coupe-circuit ===
VIZYO_TEXTO_URL=
VIZYO_TEXTO_API_KEY=
VIZYO_TEXTO_WEBHOOK_SECRET=
DEPENDENCY_PROBE_TEXTO_URL=
SMS_HEARTBEAT_RECIPIENTS=
# T45 — preuve SMS quotidienne (04:30 et 06:30 Europe/Paris) vers UN numero neutre, recommande : la SIM
# du telephone passerelle (echo entrant = emission + reception + webhook). Vide => l'interlock des coupes
# automatiques n'a que la preuve du lundi. A ajouter a l'allowlist du tenant Tracky cote relais.
SMS_DAILY_PROOF_RECIPIENT=
# Garde-fou : laisser false pendant le déploiement et jusqu'au Go terrain explicite.
ENGINE_AUTOMATIC_CUT_ENABLED=false
SMS_MIN_INTERVAL_MS=15000
SCHEDULE_CUT_QUEUE_INTERVAL_MS=10000
ENGINE_RESTORE_ACK_TIMEOUT_MS=15000
ENGINE_RESTORE_ALERT_AFTER_MS=60000
ENGINE_RESTORE_MAX_SMS_ATTEMPTS=3
ENGINE_RESTORE_TCP_RETRY_MIN=30
ENGINE_MANUAL_RESPONSE_BUDGET_MS=20000
ENGINE_RESTORE_EXPIRY_MIN=240
ENGINE_CUT_SMS_TTL_S=900

# === Sécurité ===
MOCK_POSITIONS=false
CORS_ORIGIN=https://app-tracky.vizyoagency.com

# === Web Push (VAPID) ===
# Generer UNE SEULE FOIS sur le VPS (les regenerer invalide tous les devices abonnes) :
#   docker run --rm node:22-alpine npx web-push generate-vapid-keys
# Stocker les valeurs dans le secret manager du VPS, JAMAIS dans le repo.
# VAPID_SUBJECT doit etre un mailto: ou https:// (RFC 8292 — le push provider
# l'utilise pour vous contacter en cas d'abus).
# Si VAPID_PUBLIC_KEY est vide, le push reste en mode no-op (logs : "Web Push disabled").
# Procedure complete : cf. docs/18-web-push-deployment.md
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@vizyoagency.com

# === Facturation (Stripe) ===
# Option IA payante. Si STRIPE_SECRET_KEY est vide, le module billing est DESACTIVE (no-op) :
# l'app tourne sans facturation, l'IA reste pilotee par le toggle super-admin (offert / COMP).
# Commencer en MODE TEST (sk_test_… / pk_test_…), basculer en live plus tard.
# Le PRIX de l'option IA est configurable dans l'espace admin (page Couts IA) — PAS ici.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secret de signature du webhook (whsec_…), obtenu en creant l'endpoint webhook Stripe
# pointant sur https://app-tracky.vizyoagency.com/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
